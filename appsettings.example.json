{
  "GeminiSettings": {
    "Model": "gemini-3.5-flash-lite",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/models",
    "ApiKey": "YOUR_GEMINI_API_KEY"
  },
  "Shopping": {
    "DefaultCustomerBalance": 100000
  },
  "ConnectionStrings": {
    "dbcs": "Server=localhost;Database=ShopAI;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Email": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "YOUR_EMAIL@gmail.com",
    "Password": "YOUR_APP_PASSWORD",
    "FromEmail": "YOUR_EMAIL@gmail.com",
    "FromName": "ShopAI"
  },
  "AllowedHosts": "*"
}
