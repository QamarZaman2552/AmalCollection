@{
    ViewData["Title"] = "About Us";
}

<!-- ═══ About Hero ═══ -->
<section class="about-hero py-5">
    <div class="container text-center">
        <div class="section-kicker">About Us</div>
        <h1 class="about-title">Ladies Suits,<br />Crafted with Care</h1>
        <p class="about-lead mx-auto">
            Amal Collection is a boutique clothing house dedicated exclusively to premium ladies suits for summer and winter.
            We blend exquisite fabrics, honest pricing, and an effortless ordering experience.
        </p>
    </div>
</section>

<!-- ═══ Story ═══ -->
<section class="section">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-12 col-lg-10 col-xl-8">
                <div class="section-kicker">Our Story</div>
                <h2 class="section-title mb-3">Why Amal Collection?</h2>
                <p class="text-secondary lh-lg">
                    We understand what discerning women look for in seasonal attire: breathable, pure fabrics, accurate tailored sizing,
                    and a seamless shopping journey without friction. That is why we built our store to let you order
                    <strong class="text-dark">without mandatory registration</strong> — simply provide your name, phone number, and delivery address.
                </p>
                <p class="text-secondary lh-lg">
                    From featherlight lawn, breathable cotton, and airy chiffon for <strong class="text-dark">Summer</strong>, to rich khaddar,
                    warm wool blends, and cozy heavy cotton for <strong class="text-dark">Winter</strong> — all curated in one refined destination.
                </p>
                <div class="about-stats d-flex flex-wrap gap-4 mt-4 justify-content-center">
                    <div class="astat"><b>500+</b><span>Happy Customers</span></div>
                    <div class="astat"><b>2</b><span>Seasonal Collections</span></div>
                    <div class="astat"><b>7-Day</b><span>Easy Exchange</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══ Values ═══ -->
<section class="section section-alt">
    <div class="container">
        <div class="mb-4 text-center">
            <div class="section-kicker">Why We Stand Out</div>
            <h2 class="section-title">Our Promise</h2>
        </div>
        <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-4">
                <div class="value-card h-100">
                    <div class="value-icon"><i class="bi bi-tag"></i></div>
                    <h3>Suits Only — Pure Focus</h3>
                    <p>Curated exclusively for ladies summer and winter suits. Every piece is inspected for fabric integrity and silhouette perfection.</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="value-card h-100">
                    <div class="value-icon"><i class="bi bi-lightning-charge"></i></div>
                    <h3>No Login to Order</h3>
                    <p>Zero friction. Complete your order in under two minutes with our swift guest checkout — no passwords required.</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="value-card h-100">
                    <div class="value-icon"><i class="bi bi-truck"></i></div>
                    <h3>Swift Delivery</h3>
                    <p>Same-city delivery within 24–48 hours; nationwide delivery right to your doorstep within 2–4 business days.</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="value-card h-100">
                    <div class="value-icon"><i class="bi bi-cash-coin"></i></div>
                    <h3>Cash on Delivery</h3>
                    <p>Shop with complete confidence. Pay securely in cash only after receiving and inspecting your parcel.</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="value-card h-100">
                    <div class="value-icon"><i class="bi bi-arrow-repeat"></i></div>
                    <h3>7-Day Easy Exchange</h3>
                    <p>Need a different size or fit? Enjoy straightforward, hassle-free exchanges with our friendly support team.</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="value-card h-100">
                    <div class="value-icon"><i class="bi bi-whatsapp"></i></div>
                    <h3>WhatsApp Support</h3>
                    <p>Need fabric advice, sizing verification, or order updates? Speak directly with our styling team on WhatsApp.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══ Size Guide ═══ -->
<section class="section" id="size-guide">
    <div class="container">
        <div class="mb-4 text-center">
            <div class="section-kicker">Find Your Fit</div>
            <h2 class="section-title">Size Guide</h2>
            <p class="section-sub">Standard body measurements for ladies suits (in inches).</p>
        </div>
        <div class="table-responsive border rounded bg-white">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Size</th><th>Bust</th><th>Waist</th><th>Hips</th><th>Shirt Length</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>XS</td><td>32"</td><td>26"</td><td>35"</td><td>40"</td></tr>
                    <tr><td>S</td><td>34"</td><td>28"</td><td>37"</td><td>41"</td></tr>
                    <tr><td>M</td><td>36"</td><td>30"</td><td>39"</td><td>42"</td></tr>
                    <tr><td>L</td><td>38"</td><td>32"</td><td>41"</td><td>43"</td></tr>
                    <tr><td>XL</td><td>40"</td><td>34"</td><td>43"</td><td>44"</td></tr>
                    <tr><td>XXL</td><td>42"</td><td>36"</td><td>45"</td><td>45"</td></tr>
                </tbody>
            </table>
        </div>
        <p class="size-note mt-3">
            <i class="bi bi-lightbulb text-warning me-1"></i>
            Tip: If you prefer a relaxed or flowing fit, choose your regular size. If you are in between sizes, feel free to send us your measurements on WhatsApp for personalized assistance.
        </p>
    </div>
</section>

<!-- ═══ FAQ ═══ -->
<section class="section section-alt" id="faqs">
    <div class="container">
        <div class="mb-4 text-center">
            <div class="section-kicker">FAQs</div>
            <h2 class="section-title">Frequently Asked Questions</h2>
        </div>
        <div class="accordion mx-auto" id="faqAcc" style="max-width:820px;">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                        Do I need an account to place an order?
                    </button>
                </h2>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAcc">
                    <div class="accordion-body">
                        No account is required. You can check out directly as a guest — simply enter your name, contact phone number, and delivery address, and pay via Cash on Delivery.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                        What payment methods do you accept?
                    </button>
                </h2>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                    <div class="accordion-body">
                        We currently offer Cash on Delivery (COD) nationwide across Pakistan. Digital payment options including JazzCash, EasyPaisa, and debit/credit card payments are coming soon.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                        How long does delivery take?
                    </button>
                </h2>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                    <div class="accordion-body">
                        Local deliveries within the same city arrive within 24–48 hours. Orders to all other destinations across Pakistan arrive within 2–4 business days.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                        What if my suit doesn't fit properly?
                    </button>
                </h2>
                <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                    <div class="accordion-body">
                        We offer a 7-day exchange window on unworn suits with original tags intact. Simply reach out to us on WhatsApp to initiate a quick and easy size exchange.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                        Do you offer men's or kids' clothing?
                    </button>
                </h2>
                <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                    <div class="accordion-body">
                        We specialize exclusively in ladies summer and winter collections to ensure supreme craftsmanship, fine fabric sourcing, and dedicated styling.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq6">
                        Are stitched and unstitched suits available?
                    </button>
                </h2>
                <div id="faq6" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                    <div class="accordion-body">
                        Yes, we offer stitched, semi-stitched, and unstitched options. You can easily filter by stitched type using the filter drawer on our collection page.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="newsletter py-5">
    <div class="container text-center">
        <div class="section-kicker">Curated For You</div>
        <h2 class="section-title">Discover Your Perfect Suit</h2>
        <p class="section-sub">No login required · Cash on delivery · 7-day easy exchange</p>
        <div class="mt-4">
            <a href="/#products" class="btn btn-gold">Explore Collections</a>
        </div>
    </div>
</section>
