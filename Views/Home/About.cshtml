@{
    ViewData["Title"] = "About Us";
}

<!-- ═══ About Hero ═══ -->
<section class="about-hero py-5">
    <div class="container">
        <div class="section-kicker">About Us</div>
        <h1 class="about-title">Ladies Suits,<br />Crafted with Care</h1>
        <p class="about-lead">
            Amal Collection ek local clothing store hai jo sirf ladies suits – summer aur winter – offer karta hai.
            Hum quality fabrics, honest prices aur asani se order karne ka tareeqa laate hain.
        </p>
    </div>
</section>

<!-- ═══ Story ═══ -->
<section class="section">
    <div class="container">
        <div class="row g-4 g-lg-5 align-items-center">
            <div class="col-12 col-lg-6">
                <div class="about-img" style="background-image:url('/images/suit-hero-unstitched.jpg')"></div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="section-kicker">Our Story</div>
                <h2 class="section-title mb-3">Why Amal Collection?</h2>
                <p class="text-secondary lh-lg">
                    Hum jaante hain ke local customers ko kya chahiye: accha fabric, sahi size aur bina kisi jhanjhat ke order.
                    Isi wajah se humne apni website aisa banaya hai ke aap <strong class="text-dark">bina login ke</strong> suit order kar sakte hain –
                    sirf naam, phone aur address.
                </p>
                <p class="text-secondary lh-lg">
                    <strong class="text-dark">Summer</strong> ke liye lawn, cotton aur chiffon suits; <strong class="text-dark">Winter</strong> ke liye khaddar,
                    wool aur heavy cotton – sab ek hi jagah.
                </p>
                <div class="about-stats d-flex flex-wrap gap-4 mt-4">
                    <div class="astat"><b>500+</b><span>Happy Customers</span></div>
                    <div class="astat"><b>2</b><span>Seasonal Collections</span></div>
                    <div class="astat"><b>7-Day</b><span>Easy Exchange</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══ Values ═══ -->
<section class="section section-alt">
    <div class="container">
        <div class="mb-4">
            <div class="section-kicker">Why We Stand Out</div>
            <h2 class="section-title">Our Promise</h2>
        </div>
        <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-4">
                <div class="value-card h-100">
                    <div class="value-icon"><i class="bi bi-tshirt"></i></div>
                    <h3>Suits Only – Focused</h3>
                    <p>Sirf ladies summer &amp; winter suits. Har suit fabric aur fit check karke list hota hai.</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="value-card h-100">
                    <div class="value-icon"><i class="bi bi-lightning-charge"></i></div>
                    <h3>No Login to Order</h3>
                    <p>Account banane ki zaroorat nahi. Guest checkout se 2 minute mein order place karein.</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="value-card h-100">
                    <div class="value-icon"><i class="bi bi-truck"></i></div>
                    <h3>Local Fast Delivery</h3>
                    <p>Same-city delivery 24–48 ghante mein. Nationwide 2–4 working days.</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="value-card h-100">
                    <div class="value-icon"><i class="bi bi-cash-coin"></i></div>
                    <h3>Cash on Delivery</h3>
                    <p>Paisay sirf tab dein jab suit aapke haath mein ho. COD 100% available.</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="value-card h-100">
                    <div class="value-icon"><i class="bi bi-arrow-repeat"></i></div>
                    <h3>7-Day Exchange</h3>
                    <p>Size fit na ho to asani se exchange – bina drama, tags ke sath.</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="value-card h-100">
                    <div class="value-icon"><i class="bi bi-whatsapp"></i></div>
                    <h3>WhatsApp Support</h3>
                    <p>Order, size ya fabric sawal? WhatsApp par seedha rabta karein.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══ Size Guide ═══ -->
<section class="section" id="size-guide">
    <div class="container">
        <div class="mb-4">
            <div class="section-kicker">Find Your Fit</div>
            <h2 class="section-title">Size Guide</h2>
            <p class="section-sub">Ladies suits ke liye standard body measurements (inches).</p>
        </div>
        <div class="table-responsive border rounded bg-white">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Size</th><th>Bust</th><th>Waist</th><th>Hips</th><th>Shirt Length</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>XS</td><td>32"</td><td>26"</td><td>35"</td><td>40"</td></tr>
                    <tr><td>S</td><td>34"</td><td>28"</td><td>37"</td><td>41"</td></tr>
                    <tr><td>M</td><td>36"</td><td>30"</td><td>39"</td><td>42"</td></tr>
                    <tr><td>L</td><td>38"</td><td>32"</td><td>41"</td><td>43"</td></tr>
                    <tr><td>XL</td><td>40"</td><td>34"</td><td>43"</td><td>44"</td></tr>
                    <tr><td>XXL</td><td>42"</td><td>36"</td><td>45"</td><td>45"</td></tr>
                </tbody>
            </table>
        </div>
        <p class="size-note mt-3">
            <i class="bi bi-lightbulb text-warning me-1"></i>
            Tip: Loose fit pasand ho to apna usual size lein. Confusion ho to WhatsApp par measurement bhejein.
        </p>
    </div>
</section>

<!-- ═══ FAQ ═══ -->
<section class="section section-alt" id="faqs">
    <div class="container">
        <div class="mb-4">
            <div class="section-kicker">FAQs</div>
            <h2 class="section-title">Frequently Asked Questions</h2>
        </div>
        <div class="accordion" id="faqAcc" style="max-width:820px;">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                        Kya order karne ke liye login zaroori hai?
                    </button>
                </h2>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAcc">
                    <div class="accordion-body">
                        Nahi. Aap bina account banaye order kar sakte hain – sirf naam, phone aur delivery address bharein aur COD se payment karein.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                        Payment ke tareeqe kya hain?
                    </button>
                </h2>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                    <div class="accordion-body">
                        Filhaal Cash on Delivery available hai. JazzCash, EasyPaisa aur card payments jaldi aa rahe hain.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                        Delivery kitne din mein hoti hai?
                    </button>
                </h2>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                    <div class="accordion-body">
                        Same-city mein 24–48 ghante. Baaki Pakistan mein 2–4 working days.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                        Size fit na ho to kya karun?
                    </button>
                </h2>
                <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                    <div class="accordion-body">
                        7 din ke andar tags ke sath size exchange karein. WhatsApp par exchange request bhejein.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                        Kya aap men's ya kids ke suits dete hain?
                    </button>
                </h2>
                <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                    <div class="accordion-body">
                        Filhaal sirf ladies summer &amp; winter suits. Baaki categories baad mein add hongi.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq6">
                        Stitched ya unstitched options milte hain?
                    </button>
                </h2>
                <div id="faq6" class="accordion-collapse collapse" data-bs-parent="#faqAcc">
                    <div class="accordion-body">
                        Ji haan – stitched, semi-stitched aur unstitched options available hain. Homepage filter ya product page par Stitched type check karein.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="newsletter py-5">
    <div class="container text-center">
        <div class="section-kicker">Ready?</div>
        <h2 class="section-title">Apna Pehla Suit Order Karein</h2>
        <p class="section-sub">No login · COD · 7-day exchange</p>
        <div class="mt-4">
            <a href="/#products" class="btn btn-gold">Shop Collection</a>
        </div>
    </div>
</section>
