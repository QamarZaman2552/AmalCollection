@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">

    <!-- Hero -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="about-hero text-center p-5">
                <h1 class="display-4 mb-3">Welcome to <span class="about-gradient-text">Amal Collection</span></h1>
                <p class="lead mx-auto" style="max-width: 680px; color: var(--text-2);">
                    Elegant summer and winter ladies suits — stitched with care, delivered across Pakistan with cash on delivery.
                </p>
            </div>
        </div>
    </div>

    <!-- Values -->
    <div class="row mb-5 text-center">
        <div class="col-12 mb-4">
            <h2 class="display-6 fw-bold">Why Shop With <span class="about-gradient-text">Amal Collection</span></h2>
            <p style="color: var(--text-3);">Three simple promises for every order.</p>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 essential-card py-4 px-3">
                <div class="card-body">
                    <div class="essential-icon mb-3">1</div>
                    <h3 class="h4 fw-bold">No Login Needed</h3>
                    <p style="color: var(--text-2); font-size: 0.9rem; line-height: 1.7;">Browse, pick your size and color, and order as a guest — name, phone, and address are enough.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 essential-card py-4 px-3">
                <div class="card-body">
                    <div class="essential-icon mb-3">2</div>
                    <h3 class="h4 fw-bold">Cash on Delivery</h3>
                    <p style="color: var(--text-2); font-size: 0.9rem; line-height: 1.7;">Pay when your parcel arrives. Free delivery on most suits; delivery charge shown clearly at checkout.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 essential-card py-4 px-3">
                <div class="card-body">
                    <div class="essential-icon mb-3">3</div>
                    <h3 class="h4 fw-bold">7-Day Exchange</h3>
                    <p style="color: var(--text-2); font-size: 0.9rem; line-height: 1.7;">Wrong size or change of mind? Contact us within 7 days for a smooth exchange.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Size guide -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <div class="text-center mb-4">
                <h2 class="display-6 fw-bold">Size <span class="about-gradient-text">Guide</span></h2>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered text-center align-middle">
                    <thead>
                        <tr>
                            <th>Size</th>
                            <th>Chest (in)</th>
                            <th>Waist (in)</th>
                            <th>Shoulder (in)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>XS</td><td>32</td><td>26</td><td>13.5</td></tr>
                        <tr><td>S</td><td>34</td><td>28</td><td>14</td></tr>
                        <tr><td>M</td><td>36</td><td>30</td><td>14.5</td></tr>
                        <tr><td>L</td><td>38</td><td>32</td><td>15</td></tr>
                        <tr><td>XL</td><td>40</td><td>34</td><td>15.5</td></tr>
                        <tr><td>XXL</td><td>42</td><td>36</td><td>16</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- FAQ -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                <h2 class="display-6 fw-bold">Frequently Asked <span class="about-gradient-text">Questions</span></h2>
                <p style="color: var(--text-3);">Everything you need to know about Amal Collection.</p>
            </div>
            <div class="faq-list" id="faqList">

                <div class="faq-item active" id="faq-1">
                    <button class="faq-question" onclick="toggleFaq('faq-1')">
                        <span class="faq-icon">1</span>
                        <span>Do I need an account to order?</span>
                        <span class="faq-chevron">›</span>
                    </button>
                    <div class="faq-answer">
                        <p>No. You can order as a guest with just your name, phone number, and delivery address. Cash on Delivery is available.</p>
                    </div>
                </div>

                <div class="faq-item" id="faq-2">
                    <button class="faq-question" onclick="toggleFaq('faq-2')">
                        <span class="faq-icon">2</span>
                        <span>What is your delivery time?</span>
                        <span class="faq-chevron">›</span>
                    </button>
                    <div class="faq-answer">
                        <p>Most orders across Pakistan arrive within 3–5 working days after confirmation.</p>
                    </div>
                </div>

                <div class="faq-item" id="faq-3">
                    <button class="faq-question" onclick="toggleFaq('faq-3')">
                        <span class="faq-icon">3</span>
                        <span>What is your exchange policy?</span>
                        <span class="faq-chevron">›</span>
                    </button>
                    <div class="faq-answer">
                        <p>We offer a 7-day exchange for size issues on unworn items with tags intact. Contact us with your order number to start.</p>
                    </div>
                </div>

                <div class="faq-item" id="faq-4">
                    <button class="faq-question" onclick="toggleFaq('faq-4')">
                        <span class="faq-icon">4</span>
                        <span>Do you ship internationally?</span>
                        <span class="faq-chevron">›</span>
                    </button>
                    <div class="faq-answer">
                        <p>We currently deliver within Pakistan with nationwide courier coverage.</p>
                    </div>
                </div>

                <div class="faq-item" id="faq-5">
                    <button class="faq-question" onclick="toggleFaq('faq-5')">
                        <span class="faq-icon">5</span>
                        <span>Are the suits stitched or unstitched?</span>
                        <span class="faq-chevron">›</span>
                    </button>
                    <div class="faq-answer">
                        <p>We stock stitched, semi-stitched, and unstitched options. Use the filter on the homepage or check the product page for Stitched type and pieces.</p>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
function toggleFaq(id) {
    const item = document.getElementById(id);
    const isActive = item.classList.contains('active');
    document.querySelectorAll('.faq-item').forEach(el => el.classList.remove('active'));
    if (!isActive) item.classList.add('active');
}
</script>
}
