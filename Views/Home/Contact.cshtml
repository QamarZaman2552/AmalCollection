@{
    ViewData["Title"] = "Contact Us";
}

<section class="section">
    <div class="section-header">
        <span class="section-subtitle">Get in Touch</span>
        <h2 class="section-title">Contact Amal Collection</h2>
        <p class="section-desc">Questions about sizes, fabrics, or an order? We reply within one working day. Cash on delivery across Pakistan — no login needed to order.</p>
    </div>

    <div class="contact-grid">
        <div class="contact-info-card card">
            <div class="contact-channel">
                <div class="contact-icon">☎</div>
                <div>
                    <div class="contact-label">Call / WhatsApp</div>
                    <a href="tel:03216068091">0321-6068091</a>
                </div>
            </div>
            <div class="contact-channel">
                <div class="contact-icon">✉</div>
                <div>
                    <div class="contact-label">Email</div>
                    <a href="mailto:hello@amalcollection.pk">hello@amalcollection.pk</a>
                </div>
            </div>
            <div class="contact-channel">
                <div class="contact-icon">⌂</div>
                <div>
                    <div class="contact-label">Location</div>
                    <span>Lahore, Punjab, Pakistan</span>
                </div>
            </div>
            <div class="contact-notes">
                <p><strong>Cash on Delivery</strong> available nationwide.</p>
                <p><strong>7-Day Exchange</strong> on unworn suits with tags.</p>
                <p>Mon–Sat · 10am–7pm PKT</p>
            </div>
        </div>

        <div class="contact-form-wrap card">
            @if (TempData["Success"] != null)
            {
                <div class="alert-success contact-alert">@TempData["Success"]</div>
            }
            <form action="/Contact/Submit" method="POST">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="Name" placeholder="Your name" required />
                </div>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="Email" placeholder="you@example.com" required />
                </div>
                <div class="form-group">
                    <label for="message">Your Message</label>
                    <textarea id="message" name="Message" rows="6" placeholder="How can we help you?" required></textarea>
                </div>
                <button type="submit" class="btn-primary contact-submit">Send Message</button>
            </form>
        </div>
    </div>
</section>
