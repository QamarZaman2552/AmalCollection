@using ShoppingApp.Data
@inject AppDbContext _db
@{
    ViewData["Title"] = "Contact Us";
    var settings = _db.SiteSettings.FirstOrDefault(s => s.Id == 1);
    var phone = string.IsNullOrWhiteSpace(settings?.ContactPhone) ? "0321-6068091" : settings!.ContactPhone!;
    var email = string.IsNullOrWhiteSpace(settings?.ContactEmail) ? "hello@amalcollection.pk" : settings!.ContactEmail!;
    var wa = settings?.ContactWhatsapp;
    var waDigits = string.IsNullOrWhiteSpace(wa) ? "" : new string(wa.Where(char.IsDigit).ToArray());
    if (waDigits.Length > 0 && !waDigits.StartsWith("92") && waDigits.StartsWith("0"))
        waDigits = "92" + waDigits[1..];
}

<section class="section">
    <div class="section-header">
        <span class="section-subtitle">Get in Touch</span>
        <h2 class="section-title">Contact Amal Collection</h2>
        <p class="section-desc">Questions about sizes, fabrics, or an order? We reply within one working day. Cash on delivery across Pakistan — no login needed to order.</p>
    </div>

    <div class="contact-grid">
        <div class="contact-info-card card">
            <div class="contact-channel">
                <div class="contact-icon">☎</div>
                <div>
                    <div class="contact-label">Call</div>
                    <a href="tel:@phone">@phone</a>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(wa))
            {
                <div class="contact-channel">
                    <div class="contact-icon contact-icon-wa" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    </div>
                    <div>
                        <div class="contact-label">WhatsApp</div>
                        @if (!string.IsNullOrWhiteSpace(waDigits))
                        {
                            <a href="https://wa.me/@waDigits" target="_blank" rel="noopener noreferrer">@wa</a>
                        }
                        else
                        {
                            <span>@wa</span>
                        }
                    </div>
                </div>
            }
            <div class="contact-channel">
                <div class="contact-icon">✉</div>
                <div>
                    <div class="contact-label">Email</div>
                    <a href="mailto:@email">@email</a>
                </div>
            </div>
            <div class="contact-channel">
                <div class="contact-icon">⌂</div>
                <div>
                    <div class="contact-label">Location</div>
                    <span>Lahore, Punjab, Pakistan</span>
                </div>
            </div>
            <div class="contact-notes">
                <p><strong>Cash on Delivery</strong> available nationwide.</p>
                <p><strong>7-Day Exchange</strong> on unworn suits with tags.</p>
                <p>Mon–Sat · 10am–7pm PKT</p>
            </div>
        </div>

        <div class="contact-form-wrap card">
            @if (TempData["Success"] != null)
            {
                <div class="alert-success contact-alert">@TempData["Success"]</div>
            }
            <form action="/Contact/Submit" method="POST">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="Name" placeholder="Your name" required />
                </div>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="Email" placeholder="you@example.com" required />
                </div>
                <div class="form-group">
                    <label for="message">Your Message</label>
                    <textarea id="message" name="Message" rows="6" placeholder="How can we help you?" required></textarea>
                </div>
                <button type="submit" class="btn-primary contact-submit">Send Message</button>
            </form>
        </div>
    </div>
</section>
