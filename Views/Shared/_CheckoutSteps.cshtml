@model int
@{
    // 1 = Cart, 2 = Details, 3 = Confirm
    var steps = new[]
    {
        new { Number = 1, Label = "Cart",    Icon = "bi-bag" },
        new { Number = 2, Label = "Details", Icon = "bi-person" },
        new { Number = 3, Label = "Confirm", Icon = "bi-check2-circle" }
    };
    var current = Math.Clamp(Model, 1, 3);
}
<nav class="checkout-steps" aria-label="Checkout progress">
    <ol>
        @foreach (var s in steps)
        {
            var state = s.Number < current ? "is-done" : s.Number == current ? "is-current" : "is-todo";
            var isCurrent = s.Number == current;
            var isDone = s.Number < current;
            <li class="@state">
                @if (s.Number == 1 && current > 1)
                {
                    <a href="/Cart" class="cs-link">
                        <span class="cs-dot" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                        <span class="cs-label">@s.Label</span>
                    </a>
                }
                else
                {
                    <span class="cs-link" aria-current="@(isCurrent ? "step" : null)">
                        <span class="cs-dot" aria-hidden="true">
                            @if (isDone)
                            {
                                <i class="bi bi-check-lg"></i>
                            }
                            else
                            {
                                <i class="bi @s.Icon"></i>
                            }
                        </span>
                        <span class="cs-label">@s.Label</span>
                    </span>
                }
            </li>
        }
    </ol>
</nav>
