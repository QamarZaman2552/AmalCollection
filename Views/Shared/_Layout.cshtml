@using ShoppingApp.Data
@inject AppDbContext _db
@{
    var siteSettings = _db.SiteSettings.FirstOrDefault(s => s.Id == 1);
    var waNum = siteSettings?.ContactWhatsapp;
    var waDigits = string.IsNullOrWhiteSpace(waNum) ? "" : new string(waNum.Where(char.IsDigit).ToArray());
    if (waDigits.Length > 0 && waDigits.StartsWith("0") && !waDigits.StartsWith("92"))
        waDigits = "92" + waDigits[1..];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content="Amal Collection – elegant summer & winter ladies suits with cash on delivery across Pakistan." />
    <title>@ViewData["Title"] – Amal Collection</title>
    <script>
        (function () {
            var t = localStorage.getItem('theme');
            if (t !== 'dark') {
                function applyLight() { document.body.classList.add('light-mode'); }
                if (document.body) { applyLight(); }
                else { document.addEventListener('DOMContentLoaded', applyLight); }
            }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <!-- ─── Navigation ─────────────────────────────────────── -->
    <header class="navbar">
    <div class="navbar-inner">
        <a href="/" class="brand">
            <span>Amal Collection</span>
        </a>

        <!-- Search Bar -->
        <form class="nav-search" action="/Products/Search" method="get">
            <input type="text" name="q" placeholder="Search suits, fabrics &amp; categories..." value="@ViewBag.Query" autocomplete="off" />
            <button type="submit" aria-label="Search">Search</button>
        </form>

        <!-- Nav Links -->
        <nav class="nav-links">
            <a href="/">Home</a>
            <a href="/About">About</a>
            <a href="/Contact">Contact us</a>
            @if (Context.Session.GetString("UserRole") == "admin")
            {
                var unreadMsgs = _db.ContactMessages.Count(m => !m.IsRead);
                <a href="/Admin/Products" class="nav-admin">⚙ Admin</a>
                <a href="/Admin/Users" class="nav-admin">👥 Users</a>
                <a href="/Admin/Messages" class="nav-admin">
                    ✉ Messages
                    @if (unreadMsgs > 0)
                    {
                        <span style="background-color: #ff4757; color: white; border-radius: 12px; padding: 2px 6px; font-size: 0.75rem; font-weight: bold; margin-left: 4px;">@unreadMsgs</span>
                    }
                </a>
            }
            @if (Context.Session.GetInt32("UserId") != null)
            {
                if (Context.Session.GetString("UserRole") != "admin")
                {
                    <a href="/Orders/History">My Orders</a>
                    <a href="/Wishlist" class="wishlist-nav-link">
                        ❤️ Wishlist <span class="wishlist-badge" id="wishlistBadge">0</span>
                    </a>
                    <a href="/Cart" class="cart-link">
                        🛒 Cart <span class="cart-badge" id="cartBadge">0</span>
                    </a>
                }
                <a href="/Profile" class="nav-profile-link">👤 @Context.Session.GetString("UserName")</a>
                <a href="/Auth/Logout" class="btn-outline-sm">Logout</a>
            }
            else
            {
                    <a href="/Auth/Login" class="btn-outline-sm">Login</a>
                    <a href="/Auth/Register" class="btn-primary-sm">Register</a>
                    <a href="/Cart" class="cart-link">
                        Cart <span class="cart-badge" id="cartBadge">0</span>
                    </a>
            }
        </nav>

        <!-- Theme Toggle -->
        <button id="themeToggle">
            <svg id="themeIcon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <span id="themeLabel">Dark</span>
        </button>

        <!-- Hamburger (mobile) -->
        <button class="hamburger" id="hamburgerBtn" aria-label="Toggle menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
    </div>
    </header>

    <!-- Mobile Search Bar (always visible below navbar on mobile) -->
    <div class="mobile-search-bar">
        <form class="mobile-search-form" action="/Products/Search" method="get">
            <svg class="mobile-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="q" placeholder="Search suits, fabrics &amp; categories..." value="@ViewBag.Query" autocomplete="off" />
        </form>
    </div>

    <!-- ─── Mobile Menu ──────────────────────────────────── -->
    <div class="mobile-menu" id="mobileMenu">
        <!-- Mobile Search -->
        <form class="mobile-search" action="/Products/Search" method="get">
            <input type="text" name="q" placeholder="Search suits, fabrics &amp; categories..." autocomplete="off" />
            <button type="submit">Search</button>
        </form>
        <a href="/">🏠 Home</a>
        <a href="/About">ℹ️ About</a>
        <a href="/Contact">✉️ Contact</a>
        @if (Context.Session.GetString("UserRole") == "admin")
        {
            var unreadMsgs = _db.ContactMessages.Count(m => !m.IsRead);
            <a href="/Admin/Products" style="color:var(--accent-2)">⚙️ Admin Panel</a>
            <a href="/Admin/Users" style="color:var(--accent-2)">👥 Users</a>
            <a href="/Admin/Messages" style="color:var(--accent-2)">
                ✉️ Messages
                @if (unreadMsgs > 0)
                {
                    <span style="background-color: #ff4757; color: white; border-radius: 12px; padding: 2px 6px; font-size: 0.75rem; font-weight: bold; margin-left: 4px;">@unreadMsgs</span>
                }
            </a>
            <a href="/Admin/Analytics" style="color:var(--accent-2)">📊 Analytics</a>
        }
        @if (Context.Session.GetInt32("UserId") != null)
        {
            if (Context.Session.GetString("UserRole") != "admin")
            {
                <a href="/Orders/History">📋 My Orders</a>
                    <a href="/Wishlist">Wishlist</a>
                <a href="/Cart">🛒 Cart</a>
            }
            <a href="/Profile">👤 @Context.Session.GetString("UserName")</a>
            <a href="/Auth/Logout" style="color:var(--red)">🚪 Logout</a>
        }
        else
        {
            <a href="/Auth/Login">🔑 Login</a>
            <a href="/Auth/Register" style="color:var(--accent-2)">✨ Register</a>
        }
        <button class="mobile-theme-toggle" id="mobileThemeToggle" style="width:100%;padding:0.75rem 0;background:none;border:none;border-bottom:1px solid var(--border);color:var(--text-2);font-size:0.92rem;cursor:pointer;text-align:left;display:flex;align-items:center;gap:0.5rem;font-family:inherit;">
            <svg class="mobile-theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <span class="mobile-theme-label">Toggle Theme</span>
        </button>
    </div>
    <!-- Mobile menu overlay -->
    <div class="mobile-menu-overlay" id="mobileOverlay"></div>

    <!-- ─── Toast Notifications ──────────────────────────────── -->
    @if (TempData["Success"] != null)
    {
        <div class="toast toast-success" id="toast-success">✅ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast toast-error" id="toast-error">❌ @TempData["Error"]</div>
    }

    <!-- ─── Main Content ─────────────────────────────────────── -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- ─── Footer ──────────────────────────────────────────── -->
    <footer class="footer">
        <div class="footer-inner">
            <p>© 2026 <strong>Amal Collection</strong> · Developed by <strong>Qamar Zaman</strong></p>
            <div class="footer-links">
                <a href="/">All Products</a>
                <span>·</span>
                <a href="/About">About</a>
                <span>·</span>
                <a href="/Contact">Contact</a>
                <span>·</span>
                <a href="/Auth/Register">Register</a>
                <span>·</span>
                <a href="/Auth/Login">Login</a>
            </div>
        </div>
    </footer>

    <!-- ─── Chatbot Widget ────────────────────────────────────── -->
    @if (!string.IsNullOrWhiteSpace(waDigits))
    {
        <a class="wa-float" href="https://wa.me/@waDigits" target="_blank" rel="noopener noreferrer" title="Chat on WhatsApp" aria-label="Chat on WhatsApp">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
    }

    <div class="chatbot-bubble" id="chatBubble" title="Chat with Amal Collection">
        <span class="chatbot-icon">Chat</span>
        <span class="chatbot-ping"></span>
    </div>

    <div class="chatbot-window" id="chatWindow">
        <div class="chatbot-header">
            <div class="chatbot-avatar">AC</div>
            <div>
                <div class="chatbot-name">Amal Collection Assistant</div>
                <div class="chatbot-status">● Online</div>
            </div>
            <button class="chatbot-close" id="chatClose">✕</button>
        </div>
        <div class="chatbot-messages" id="chatMessages">
            <div class="chat-msg bot">
                <div class="chat-bubble">Hello! I'm your Amal Collection assistant. Ask me about suits, sizes, fabrics, shipping, or anything else!</div>
            </div>
        </div>
        <div class="chatbot-input-area">
            <input type="text" id="chatInput" placeholder="Type your message…" maxlength="300" />
            <button id="chatSend">➤</button>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Scroll Preservation: save position before navigation, restore on load -->
    <script>
        (function () {
            const KEY = 'amal_scroll_' + window.location.pathname;
            // Save on beforeunload (any navigation, reload, form submit)
            window.addEventListener('beforeunload', function () {
                sessionStorage.setItem(KEY, window.scrollY.toString());
            });
            // Restore on load
            window.addEventListener('load', function () {
                var pos = parseInt(sessionStorage.getItem(KEY), 10);
                if (!isNaN(pos) && pos > 0) {
                    window.scrollTo(0, pos);
                    sessionStorage.removeItem(KEY);
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
