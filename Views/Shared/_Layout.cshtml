@using ShoppingApp.Data
@inject AppDbContext _db
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content="BaazWix – Pakistan's premium AI-powered shopping destination with smart chatbot assistance." />
    <title>@ViewData["Title"] – BaazWix</title>
    <script>
        (function () {
            var t = localStorage.getItem('theme');
            if (t === 'light') document.body.classList.add('light-mode');
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <!-- ─── Navigation ─────────────────────────────────────── -->
    <header class="navbar">
    <div class="navbar-inner">
        <a href="/" class="brand">
            <img src="~/images/baazwix-logo.png" alt="BaazWix" class="brand-logo" />
            <span>BaazWix</span>
        </a>

        <!-- Search Bar -->
        <form class="nav-search" action="/Products/Search" method="get">
            <input type="text" name="q" placeholder="Search products, brands &amp; categories..." value="@ViewBag.Query" autocomplete="off" />
                <button type="submit"><img src="~/images/baazwix-logo.png" alt="BaazWix" class="brand-logo" /></button>
        </form>

        <!-- Nav Links -->
        <nav class="nav-links">
            <a href="/">Home</a>
            <a href="/About">About</a>
            <a href="/Contact">Contact us</a>
            @if (Context.Session.GetString("UserRole") == "admin")
            {
                var unreadMsgs = _db.ContactMessages.Count(m => !m.IsRead);
                <a href="/Admin/Products" class="nav-admin">⚙ Admin</a>
                <a href="/Admin/Users" class="nav-admin">👥 Users</a>
                <a href="/Admin/Messages" class="nav-admin">
                    ✉ Messages
                    @if (unreadMsgs > 0)
                    {
                        <span style="background-color: #ff4757; color: white; border-radius: 12px; padding: 2px 6px; font-size: 0.75rem; font-weight: bold; margin-left: 4px;">@unreadMsgs</span>
                    }
                </a>
            }
            @if (Context.Session.GetInt32("UserId") != null)
            {
                if (Context.Session.GetString("UserRole") != "admin")
                {
                    <a href="/Orders/History">My Orders</a>
                    <a href="/Wishlist" class="wishlist-nav-link">
                        ❤️ Wishlist <span class="wishlist-badge" id="wishlistBadge">0</span>
                    </a>
                    <a href="/Cart" class="cart-link">
                        🛒 Cart <span class="cart-badge" id="cartBadge">0</span>
                    </a>
                }
                <a href="/Profile" class="nav-profile-link">👤 @Context.Session.GetString("UserName")</a>
                <a href="/Auth/Logout" class="btn-outline-sm">Logout</a>
            }
            else
            {
                <a href="/Auth/Login" class="btn-outline-sm">Login</a>
                <a href="/Auth/Register" class="btn-primary-sm">Register</a>
            }
        </nav>

        <!-- Theme Toggle -->
        <button id="themeToggle">
            <svg id="themeIcon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <span id="themeLabel">Dark</span>
        </button>

        <!-- Hamburger (mobile) -->
        <button class="hamburger" id="hamburgerBtn" aria-label="Toggle menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
    </div>
    </header>

    <!-- ─── Mobile Menu ──────────────────────────────────── -->
    <div class="mobile-menu" id="mobileMenu">
        <!-- Mobile Search -->
        <form class="mobile-search" action="/Products/Search" method="get">
            <input type="text" name="q" placeholder="Search products, brands &amp; categories..." autocomplete="off" />
            <button type="submit">🔍</button>
        </form>
        <a href="/">🏠 Home</a>
        <a href="/About">ℹ️ About</a>
        <a href="/Contact">✉️ Contact</a>
        @if (Context.Session.GetString("UserRole") == "admin")
        {
            var unreadMsgs = _db.ContactMessages.Count(m => !m.IsRead);
            <a href="/Admin/Products" style="color:var(--accent-2)">⚙️ Admin Panel</a>
            <a href="/Admin/Users" style="color:var(--accent-2)">👥 Users</a>
            <a href="/Admin/Messages" style="color:var(--accent-2)">
                ✉️ Messages
                @if (unreadMsgs > 0)
                {
                    <span style="background-color: #ff4757; color: white; border-radius: 12px; padding: 2px 6px; font-size: 0.75rem; font-weight: bold; margin-left: 4px;">@unreadMsgs</span>
                }
            </a>
            <a href="/Admin/Analytics" style="color:var(--accent-2)">📊 Analytics</a>
        }
        @if (Context.Session.GetInt32("UserId") != null)
        {
            if (Context.Session.GetString("UserRole") != "admin")
            {
                <a href="/Orders/History">📋 My Orders</a>
                <a href="/Wishlist">❤️ Wishlist</a>
                <a href="/Cart">🛒 Cart</a>
            }
            <a href="/Profile">👤 @Context.Session.GetString("UserName")</a>
            <a href="/Auth/Logout" style="color:var(--red)">🚪 Logout</a>
        }
        else
        {
            <a href="/Auth/Login">🔑 Login</a>
            <a href="/Auth/Register" style="color:var(--accent-2)">✨ Register</a>
        }
        <button class="mobile-theme-toggle" id="mobileThemeToggle" style="width:100%;padding:0.75rem 0;background:none;border:none;border-bottom:1px solid var(--border);color:var(--text-2);font-size:0.92rem;cursor:pointer;text-align:left;display:flex;align-items:center;gap:0.5rem;font-family:inherit;">
            <svg class="mobile-theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <span class="mobile-theme-label">Toggle Theme</span>
        </button>
    </div>
    <!-- Mobile menu overlay -->
    <div class="mobile-menu-overlay" id="mobileOverlay"></div>

    <!-- ─── Toast Notifications ──────────────────────────────── -->
    @if (TempData["Success"] != null)
    {
        <div class="toast toast-success" id="toast-success">✅ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast toast-error" id="toast-error">❌ @TempData["Error"]</div>
    }

    <!-- ─── Main Content ─────────────────────────────────────── -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- ─── Footer ──────────────────────────────────────────── -->
    <footer class="footer">
        <div class="footer-inner">
            <p>© 2026 <strong>BaazWix</strong> — CS-UEM-BS-F22E8 · Developed by <strong>Qamar Zaman</strong></p>
            <div class="footer-links">
                <a href="/Products/Search?q=">All Products</a>
                <span>·</span>
                <a href="/About">About</a>
                <span>·</span>
                <a href="/Contact">Contact</a>
                <span>·</span>
                <a href="/Auth/Register">Register</a>
                <span>·</span>
                <a href="/Auth/Login">Login</a>
            </div>
        </div>
    </footer>

    <!-- ─── Chatbot Widget ────────────────────────────────────── -->
    <div class="chatbot-bubble" id="chatBubble" title="Chat with BaazWix">
        <span class="chatbot-icon">💬</span>
        <span class="chatbot-ping"></span>
    </div>

    <div class="chatbot-window" id="chatWindow">
        <div class="chatbot-header">
            <div class="chatbot-avatar">🤖</div>
            <div>
                <div class="chatbot-name">BaazWix Assistant</div>
                <div class="chatbot-status">● Online</div>
            </div>
            <button class="chatbot-close" id="chatClose">✕</button>
        </div>
        <div class="chatbot-messages" id="chatMessages">
            <div class="chat-msg bot">
                <div class="chat-bubble">👋 Hi! I'm your BaazWix assistant. Ask me about products, prices, shipping, or anything else!</div>
            </div>
        </div>
        <div class="chatbot-input-area">
            <input type="text" id="chatInput" placeholder="Type your message…" maxlength="300" />
            <button id="chatSend">➤</button>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Scroll Preservation: save position before navigation, restore on load -->
    <script>
        (function () {
            const KEY = 'baazwix_scroll_' + window.location.pathname;
            // Save on beforeunload (any navigation, reload, form submit)
            window.addEventListener('beforeunload', function () {
                sessionStorage.setItem(KEY, window.scrollY.toString());
            });
            // Restore on load
            window.addEventListener('load', function () {
                var pos = parseInt(sessionStorage.getItem(KEY), 10);
                if (!isNaN(pos) && pos > 0) {
                    window.scrollTo(0, pos);
                    sessionStorage.removeItem(KEY);
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
