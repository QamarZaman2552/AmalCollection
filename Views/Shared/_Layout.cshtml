@using ShoppingApp.Data
@inject AppDbContext _db
@{
    var siteSettings = _db.SiteSettings.FirstOrDefault(s => s.Id == 1);
    var waNum = siteSettings?.ContactWhatsapp;
    var waDigits = string.IsNullOrWhiteSpace(waNum) ? "" : new string(waNum.Where(char.IsDigit).ToArray());
    if (waDigits.Length > 0 && waDigits.StartsWith("0") && !waDigits.StartsWith("92"))
        waDigits = "92" + waDigits[1..];
    var contactPhone = siteSettings?.ContactPhone;
    if (string.IsNullOrWhiteSpace(contactPhone) || contactPhone.Contains("0000000"))
        contactPhone = "0321-6068091";
    var contactEmail = siteSettings?.ContactEmail;
    if (string.IsNullOrWhiteSpace(contactEmail))
        contactEmail = "hello@amalcollection.pk";
    var isAdmin = Context.Session.GetString("UserRole") == "admin";
    var userId = Context.Session.GetInt32("UserId");
    var unreadMsgs = isAdmin ? _db.ContactMessages.Count(m => !m.IsRead) : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="description" content="Amal Collection – elegant summer & winter ladies suits with cash on delivery across Pakistan." />
    <title>@ViewData["Title"] – Amal Collection</title>
    <script>
        (function () {
            var t = localStorage.getItem('theme');
            if (t !== 'dark') {
                function applyLight() { document.body.classList.add('light-mode'); }
                if (document.body) { applyLight(); }
                else { document.addEventListener('DOMContentLoaded', applyLight); }
            }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/prototype.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <!-- ─── Announcement Bar ─────────────────────────────── -->
    <div class="announce text-center">
        Cash on Delivery available &nbsp;·&nbsp; No login needed to order &nbsp;·&nbsp; 7-Day Exchange
    </div>

    <!-- ─── Navbar ───────────────────────────────────────── -->
    <nav class="navbar navbar-expand-lg sticky-top ac-nav">
        <div class="container">
            <a class="navbar-brand ac-brand" href="/">Amal<em>Collection</em></a>

            <div class="d-flex align-items-center order-1 order-lg-3 ms-auto ac-nav-wrap">
                <div class="d-flex align-items-center gap-1 ac-nav-actions">
                    <a href="/Wishlist" class="btn ac-icon-btn position-relative" aria-label="Wishlist">
                        <i class="bi bi-heart"></i>
                        <span class="ac-badge" id="wishlistBadge" style="display:none;">0</span>
                    </a>
                    <a href="/Cart" class="btn ac-icon-btn position-relative" aria-label="Cart">
                        <i class="bi bi-bag"></i>
                        <span class="ac-badge" id="cartBadge">0</span>
                    </a>
                    @if (userId != null && !isAdmin)
                    {
                        <a href="/Profile" class="btn btn-outline-dark btn-sm rounded-pill ms-1 d-none d-lg-inline-block"><i class="bi bi-person me-1"></i> @Context.Session.GetString("UserName")</a>
                        <a href="/Auth/Logout" class="btn-outline-sm ms-1 d-none d-lg-inline-block">Logout</a>
                    }
                    else if (userId != null && isAdmin)
                    {
                        <a href="/Admin/Products" class="btn btn-outline-dark btn-sm rounded-pill ms-1 d-none d-lg-inline-block"><i class="bi bi-gear me-1"></i> Admin</a>
                        <a href="/Auth/Logout" class="btn-outline-sm ms-1 d-none d-lg-inline-block">Logout</a>
                    }
                    else
                    {
                        <a href="/Auth/Login" class="btn btn-outline-dark btn-sm rounded-pill ms-1 d-none d-lg-inline-block">Sign in</a>
                    }
                </div>
                <button class="navbar-toggler ac-toggler ms-1 d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-3"></i>
                </button>
            </div>

            <div class="collapse navbar-collapse order-2 order-lg-1" id="mainNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 ac-nav-links">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <span>Home</span>
                            <i class="bi bi-chevron-right nav-link-chevron d-lg-none" aria-hidden="true"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/?season=Summer">
                            <span>Summer</span>
                            <i class="bi bi-chevron-right nav-link-chevron d-lg-none" aria-hidden="true"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/?season=Winter">
                            <span>Winter</span>
                            <i class="bi bi-chevron-right nav-link-chevron d-lg-none" aria-hidden="true"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/About">
                            <span>About Us</span>
                            <i class="bi bi-chevron-right nav-link-chevron d-lg-none" aria-hidden="true"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Contact">
                            <span>Contact</span>
                            <i class="bi bi-chevron-right nav-link-chevron d-lg-none" aria-hidden="true"></i>
                        </a>
                    </li>
                    @if (userId != null && !isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Orders/History">
                                <span>My Orders</span>
                                <i class="bi bi-chevron-right nav-link-chevron d-lg-none" aria-hidden="true"></i>
                            </a>
                        </li>
                    }
                    @if (isAdmin)
                    {
                        <li class="nav-section d-lg-none">Account</li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Admin/Products">
                                <span>Admin</span>
                                <i class="bi bi-chevron-right nav-link-chevron d-lg-none" aria-hidden="true"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Admin/Messages">
                                <span>Messages</span>
                                @if (unreadMsgs > 0)
                                {
                                    <span class="nav-msg-badge">@unreadMsgs</span>
                                }
                                <i class="bi bi-chevron-right nav-link-chevron d-lg-none ms-auto" aria-hidden="true"></i>
                            </a>
                        </li>
                    }
                </ul>

                <form class="d-none d-lg-flex ac-search mb-2 mb-lg-0" action="/Products/Search" method="get">
                    <input class="form-control" type="search" id="navSearch" name="q" placeholder="Search lawn suits, khaddar..." aria-label="Search" value="@ViewBag.Query" autocomplete="off" />
                    <button class="btn ac-search-btn" type="submit" aria-label="Search"><i class="bi bi-search"></i></button>
                </form>
            </div>
        </div>

        <div class="ac-mobile-search d-lg-none">
            <div class="container">
                <form class="d-flex ac-search" action="/Products/Search" method="get">
                    <input class="form-control" type="search" id="mobileNavSearch" name="q" placeholder="Search lawn suits, khaddar..." aria-label="Search" value="@ViewBag.Query" autocomplete="off" />
                    <button class="btn ac-search-btn" type="submit" aria-label="Search"><i class="bi bi-search"></i></button>
                </form>
            </div>
        </div>
    </nav>

    <!-- ─── Toast Notifications ──────────────────────────── -->
    @if (TempData["Success"] != null)
    {
        <div class="toast toast-success" id="toast-success"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast toast-error" id="toast-error"><i class="bi bi-x-circle"></i> @TempData["Error"]</div>
    }

    <!-- ─── Main Content ─────────────────────────────────── -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- ─── Footer ───────────────────────────────────────── -->
    <footer class="footer py-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-12 col-lg-4">
                    <div class="footer-brand">Amal<em>Collection</em></div>
                    <p class="footer-about">Ladies suits for summer &amp; winter – crafted with care, delivered locally. Quality fabrics, honest prices.</p>
                    <div class="footer-social d-flex gap-2">
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        @if (!string.IsNullOrWhiteSpace(waDigits))
                        {
                            <a href="https://wa.me/@waDigits" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                        }
                        <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h4>Shop</h4>
                    <ul class="list-unstyled">
                        <li><a href="/?season=Summer">Summer Suits</a></li>
                        <li><a href="/?season=Winter">Winter Suits</a></li>
                        <li><a href="/">New Arrivals</a></li>
                        <li><a href="/Cart">Cart</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h4>Help</h4>
                    <ul class="list-unstyled">
                        <li><a href="/About#size-guide">Size Guide</a></li>
                        <li><a href="/About">Shipping &amp; Delivery</a></li>
                        <li><a href="/About">Returns &amp; Exchange</a></li>
                        <li><a href="/About#faqs">FAQs</a></li>
                        <li><a href="/Contact">Contact Us</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h4>Contact</h4>
                    <ul class="list-unstyled">
                        @if (!string.IsNullOrWhiteSpace(waDigits))
                        {
                            <li><a href="https://wa.me/@waDigits" target="_blank" rel="noopener noreferrer"><i class="bi bi-whatsapp me-1"></i> @(contactPhone ?? waNum)</a></li>
                        }
                        else if (!string.IsNullOrWhiteSpace(contactPhone))
                        {
                            <li><a href="tel:@contactPhone"><i class="bi bi-telephone me-1"></i> @contactPhone</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(contactEmail))
                        {
                            <li><a href="mailto:@contactEmail"><i class="bi bi-envelope me-1"></i> @contactEmail</a></li>
                        }
                        <li><a href="/About"><i class="bi bi-info-circle me-1"></i> About Us</a></li>
                        <li><a href="/Wishlist"><i class="bi bi-heart me-1"></i> Wishlist</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom d-flex justify-content-between align-items-center flex-wrap gap-3 pt-3">
                <span>© 2026 Amal Collection. All rights reserved. · Developed by <strong>Qamar Zaman</strong></span>
                <div class="pay-badges d-flex gap-2 flex-wrap">
                    <span class="pay-badge">COD</span>
                    <span class="pay-badge">EASYPAISA</span>
                    <span class="pay-badge">JAZZCASH</span>
                    <span class="pay-badge">VISA</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- ─── WhatsApp Float ───────────────────────────────── -->
    @if (!string.IsNullOrWhiteSpace(waDigits))
    {
        <a class="wa-float" href="https://wa.me/@waDigits" target="_blank" rel="noopener noreferrer" title="Chat on WhatsApp" aria-label="Chat on WhatsApp">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
    }

    <div class="chatbot-bubble" id="chatBubble" title="Chat with Amal Assistant" aria-label="Chat with Amal Assistant">
        <span class="chatbot-icon"><i class="bi bi-chat-dots-fill"></i></span>
        <span class="chatbot-ping"></span>
    </div>

    <div class="chatbot-window" id="chatWindow">
        <div class="chatbot-header">
            <div class="chatbot-avatar"><i class="bi bi-stars"></i></div>
            <div>
                <div class="chatbot-name">Amal Stylist Assistant</div>
                <div class="chatbot-status">● Online · AI Powered</div>
            </div>
            <button class="chatbot-close" id="chatClose" aria-label="Close Chat"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="chatbot-messages" id="chatMessages">
            <div class="chat-msg bot">
                <div class="chat-bubble">Hello! I'm your Amal Collection assistant. How may I help you with suits, fabric details, sizing, or ordering today?</div>
            </div>
        </div>
        <div class="chatbot-input-area">
            <input type="text" id="chatInput" name="chatMessage" placeholder="Ask about suits, sizing, fabrics…" maxlength="300" />
            <button id="chatSend" aria-label="Send message"><i class="bi bi-send-fill"></i></button>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Lock pinch zoom only — do NOT block normal touch scroll
        (function () {
            function blockPinch(e) {
                if (e.touches && e.touches.length > 1) e.preventDefault();
            }
            document.addEventListener('touchstart', blockPinch, { passive: false });
            document.addEventListener('gesturestart', function (e) { e.preventDefault(); });
            document.addEventListener('gesturechange', function (e) { e.preventDefault(); });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
