@model List<ShoppingApp.Models.BreadcrumbItem>
@*
    Shared breadcrumb trail.
    Callers pass only the steps AFTER "Home"; the partial adds Home itself.

        <partial name="_Breadcrumb" model="@(new List<BreadcrumbItem>
        {
            new("Cart", "/Cart"),
            new("Checkout")
        })" />

    It also emits BreadcrumbList JSON-LD, so search engines see the same trail
    the visitor sees. Nothing is rendered when no steps are supplied.
*@
@{
    var crumbs = (Model ?? new List<ShoppingApp.Models.BreadcrumbItem>())
        .Where(c => !string.IsNullOrWhiteSpace(c.Label))
        .ToList();

    var trail = new List<ShoppingApp.Models.BreadcrumbItem>
    {
        new("Home", "/")
    };
    trail.AddRange(crumbs);

    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var currentUrl = origin + Context.Request.Path + Context.Request.QueryString;

    var ldItems = new List<Dictionary<string, object?>>();
    for (int i = 0; i < trail.Count; i++)
    {
        var crumb = trail[i];
        var abs = string.IsNullOrWhiteSpace(crumb.Url)
            ? currentUrl
            : origin + (crumb.Url!.StartsWith("/") ? crumb.Url : "/" + crumb.Url);
        ldItems.Add(new Dictionary<string, object?>
        {
            ["@type"] = "ListItem",
            ["position"] = i + 1,
            ["name"] = crumb.Label,
            ["item"] = abs
        });
    }

    var breadcrumbLd = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = ldItems
    };
    var breadcrumbLdJson = System.Text.Json.JsonSerializer.Serialize(breadcrumbLd);
}

@if (crumbs.Count > 0)
{
    <nav class="ac-breadcrumb" aria-label="Breadcrumb">
        <ol>
            @for (int i = 0; i < trail.Count; i++)
            {
                var crumb = trail[i];
                bool isLast = i == trail.Count - 1;
                var href = string.IsNullOrWhiteSpace(crumb.Url) ? "/" : crumb.Url;
                <li>
                    @if (isLast)
                    {
                        <span aria-current="page" title="@crumb.Label">@crumb.Label</span>
                    }
                    else
                    {
                        <a href="@href">@crumb.Label</a>
                    }
                </li>
            }
        </ol>
    </nav>
    @Html.Raw("<script type=\"application/ld+json\">" + breadcrumbLdJson + "</script>")
}
