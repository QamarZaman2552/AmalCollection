@model ShoppingApp.Models.SiteSettings
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin – Site Settings";
    ViewData["SidebarActive"] = "settings";
}

<div class="admin-header">
    <h1 class="section-title"><i class="bi bi-gear"></i> Site Settings</h1>
    <div class="admin-header-actions">
        <a href="/Admin/Products" class="btn-glass">Products</a>
        <a href="/Admin/Categories" class="btn-glass">Categories</a>
    </div>
</div>

<div class="form-card">
    <form method="post" action="/Admin/Settings" class="admin-form" data-submit-guard data-guard-label="Saving settings…">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <h2 style="margin:0.5rem 0 1rem;font-size:1rem;">Delivery</h2>
        <div class="form-grid-2">
            <div class="form-group" style="display:flex;align-items:center;gap:0.5rem;">
                <input type="checkbox" name="IsFreeDelivery" value="true" checked="@Model.IsFreeDelivery" style="width:auto;" id="freeDel" />
                <input type="hidden" name="IsFreeDelivery" value="false" />
                <label for="freeDel" style="margin:0;">Free delivery by default (site-wide)</label>
            </div>
            <div class="form-group">
                <label for="deliveryCharge">Default delivery charge (PKR)</label>
                <input type="number" id="deliveryCharge" name="DeliveryCharge" value="@Model.DeliveryCharge" min="0" step="1" />
            </div>
            <div class="form-group">
                <label for="freeThreshold">Free delivery above (PKR) — 0 = no threshold</label>
                <input type="number" id="freeThreshold" name="FreeDeliveryThreshold" value="@Model.FreeDeliveryThreshold" min="0" step="1" />
            </div>
            <div class="form-group" style="display:flex;align-items:center;gap:0.5rem;">
                <input type="checkbox" name="CodEnabled" value="true" checked="@Model.CodEnabled" style="width:auto;" id="codEn" />
                <input type="hidden" name="CodEnabled" value="false" />
                <label for="codEn" style="margin:0;">Cash on Delivery enabled</label>
            </div>
        </div>

        <h2 style="margin:1.2rem 0 1rem;font-size:1rem;">Contact</h2>
        <div class="form-grid-2">
            <div class="form-group">
                <label for="contactPhone">Phone</label>
                <input type="text" id="contactPhone" name="ContactPhone" value="@Model.ContactPhone" placeholder="03XX-XXXXXXX" />
            </div>
            <div class="form-group">
                <label for="contactWhatsapp">WhatsApp</label>
                <input type="text" id="contactWhatsapp" name="ContactWhatsapp" value="@Model.ContactWhatsapp" placeholder="03XX-XXXXXXX" />
            </div>
            <div class="form-group">
                <label for="contactEmail">Email</label>
                <input type="email" id="contactEmail" name="ContactEmail" value="@Model.ContactEmail" />
            </div>
        </div>

        <h2 style="margin:1.2rem 0 1rem;font-size:1rem;">Social links</h2>
        <p style="font-size:0.8rem;color:var(--text-3);margin:-0.4rem 0 0.9rem;">Leave blank to hide an icon in the footer.</p>
        <div class="form-grid-2">
            <div class="form-group">
                <label for="instagramUrl">Instagram URL</label>
                <input type="url" id="instagramUrl" name="InstagramUrl" value="@Model.InstagramUrl" placeholder="https://instagram.com/yourpage" />
            </div>
            <div class="form-group">
                <label for="facebookUrl">Facebook URL</label>
                <input type="url" id="facebookUrl" name="FacebookUrl" value="@Model.FacebookUrl" placeholder="https://facebook.com/yourpage" />
            </div>
            <div class="form-group">
                <label for="tiktokUrl">TikTok URL</label>
                <input type="url" id="tiktokUrl" name="TikTokUrl" value="@Model.TikTokUrl" placeholder="https://tiktok.com/@@yourpage" />
            </div>
        </div>

        <button type="submit" class="btn-primary">Save Settings</button>
    </form>
</div>