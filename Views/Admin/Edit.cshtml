@model ShoppingApp.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}

<section class="section">
    <h1 class="section-title">✏ Edit Product</h1>
    <div class="form-card">
        <form method="post" action="/Admin/Edit/@Model.Id" enctype="multipart/form-data" class="admin-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="form-grid-2">
                <div class="form-group">
                    <label>Product Name *</label>
                    <input type="text" name="Name" value="@Model.Name" required />
                </div>
                <div class="form-group">
                    <label>Brand</label>
                    <input type="text" name="Brand" value="@Model.Brand" />
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <input type="text" name="Category" value="@Model.Category" list="cats" />
                    <datalist id="cats">
                        <option value="Laptops"/><option value="Phones"/><option value="Audio"/>
                        <option value="Monitors"/><option value="Accessories"/><option value="Storage"/>
                    </datalist>
                </div>
                <div class="form-group">
                    <label>Price (PKR) *</label>
                    <input type="number" name="Price" value="@Model.Price" required min="0" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Discount (%)</label>
                    <input type="number" name="Discount" value="@Model.Discount" min="0" max="100" />
                </div>
                <div class="form-group">
                    <label>Stock</label>
                    <input type="number" name="Stock" value="@Model.Stock" min="0" />
                </div>
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea name="Description" rows="3">@Model.Description</textarea>
            </div>
            <div class="form-group">
                <label>Current Image</label>
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" style="height:80px;border-radius:8px;margin-bottom:0.5rem;" onerror="this.style.display='none'" />
                }
                <input type="file" name="imageFile" accept="image/*" />
            </div>
            <div style="display:flex;gap:1rem;">
                <button type="submit" class="btn-primary">Update Product</button>
                <a href="/Admin/Products" class="btn-glass">Cancel</a>
            </div>
        </form>
    </div>
</section>
