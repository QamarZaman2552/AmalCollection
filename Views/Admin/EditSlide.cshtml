@model ShoppingApp.Models.HeroSlide
@using ShoppingApp.Models
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin – Edit Hero Slide";
    ViewData["SidebarActive"] = "slides";
    var products = ViewBag.Products as List<Product> ?? new List<Product>();
}

<div class="admin-header">
    <h1 class="section-title"><i class="bi bi-pencil"></i> Edit Hero Slide #@Model.Id</h1>
    <a href="/Admin/HeroSlides" class="btn-glass">← Back to Slides</a>
</div>

<div class="form-card">
    <form method="post" action="/Admin/EditSlide" enctype="multipart/form-data" class="admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="form-grid-2">
            <div class="form-group">
                <label>Tagline <small>(small text above title)</small></label>
                <input name="Tagline" value="@Model.Tagline" placeholder="e.g. FRESH FABRICS FOR EVERY SEASON" />
            </div>
            <div class="form-group">
                <label>Title <small>(big bold name)</small></label>
                <input name="Title" value="@Model.Title" placeholder="e.g. SUMMER LAWN SUITS" />
            </div>
            <div class="form-group">
                <label>Category Label</label>
                <input name="CategoryLabel" value="@Model.CategoryLabel" placeholder="e.g. SUMMER COLLECTION" />
            </div>
            <div class="form-group">
                <label>Hashtag <small>(optional)</small></label>
                <input name="Hashtag" value="@Model.Hashtag" placeholder="e.g. #StayCool" />
            </div>
            <div class="form-group">
                <label>Link URL <small>(Shop Now button)</small></label>
                <input name="LinkUrl" value="@Model.LinkUrl" placeholder="e.g. /?season=Summer" />
            </div>
            <div class="form-group">
                <label>Sort Order <small>(0 = first)</small></label>
                <input name="SortOrder" type="number" value="@Model.SortOrder" />
            </div>
            <div class="form-group">
                <label><i class="bi bi-link-45deg"></i> Linked Product <small>(Shop Now button adds this to cart)</small></label>
                <select name="ProductId" id="productSelect" class="product-select" size="6" onchange="autoFillPrice(this)">
                    <option value="">— No product linked (use Link URL instead) —</option>
                    @foreach (var p in products)
                    {
                        if (p.Id == Model.ProductId)
                        {
                            <option value="@p.Id" data-price="@p.FinalPrice" selected>@p.Name — PKR @p.FinalPrice.ToString("N0")</option>
                        }
                        else
                        {
                            <option value="@p.Id" data-price="@p.FinalPrice">@p.Name — PKR @p.FinalPrice.ToString("N0")</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label><i class="bi bi-cash-stack"></i> Display Price on Slide <small>(optional, leave 0 to hide)</small></label>
                <input name="DisplayPrice" id="displayPrice" type="number" step="0.01"
                       value="@(Model.DisplayPrice.HasValue ? Model.DisplayPrice.Value.ToString("F2") : "")" placeholder="e.g. 29999" />
            </div>
        </div>

        <div class="form-group">
            <label>Hero Background Image <small>(leave empty to keep current)</small></label>
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div style="margin-bottom:0.75rem;">
                    <p style="font-size:0.8rem;color:var(--text-3);margin-bottom:0.4rem;">Current image:</p>
                    <img src="@Model.ImagePath" onerror="this.src='/images/placeholder.jpg'"
                         style="max-height:140px;width:100%;object-fit:cover;border-radius:8px;border:1px solid var(--border);" />
                </div>
            }
            <div class="slide-upload-zone" id="uploadZone">
                <div class="upload-icon"><i class="bi bi-camera"></i></div>
                <div class="upload-text">Click to select or drag & drop new image</div>
                <div class="upload-hint">1440×500px recommended · JPG / PNG / WebP</div>
                <input type="file" name="imageFile" id="imageFile" accept="image/*" style="display:none" />
            </div>
            <div id="imgPreviewWrap" style="display:none;margin-top:0.75rem;">
                <img id="imgPreview" style="max-height:140px;border-radius:8px;border:1px solid var(--border);width:100%;object-fit:cover;" />
                <p id="imgPreviewName" style="font-size:0.8rem;color:var(--text-3);margin-top:0.4rem;"></p>
            </div>
        </div>

        <div class="form-group" style="flex-direction:row;align-items:center;gap:0.75rem;">
            <input type="checkbox" name="IsActive" id="isActive" value="true"
                   @(Model.IsActive ? "checked" : "")
                   style="width:18px;height:18px;accent-color:var(--accent);" />
            <input type="hidden" name="IsActive" value="false" />
            <label for="isActive" style="color:var(--text);font-size:0.9rem;cursor:pointer;">Active (show on homepage)</label>
        </div>

        <div style="display:flex;gap:1rem;margin-top:0.5rem;">
            <button type="submit" class="btn-primary"><i class="bi bi-floppy"></i> Update Slide</button>
            <a href="/Admin/HeroSlides" class="btn-glass">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    // ── Auto-fill price when a product is selected ────────
    function autoFillPrice(sel) {
        const opt = sel.options[sel.selectedIndex];
        const price = opt ? opt.getAttribute('data-price') : '';
        const priceInput = document.getElementById('displayPrice');
        if (price && priceInput) {
            priceInput.value = parseFloat(price).toFixed(2);
        }
    }

    var zone    = document.getElementById('uploadZone');
    var input   = document.getElementById('imageFile');
    var preview = document.getElementById('imgPreview');
    var preWrap = document.getElementById('imgPreviewWrap');
    var preName = document.getElementById('imgPreviewName');

    zone.addEventListener('click', () => input.click());
    zone.addEventListener('dragover', e => { e.preventDefault(); zone.style.borderColor = 'var(--accent-2)'; });
    zone.addEventListener('dragleave', () => { zone.style.borderColor = ''; });
    zone.addEventListener('drop', e => {
        e.preventDefault();
        zone.style.borderColor = '';
        if (e.dataTransfer.files[0]) loadFile(e.dataTransfer.files[0]);
    });
    input.addEventListener('change', () => { if (input.files[0]) loadFile(input.files[0]); });

    function loadFile(file) {
        const dt = new DataTransfer();
        dt.items.add(file);
        input.files = dt.files;
        const reader = new FileReader();
        reader.onload = e => {
            preview.src = e.target.result;
            preName.textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
            preWrap.style.display = 'block';
            zone.querySelector('.upload-text').textContent = 'New image selected – click to change';
        };
        reader.readAsDataURL(file);
    }
</script>
}