@model ShoppingApp.Models.PromotionalCard
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin – Edit Promo Card";
    ViewData["SidebarActive"] = "promo";
}

<div class="admin-header">
    <h1 class="section-title"><i class="bi bi-pencil"></i> Edit Promo Card #@Model.Id</h1>
    <a href="/Admin/PromoCards" class="btn-glass"><i class="bi bi-arrow-left"></i> Back to Promo Cards</a>
</div>

<style>
    .img-remove-btn { position:absolute; top:8px; right:8px; width:30px; height:30px; border:none; border-radius:50%; background:rgba(28,27,25,.75); color:#fff; display:grid; place-items:center; cursor:pointer; z-index:5; transition:background .2s ease; padding:0; }
    .img-remove-btn:hover { background:#c0392b; }
    .img-remove-btn i { font-size:.9rem; }
</style>

<div class="form-card">
    <form method="post" action="/Admin/EditPromo" enctype="multipart/form-data" class="admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="form-grid-2">
            <div class="form-group">
                <label>Brand Name</label>
                <input name="BrandName" value="@Model.BrandName" maxlength="100" />
            </div>
            <div class="form-group">
                <label>Discount %</label>
                <input name="DiscountPercent" type="number" value="@Model.DiscountPercent" />
            </div>
            <div class="form-group">
                <label>Current Price (Rs.)</label>
                <input name="CurrentPrice" type="number" step="0.01" value="@Model.CurrentPrice" />
            </div>
            <div class="form-group">
                <label>Original Price (Rs.)</label>
                <input name="OriginalPrice" type="number" step="0.01" value="@Model.OriginalPrice" />
            </div>
            <div class="form-group">
                <label>Available On Text</label>
                <input name="AvailableOnText" value="@Model.AvailableOnText" maxlength="100" />
            </div>
            <div class="form-group">
                <label>Platform Name</label>
                <input name="PlatformName" value="@Model.PlatformName" maxlength="100" />
            </div>
            <div class="form-group">
                <label>Sort Order</label>
                <input name="SortOrder" type="number" value="@Model.SortOrder" />
            </div>
            <div class="form-group">
                <label>Background Color</label>
                <input name="BackgroundColor" type="color" value="@(string.IsNullOrEmpty(Model.BackgroundColor) ? "#7B4F52" : Model.BackgroundColor)"
                       style="width:100%;height:42px;padding:2px;border:1px solid var(--border);border-radius:8px;background:var(--bg-2);cursor:pointer;" />
            </div>
            <div class="form-group">
                <label>Link Product <small>(optional — tap se product khulega)</small></label>
                <select name="ProductId">
                    <option value="">— No product link —</option>
                    @foreach (var p in ViewBag.PromoProducts)
                    {
                        if (Model.ProductId.HasValue && Model.ProductId.Value.ToString() == (string)p.Value)
                        {
                            <option value="@p.Value" selected>@p.Text</option>
                        }
                        else
                        {
                            <option value="@p.Value">@p.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Link Category <small>(optional — dono ho to product link chalega)</small></label>
                <select name="CategoryName">
                    <option value="">— No category link —</option>
                    @foreach (var c in ViewBag.PromoCategories)
                    {
                        if (Model.CategoryName == (string)c)
                        {
                            <option value="@c" selected>@c</option>
                        }
                        else
                        {
                            <option value="@c">@c</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="form-group">
            <label>Product Image <small>(leave empty to keep current)</small></label>
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div style="margin-bottom:0.75rem;">
                    <p style="font-size:0.8rem;color:var(--text-3);margin-bottom:0.4rem;">Current image:</p>
                    <div id="currentImgWrap" style="position:relative;max-width:340px;">
                        <img src="@Model.ImagePath" onerror="this.src='/images/placeholder.jpg'"
                             style="max-height:200px;width:100%;object-fit:contain;background:#fff;border:1px solid var(--border);border-radius:8px;display:block;" />
                        <button type="button" class="img-remove-btn" onclick="removeCurrent('currentImgWrap','removeImageFlag')" title="Remove current image">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
            }
            <input type="hidden" name="removeImage" id="removeImageFlag" value="false" />
            <div class="slide-upload-zone" id="uploadZone">
                <div class="upload-icon"><i class="bi bi-camera"></i></div>
                <div class="upload-text">Click to select or drag &amp; drop new image</div>
                <div class="upload-hint">JPG / PNG / WebP</div>
                <input type="file" name="imageFile" id="imageFile" accept="image/*" style="display:none" />
            </div>
            <div id="imgPreviewWrap" style="display:none;margin-top:0.75rem;">
                <img id="imgPreview" style="max-height:200px;border-radius:8px;border:1px solid var(--border);width:100%;object-fit:contain;background:#fff;" />
                <p id="imgPreviewName" style="font-size:0.8rem;color:var(--text-3);margin-top:0.4rem;"></p>
            </div>
        </div>

        <div class="form-group">
            <label>Platform Logo <small>(leave empty to keep current)</small></label>
            @if (!string.IsNullOrEmpty(Model.LogoPath))
            {
                <div style="margin-bottom:0.75rem;">
                    <p style="font-size:0.8rem;color:var(--text-3);margin-bottom:0.4rem;">Current logo:</p>
                    <div id="currentLogoWrap" style="position:relative;display:inline-block;">
                        <img src="@Model.LogoPath" style="max-height:60px;background:#fff;padding:6px;border:1px solid var(--border);border-radius:8px;display:block;" />
                        <button type="button" class="img-remove-btn" onclick="removeCurrent('currentLogoWrap','removeLogoFlag')" title="Remove current logo">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
            }
            <input type="hidden" name="removeLogo" id="removeLogoFlag" value="false" />
            <div class="slide-upload-zone" id="logoZone">
                <div class="upload-icon"><i class="bi bi-badge-tm"></i></div>
                <div class="upload-text">Click to select or drag &amp; drop new logo</div>
                <div class="upload-hint">PNG with transparency preferred</div>
                <input type="file" name="logoFile" id="logoFile" accept="image/*" style="display:none" />
            </div>
            <div id="logoPreviewWrap" style="display:none;margin-top:0.75rem;">
                <img id="logoPreview" style="max-height:80px;border-radius:8px;border:1px solid var(--border);background:#fff;padding:6px;" />
                <p id="logoPreviewName" style="font-size:0.8rem;color:var(--text-3);margin-top:0.4rem;"></p>
            </div>
        </div>

        <div class="form-group" style="flex-direction:row;align-items:center;gap:0.75rem;">
            <input type="checkbox" name="IsActive" id="isActive" value="true"
                   @(Model.IsActive ? "checked" : "")
                   style="width:18px;height:18px;accent-color:var(--accent);" />
            <input type="hidden" name="IsActive" value="false" />
            <label for="isActive" style="color:var(--text);font-size:0.9rem;cursor:pointer;">Active (show on homepage deck)</label>
        </div>

        <div style="display:flex;gap:1rem;margin-top:0.5rem;">
            <button type="submit" class="btn-primary"><i class="bi bi-floppy"></i> Update Card</button>
            <a href="/Admin/PromoCards" class="btn-glass">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function wireUpload(zoneId, inputId, wrapId, imgId, nameId) {
        const zone = document.getElementById(zoneId);
        const input = document.getElementById(inputId);
        const wrap = document.getElementById(wrapId);
        const img = document.getElementById(imgId);
        const name = document.getElementById(nameId);
        if (!zone || !input) return;

        zone.addEventListener('click', () => input.click());
        zone.addEventListener('dragover', e => { e.preventDefault(); zone.style.borderColor = 'var(--accent-2)'; });
        zone.addEventListener('dragleave', () => { zone.style.borderColor = ''; });
        zone.addEventListener('drop', e => {
            e.preventDefault();
            zone.style.borderColor = '';
            if (e.dataTransfer.files[0]) loadFile(e.dataTransfer.files[0]);
        });
        input.addEventListener('change', () => { if (input.files[0]) loadFile(input.files[0]); });

        function loadFile(file) {
            const dt = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            const reader = new FileReader();
            reader.onload = e => {
                img.src = e.target.result;
                name.textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
                wrap.style.display = 'block';
                zone.querySelector('.upload-text').textContent = 'New file selected – click to change';
            };
            reader.readAsDataURL(file);
        }
    }
    wireUpload('uploadZone', 'imageFile', 'imgPreviewWrap', 'imgPreview', 'imgPreviewName');
    wireUpload('logoZone', 'logoFile', 'logoPreviewWrap', 'logoPreview', 'logoPreviewName');

    // Cross on current image/logo — hide preview + flag for removal on save
    function removeCurrent(wrapId, flagId) {
        const w = document.getElementById(wrapId);
        if (w) w.style.display = 'none';
        const f = document.getElementById(flagId);
        if (f) f.value = 'true';
    }
</script>
}
