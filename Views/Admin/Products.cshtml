@model List<ShoppingApp.Models.Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin – Products";
    ViewData["SidebarActive"] = "products";
}

<div class="admin-header">
    <h1 class="section-title"><i class="bi bi-box"></i> Product Management</h1>
    <div class="admin-header-actions">
        <a href="/Admin/Analytics"  class="btn-glass"><i class="bi bi-graph-up"></i> Analytics</a>
        <a href="/Admin/Orders"      class="btn-glass"><i class="bi bi-truck"></i> Orders</a>
        <a href="/Admin/HeroSlides"  class="btn-glass"><i class="bi bi-image"></i> Hero Slides</a>
        <a href="/Admin/ChatLogs"    class="btn-glass"><i class="bi bi-journal-text"></i> Chat Logs</a>
        <a href="/Admin/Add"         class="btn-primary">+ Add Product</a>
    </div>
</div>

@{
    var lowStock = ViewBag.LowStock as System.Collections.Generic.List<ShoppingApp.Models.Product>;
    var lowStockOut = lowStock?.Count(p => p.Stock <= 0) ?? 0;
}
@if (lowStock != null && lowStock.Count > 0)
{
    <section class="low-stock-panel" aria-labelledby="lowStockHeading">
        <div class="low-stock-panel__head">
            <div>
                <h2 class="low-stock-panel__title" id="lowStockHeading">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    Low stock
                </h2>
                <p class="low-stock-panel__sub">
                    @lowStock.Count product@(lowStock.Count == 1 ? "" : "s") at 5 units or fewer@(lowStockOut > 0 ? $" — {lowStockOut} already out of stock" : "").
                </p>
            </div>
            <a class="low-stock-more" href="#productsTable" data-noajax>View all products</a>
        </div>
        <div class="low-stock-chips">
            @foreach (var p in lowStock.Take(6))
            {
                <a class="low-stock-chip @(p.Stock <= 0 ? "is-out" : "")" href="/Admin/Edit/@p.Id">
                    <span class="low-stock-chip__name">@p.Name</span>
                    <span class="low-stock-chip__qty">@(p.Stock <= 0 ? "Out of stock" : $"{p.Stock} left")</span>
                </a>
            }
            @if (lowStock.Count > 6)
            {
                <a class="low-stock-more" href="#productsTable" data-noajax>+@(lowStock.Count - 6) more</a>
            }
        </div>
    </section>
}

<div class="admin-table-wrap" id="productsTable">
    <table class="admin-table">
        <caption class="visually-hidden">Products</caption>
        <thead>
            <tr>
                <th scope="col">Image</th><th scope="col">Name</th><th scope="col">Category</th><th scope="col">Brand</th>
                <th scope="col">Price (PKR)</th><th scope="col">Discount</th><th scope="col">Stock</th><th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><img src="@(p.ImagePath ?? "/images/placeholder.jpg")" alt="@p.Name" class="admin-thumb" onerror="this.src='/images/placeholder.jpg'" /></td>
                    <td><strong>@p.Name</strong></td>
                    <td>@p.Category</td>
                    <td>@p.Brand</td>
                    <td>@p.Price.ToString("N0")</td>
                    <td>@p.Discount%</td>
                    <td class="@(p.Stock < 5 ? "stock-low" : "")">@p.Stock</td>
                    <td class="admin-actions">
                        <a href="/Admin/Edit/@p.Id" class="btn-edit" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                        <form method="post" action="/Admin/Delete/@p.Id" style="display:inline" data-submit-guard data-guard-quiet
                              onsubmit="return confirm('Delete @p.Name?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-remove" title="Delete" aria-label="Delete"><i class="bi bi-trash3"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>