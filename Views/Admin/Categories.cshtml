@model List<ShoppingApp.Models.Category>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin – Categories";
    ViewData["SidebarActive"] = "categories";
}

<div class="admin-header">
    <h1 class="section-title"><i class="bi bi-folder"></i> Categories</h1>
    <div class="admin-header-actions">
        <a href="/Admin/Products" class="btn-glass">Products</a>
        <a href="/Admin/Settings" class="btn-glass">Settings</a>
    </div>
</div>

<div class="form-card" style="margin-bottom:1.5rem;">
    <h3 style="margin-bottom:1rem;font-size:1rem;">Add Category</h3>
    <form method="post" action="/Admin/AddCategory" class="admin-form">
        @Html.AntiForgeryToken()
        <div class="form-grid-2">
            <div class="form-group">
                <label>Name *</label>
                <input type="text" name="name" required placeholder="e.g. Summer Suit" />
            </div>
            <div class="form-group">
                <label>Sort Order</label>
                <input type="number" name="sortOrder" value="0" min="0" />
            </div>
        </div>
        <button type="submit" class="btn-primary">Add Category</button>
    </form>
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Sort</th>
                <th>Status</th>
                <th>Products</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>
                        <form method="post" action="/Admin/EditCategory/@c.Id" class="admin-form" style="display:flex;gap:0.5rem;align-items:center;">
                            @Html.AntiForgeryToken()
                            <input type="text" name="name" value="@c.Name" style="max-width:180px;" />
                            <input type="number" name="sortOrder" value="@c.SortOrder" style="width:60px;" />
                            <label style="display:flex;gap:0.3rem;align-items:center;font-size:0.8rem;">
                                <input type="checkbox" name="isActive" value="true" checked="@c.IsActive" style="width:auto;" />
                                <input type="hidden" name="isActive" value="false" /> Active
                            </label>
                            <button type="submit" class="btn-edit" title="Save" aria-label="Save"><i class="bi bi-check-lg"></i></button>
                        </form>
                    </td>
                    <td>@c.SortOrder</td>
                    <td>
                        @if (c.IsActive)
                        {
                            <span style="color:var(--green);font-weight:600;">ACTIVE</span>
                        }
                        else
                        {
                            <span style="color:var(--red);font-weight:600;">INACTIVE</span>
                        }
                    </td>
                    <td>@(ViewBag.ProductCounts != null && ViewBag.ProductCounts.ContainsKey(c.Name) ? ViewBag.ProductCounts[c.Name] : 0)</td>
                    <td class="admin-actions">
                        <form method="post" action="/Admin/DeleteCategory/@c.Id" onsubmit="return confirm('Delete this category? Products using it will have category cleared.')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-remove" title="Delete" aria-label="Delete"><i class="bi bi-trash3"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>