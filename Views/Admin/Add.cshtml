@model ShoppingApp.Models.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Product";
    ViewData["SidebarActive"] = "add";
    var categories = ViewBag.Categories as List<ShoppingApp.Models.Category> ?? new List<ShoppingApp.Models.Category>();
    var allSizes = new[] { "XS", "S", "M", "L", "XL", "XXL", "Unstitched" };
}

<h1 class="section-title"><i class="bi bi-plus-circle"></i> Add New Product</h1>
<div class="form-card">
    <form method="post" action="/Admin/Add" enctype="multipart/form-data" class="admin-form" data-submit-guard data-guard-label="Saving product…">
        @Html.AntiForgeryToken()

        <div class="form-grid-2">
            <div class="form-section-title"><i class="bi bi-info-circle"></i> Basic Information</div>
            <div class="form-group">
                <label for="prodName">Product Name *</label>
                <input type="text" id="prodName" name="Name" required placeholder="e.g. Printed Lawn 3-Piece Suit" />
            </div>
            <div class="form-group">
                <label for="prodCategory">Category</label>
                <select id="prodCategory" name="Category">
                    <option value="">Select category</option>
                    @foreach (var c in categories.Where(x => x.IsActive))
                    {
                        <option value="@c.Name">@c.Name</option>
                    }
                </select>
                <div style="margin-top:0.4rem;">
                    <a href="/Admin/Categories" style="font-size:0.8rem;color:var(--gold-ink);">+ Manage categories</a>
                </div>
            </div>
            <div class="form-group">
                <label for="prodSeason">Season</label>
                <select id="prodSeason" name="Season">
                    <option value="">—</option>
                    <option value="Summer">Summer</option>
                    <option value="Winter">Winter</option>
                </select>
            </div>
            <div class="form-group">
                <label for="prodFabric">Fabric</label>
                <select id="prodFabric" name="Fabric">
                    <option value="">—</option>
                    <option>Lawn</option>
                    <option>Cotton</option>
                    <option>Chiffon</option>
                    <option>Khaddar</option>
                    <option>Wool</option>
                    <option>Cambric</option>
                    <option>Jacquard</option>
                </select>
            </div>
            <div class="form-group">
                <label for="prodStitchedType">Stitched / Unstitched</label>
                <select id="prodStitchedType" name="StitchedType">
                    <option value="">—</option>
                    <option value="Stitched">Stitched</option>
                    <option value="Semi-Stitched">Semi-Stitched</option>
                    <option value="Unstitched">Unstitched</option>
                </select>
            </div>
            <div class="form-group">
                <label for="prodPieces">Pieces (2 / 3)</label>
                <input type="number" id="prodPieces" name="Pieces" min="1" max="5" placeholder="e.g. 3" />
            </div>

            <div class="form-section-title"><i class="bi bi-cash-coin"></i> Pricing &amp; Stock</div>
            <div class="form-group">
                <label for="prodPrice">Price (PKR) *</label>
                <input type="number" id="prodPrice" name="Price" required min="0" step="0.01" placeholder="e.g. 2499" />
            </div>
            <div class="form-group">
                <label for="prodDiscount">Discount (%)</label>
                <input type="number" id="prodDiscount" name="Discount" min="0" max="100" value="0" />
            </div>
            <div class="form-group">
                <label for="prodStock">Stock *</label>
                <input type="number" id="prodStock" name="Stock" required min="0" value="0" />
            </div>
            <div class="form-group">
                <label for="prodBrand">Brand</label>
                <input type="text" id="prodBrand" name="Brand" value="Amal" placeholder="e.g. Amal" />
            </div>

            <div class="form-section-title"><i class="bi bi-palette"></i> Colors, Sizes &amp; Delivery</div>
            <div class="form-group">
                <label for="prodColors">Colors (comma separated)</label>
                <input type="text" id="prodColors" name="Colors" placeholder="e.g. Sand, Charcoal, White" />
            </div>
            <div class="form-group">
                <label for="prodSizes">Sizes (comma separated)</label>
                <input type="text" id="prodSizes" name="Sizes" placeholder="e.g. XS, S, M, L, XL, XXL" list="sizesList" />
                <datalist id="sizesList">
                    @foreach (var s in allSizes)
                    {
                        <option value="@s" />
                    }
                </datalist>
            </div>
            <div class="form-group" style="grid-column: span 2; display:flex; flex-direction:row; gap:1.5rem; align-items:center; flex-wrap:wrap;">
                <label style="display:flex; gap:0.5rem; align-items:center; white-space:nowrap;">
                    <input type="checkbox" name="IsFreeDelivery" value="true" checked style="width:auto;" />
                    <input type="hidden" name="IsFreeDelivery" value="false" />
                    Free delivery
                </label>
                <div id="deliveryChargeWrap" style="display:none; flex:1; min-width:180px;">
                    <label for="prodDeliveryCharge">Delivery charge (PKR)</label>
                    <input type="number" id="prodDeliveryCharge" name="DeliveryCharge" min="0" step="1" placeholder="e.g. 200" />
                </div>
            </div>
        </div>

        <div class="form-grid-2">
            <div class="form-section-title"><i class="bi bi-image"></i> Description &amp; Images</div>
            <div class="form-group" style="grid-column: span 2;">
                <label for="prodDescription">Description</label>
                <textarea id="prodDescription" name="Description" rows="3" placeholder="Product description…"></textarea>
            </div>
            <div class="form-group" style="grid-column: span 2;">
                <label for="prodImages">Product Images (up to 5)</label>
                <input type="file" id="prodImages" name="imageFiles" accept="image/*" multiple />
                <div style="font-size:0.8rem;color:var(--text-3);margin-top:0.3rem;">First image = cover. Max 5 images.</div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Save Product</button>
            <a href="/Admin/Products" class="btn-glass">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        var freeCb = document.querySelector('input[name="IsFreeDelivery"]');
        var chargeWrap = document.getElementById('deliveryChargeWrap');
        function toggleCharge() {
            if (!freeCb || !chargeWrap) return;
            chargeWrap.style.display = freeCb.checked ? 'none' : 'block';
        }
        freeCb?.addEventListener('change', toggleCharge);
        toggleCharge();
    </script>
}
