@model List<ShoppingApp.Models.User>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin – Users";
    ViewData["SidebarActive"] = "users";
    var currentUserId = Context.Session.GetInt32("UserId");
}

<div class="admin-header">
    <h1 class="section-title"><i class="bi bi-people"></i> Users Management</h1>
    <div class="admin-header-actions">
        <a href="/Admin/Products"   class="btn-glass"><i class="bi bi-gear"></i> Products</a>
        <a href="/Admin/Orders"     class="btn-glass"><i class="bi bi-box"></i> Orders</a>
        <a href="/Admin/Analytics"  class="btn-glass"><i class="bi bi-graph-up"></i> Analytics</a>
        <a href="/Admin/HeroSlides" class="btn-glass"><i class="bi bi-image"></i> Hero Slides</a>
        <a href="/Admin/ChatLogs"   class="btn-glass"><i class="bi bi-journal-text"></i> Chat Logs</a>
        <a href="/Admin/Messages"   class="btn-glass"><i class="bi bi-envelope"></i> Messages</a>
    </div>
</div>

<!-- Summary Stats -->
<div class="orders-stats-row">
    <div class="ostat-card">
        <span class="ostat-num">@Model.Count</span>
        <span class="ostat-label">Total Users</span>
    </div>
    <div class="ostat-card">
        <span class="ostat-num">@Model.Count(u => u.Role == "admin")</span>
        <span class="ostat-label">Admins</span>
    </div>
    <div class="ostat-card">
        <span class="ostat-num">@Model.Count(u => u.Role == "customer")</span>
        <span class="ostat-label">Customers</span>
    </div>
    <div class="ostat-card">
        <span class="ostat-num">@Model.Count(u => u.IsLocked)</span>
        <span class="ostat-label">Inactive</span>
    </div>
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Role</th>
                <th>Joined</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td><strong>#@user.Id</strong></td>
                    <td>@user.FullName</td>
                    <td class="cell-sub">@user.Email</td>
                    <td class="cell-sub">@(user.Phone ?? "—")</td>
                    <td>
                        @if (user.Role == "admin")
                        {
                            <span class="payment-badge" style="background: rgba(128,90,213,0.15); color: var(--accent-2);">ADMIN</span>
                        }
                        else
                        {
                            <span class="payment-badge" style="background: rgba(52,211,153,0.12); color: #34d399;">CUSTOMER</span>
                        }
                    </td>
                    <td class="cell-sub">@user.CreatedAt.AddHours(5).ToString("dd MMM yy")</td>
                    <td>
                        @if (user.IsLocked)
                        {
                            <span class="order-status status-pending">INACTIVE</span>
                        }
                        else
                        {
                            <span class="order-status status-delivered">ACTIVE</span>
                        }
                    </td>
                    <td>
                        @if (currentUserId == user.Id)
                        {
                            <span class="cell-sub">(You)</span>
                        }
                        else
                        {
                            <form method="post" action="/Admin/ToggleUser/@user.Id" onsubmit="return confirm('@(user.IsLocked ? "Activate" : "Deactivate") this user: @user.FullName?');">
                                @Html.AntiForgeryToken()
                                @if (user.IsLocked)
                                {
                                    <button type="submit" class="btn-save-status" style="background:#34d399;"><i class="bi bi-check2"></i> Activate</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn-save-status" style="background:#ff6b6b;"><i class="bi bi-x-lg"></i> Deactivate</button>
                                }
                            </form>
                            <form method="post" action="/Admin/DeleteUser/@user.Id" onsubmit="return confirm('PERMANENTLY delete @user.FullName and ALL their data (orders, cart, reviews)?');" style="margin-top:6px;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-save-status" style="background:#b91c1c; width:100%;"><i class="bi bi-trash3"></i> Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>