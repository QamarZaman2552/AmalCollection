@model List<ShoppingApp.Models.CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
    decimal total = (decimal)(ViewBag.CartTotal ?? Model.Sum(i => (i.Product?.FinalPrice ?? 0) * i.Quantity));
    decimal balance = (decimal)(ViewBag.Balance ?? 0);
    bool canAfford = ViewBag.CanAfford == true;
}

<section class="section">
    <h1 class="section-title">🛒 Your Cart</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">✅ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">⚠️ @TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">🛒</div>
            <p>Your cart is empty!</p>
            <a href="/" class="btn-primary">Start Shopping</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items">
                @foreach (var item in Model)
                {
                    <div class="cart-item">
                        <img src="@(item.Product?.ImagePath ?? "/images/placeholder.jpg")" alt="@item.Product?.Name" onerror="this.src='/images/placeholder.jpg'" class="cart-item-img" />
                        <div class="cart-item-info">
                            <h3>@item.Product?.Name</h3>
                            <div class="cart-item-cat">@item.Product?.Category · @item.Product?.Brand</div>
                            <div class="cart-item-price">PKR @item.Product?.FinalPrice.ToString("N0") each</div>
                        </div>
                        <div class="cart-item-actions">
                            <form method="post" action="/Cart/UpdateQuantity" class="qty-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <input type="number" name="quantity" value="@item.Quantity" min="0" max="@item.Product?.Stock" class="qty-input" onchange="this.form.submit()" />
                            </form>
                            <div class="cart-item-subtotal">PKR @((item.Product!.FinalPrice * item.Quantity).ToString("N0"))</div>
                            <form method="post" action="/Cart/Remove">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <button type="submit" class="btn-remove">✕</button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <div class="cart-summary">
                <h2>Order Summary</h2>
                <div class="summary-row"><span>Items (@Model.Sum(i => i.Quantity))</span><span>PKR @total.ToString("N0")</span></div>
                <div class="summary-row"><span>Your balance</span><span>PKR @balance.ToString("N0")</span></div>
                <div class="summary-row"><span>Delivery</span><span class="text-green">Free</span></div>
                <div class="summary-total"><span>Cart total</span><span>PKR @total.ToString("N0")</span></div>
                @if (!canAfford)
                {
                    var shortfall = total - balance;
                    <div class="alert alert-error" style="margin-top:0.75rem;">
                        Insufficient balance. You need PKR @shortfall.ToString("N0") more to checkout.
                    </div>
                    <div class="topup-box" style="margin-top:1rem;padding:1rem;background:var(--bg-3);border:1px solid var(--border);border-radius:var(--radius-sm);">
                        <h3 style="font-size:0.95rem;margin-bottom:0.75rem;">💳 Add balance to your account</h3>
                        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.75rem;">
                             <form method="post" action="/Profile/TopUp" style="display:inline;">
                                 @Html.AntiForgeryToken()
                                 <input type="hidden" name="returnUrl" value="/Cart" />
                                 <input type="hidden" name="amount" value="@((int)Math.Ceiling(shortfall))" />
                                 <button type="submit" class="btn-glass" style="font-size:0.8rem;padding:0.4rem 0.75rem;">+ PKR @shortfall.ToString("N0") (exact)</button>
                             </form>
                             <form method="post" action="/Profile/TopUp" style="display:inline;">
                                 @Html.AntiForgeryToken()
                                 <input type="hidden" name="returnUrl" value="/Cart" />
                                 <input type="hidden" name="amount" value="50000" />
                                 <button type="submit" class="btn-glass" style="font-size:0.8rem;padding:0.4rem 0.75rem;">+ 50,000</button>
                             </form>
                             <form method="post" action="/Profile/TopUp" style="display:inline;">
                                 @Html.AntiForgeryToken()
                                 <input type="hidden" name="returnUrl" value="/Cart" />
                                 <input type="hidden" name="amount" value="100000" />
                                 <button type="submit" class="btn-glass" style="font-size:0.8rem;padding:0.4rem 0.75rem;">+ 100,000</button>
                             </form>
                        </div>
                         <form method="post" action="/Profile/TopUp" class="topup-form">
                             @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="/Cart" />
                            <div class="form-group" style="margin-bottom:0.75rem;">
                                <label style="font-size:0.82rem;">Or enter custom amount (PKR)</label>
                                <input type="number" name="amount" min="1" step="1" value="@((int)Math.Ceiling(shortfall))" required />
                            </div>
                            <button type="submit" class="btn-primary btn-full">Add Balance →</button>
                        </form>
                        <p style="font-size:0.75rem;color:var(--text-3);margin-top:0.6rem;">Simulated wallet top-up for demo checkout.</p>
                    </div>
                }
                @if (canAfford)
                {
                    <a href="/Orders/Checkout" class="btn-primary btn-full">Proceed to Checkout →</a>
                }
                else
                {
                    <button type="button" class="btn-primary btn-full" disabled title="Add balance first — cart total must be ≤ your balance">Proceed to Checkout →</button>
                }
                <a href="/" class="btn-glass btn-full" style="margin-top:0.5rem;">Continue Shopping</a>
            </div>
        </div>
    }
</section>
