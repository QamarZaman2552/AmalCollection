@model List<ShoppingApp.Models.CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
    decimal total = (decimal)(ViewBag.CartTotal ?? Model.Sum(i => (i.Product?.FinalPrice ?? 0) * i.Quantity));
    decimal delivery = (decimal)(ViewBag.DeliveryCharge ?? 0m);
    decimal grand = (decimal)(ViewBag.GrandTotal ?? (total + delivery));
    decimal freeThreshold = (decimal)(ViewBag.FreeDeliveryThreshold ?? 0m);
    decimal savings = (decimal)(ViewBag.CartSavings ?? 0m);
    bool showFreeProgress = freeThreshold > 0 && (delivery > 0 || total >= freeThreshold);
    bool freeQualified = freeThreshold > 0 && total >= freeThreshold;
    decimal freeRemaining = freeThreshold > total ? freeThreshold - total : 0m;
    int freePct = freeThreshold > 0 ? (int)Math.Min(100m, Math.Round(total / freeThreshold * 100m)) : 0;
    var recommendations = ViewBag.Recommendations as List<ShoppingApp.Models.Product> ?? new List<ShoppingApp.Models.Product>();
}

<section class="section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
            <div>
                <div class="section-kicker">Your Bag</div>
                <h1 class="section-title">Shopping Cart</h1>
            </div>
            <a href="/" class="link-more">Continue Shopping <i class="bi bi-arrow-right"></i></a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">@TempData["Error"]</div>
        }

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon" style="font-size:2.5rem;color:var(--gold);"><i class="bi bi-bag-x"></i></div>
                <p>Add some beautiful suits to get started.</p>
                <a href="/" class="btn btn-gold">Start Shopping</a>
            </div>

            @if (recommendations.Any())
            {
                <div class="empty-recos">
                    <div class="section-kicker text-center">Popular Right Now</div>
                    <h2 class="section-title text-center mb-4">You May Also Like</h2>
                    @await Html.PartialAsync("_ProductGridCompact", recommendations)
                </div>
            }
        }
        else
        {
            @await Html.PartialAsync("_CheckoutSteps", 1)
            <div class="cart-layout">
                <div class="cart-items">
                    @foreach (var item in Model)
                    {
                        <div class="cart-item">
                            <img src="@(item.Product?.ImagePath ?? "/images/placeholder.jpg")" alt="@item.Product?.Name" loading="lazy" decoding="async" onerror="this.src='/images/placeholder.jpg'" class="cart-item-img" />
                            <div class="cart-item-info">
                                <h3>@item.Product?.Name</h3>
                                <div class="cart-item-cat">@item.Product?.Category · @item.Product?.Fabric</div>
                                @if (!string.IsNullOrEmpty(item.Size) || !string.IsNullOrEmpty(item.Color))
                                {
                                    <div class="cart-item-cat">
                                        @if (!string.IsNullOrEmpty(item.Size)) { <span>Size: @item.Size</span> }
                                        @if (!string.IsNullOrEmpty(item.Size) && !string.IsNullOrEmpty(item.Color)) { <span> · </span> }
                                        @if (!string.IsNullOrEmpty(item.Color)) { <span>Color: @item.Color</span> }
                                    </div>
                                }
                                <div class="cart-item-price">
                                    PKR @item.Product?.FinalPrice.ToString("N0") each
                                    @if (item.Product is { Discount: > 0 })
                                    {
                                        <s class="cart-item-was">PKR @item.Product.Price.ToString("N0")</s>
                                    }
                                </div>
                            </div>
                            <div class="cart-item-actions">
                                <form method="post" action="/Cart/UpdateQuantity" class="qty-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="0" max="@item.Product?.Stock" class="qty-input" onchange="this.form.requestSubmit()" />
                                </form>
                                <div class="cart-item-subtotal">PKR @((item.Product!.FinalPrice * item.Quantity).ToString("N0"))</div>
                                <form method="post" action="/Cart/Remove">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                    <button type="submit" class="btn-remove" aria-label="Remove"><i class="bi bi-x-lg"></i></button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

                <div class="cart-summary">
                    <h2>Order Summary</h2>
                    @if (showFreeProgress)
                    {
                        <div class="cart-free @(freeQualified ? "is-qualified" : "")">
                            <div class="cart-free-text">
                                @if (freeQualified)
                                {
                                    <span><i class="bi bi-truck"></i> Free delivery unlocked!</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-truck"></i> Add <strong>PKR @freeRemaining.ToString("N0")</strong> more for free delivery</span>
                                }
                            </div>
                            <div class="cart-free-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@freePct" aria-label="Progress towards free delivery">
                                <span style="width:@freePct%"></span>
                            </div>
                        </div>
                    }
                    @if (savings > 0)
                    {
                        <div class="cart-savings">
                            <i class="bi bi-tag-fill" aria-hidden="true"></i>
                            <span>You save <strong>PKR @savings.ToString("N0")</strong> on this order</span>
                        </div>
                    }
                    <div class="summary-row"><span>Items (@Model.Sum(i => i.Quantity))</span><span>PKR @total.ToString("N0")</span></div>
                    <div class="summary-row">
                        <span>Delivery</span>
                        @if (delivery == 0)
                        {
                            <span class="text-green">Free</span>
                        }
                        else
                        {
                            <span>PKR @delivery.ToString("N0")</span>
                        }
                    </div>
                    <div class="summary-total"><span>Cart total</span><span>PKR @grand.ToString("N0")</span></div>
                    <a href="/Orders/Checkout" class="btn btn-gold w-100 py-2">Proceed to Checkout</a>
                    <a href="/" class="btn btn-outline-dark w-100 py-2 mt-2">Continue Shopping</a>
                    <div class="cart-trust">
                        <span><i class="bi bi-shield-check" aria-hidden="true"></i> Secure checkout</span>
                        <span><i class="bi bi-cash-coin" aria-hidden="true"></i> Cash on delivery</span>
                        <span><i class="bi bi-arrow-repeat" aria-hidden="true"></i> 7-day exchange</span>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

