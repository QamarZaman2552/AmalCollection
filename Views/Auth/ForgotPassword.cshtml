@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo"><span>Amal Collection</span></div>
        <h1 class="auth-title">Reset Password</h1>
        <p class="auth-sub">Enter your email and we'll send you a verification code</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">✅ @TempData["Success"]</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error">⚠️ @ViewBag.Error</div>
        }

        <form method="post" action="/Auth/ForgotPassword" class="auth-form" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="email" />
            </div>
            <button type="submit" class="btn-primary btn-full">Send Verification Code →</button>
        </form>

        <p class="auth-switch">
            Back to <a href="/Auth/Login?returnUrl=@System.Net.WebUtility.UrlEncode(ViewBag.ReturnUrl as string)">Login</a>
        </p>
    </div>
</div>
