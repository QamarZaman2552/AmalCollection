@{
    ViewData["Title"] = "Set New Password";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo"><span>Amal Collection</span></div>
        <h1 class="auth-title">Set New Password</h1>
        <p class="auth-sub">Choose a strong password for your account</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success"><i class="bi bi-check-circle-fill me-1"></i>@TempData["Success"]</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error"><i class="bi bi-exclamation-triangle-fill me-1"></i>@ViewBag.Error</div>
        }

        <form data-noajax method="post" action="/Auth/ResetPassword" class="auth-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="form-group">
                <label for="newPassword">New Password</label>
                <div class="pw-field">
                    <input type="password" id="newPassword" name="newPassword" placeholder="Enter a strong password" required autocomplete="new-password" />
                    <button type="button" class="pw-toggle" aria-label="Show password"><i class="bi bi-eye"></i></button>
                </div>
                <div class="pw-strength" aria-live="polite">
                    <div class="pw-strength-bar"><span></span></div>
                    <div class="pw-strength-label">Password strength</div>
                </div>
                <ul class="pw-reqs">
                    <li data-rule="length">At least 8 characters</li>
                    <li data-rule="lower">A lowercase letter</li>
                    <li data-rule="upper">An uppercase letter</li>
                    <li data-rule="digit">A number</li>
                    <li data-rule="symbol">A symbol (!#$%…)</li>
                </ul>
            </div>
            <div class="form-group">
                <label for="confirmPassword">Confirm New Password</label>
                <div class="pw-field">
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repeat new password" required autocomplete="new-password" data-match="newPassword" />
                    <button type="button" class="pw-toggle" aria-label="Show password"><i class="bi bi-eye"></i></button>
                </div>
                <div class="pw-match"></div>
            </div>
            <button type="submit" class="btn-primary btn-full">Update Password →</button>
        </form>

        <p class="auth-switch">
            Back to <a href="/Auth/Login?returnUrl=@System.Net.WebUtility.UrlEncode(ViewBag.ReturnUrl as string)">Login</a>
        </p>
    </div>
</div>
