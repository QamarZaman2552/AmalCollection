@model ShoppingApp.Models.User
@{
    ViewData["Title"] = "My Profile";
    int    totalOrders   = ViewBag.TotalOrders   ?? 0;
    decimal totalSpent   = ViewBag.TotalSpent    ?? 0m;
    int    wishlistCount = ViewBag.WishlistCount ?? 0;
    int    reviewCount   = ViewBag.ReviewCount   ?? 0;
    string initials      = string.Join("", Model.FullName.Split(' ').Take(2).Select(w => w[0])).ToUpper();
}

<section class="section profile-section">

    <!-- ── Profile Header ── -->
    <div class="profile-hero">
        <div class="profile-avatar-big">@initials</div>
        <div class="profile-hero-info">
            <h1 class="profile-name">@Model.FullName</h1>
            <div class="profile-email"><i class="bi bi-envelope me-1"></i>@Model.Email</div>
            @if (!string.IsNullOrEmpty(Model.Phone))
            {
                <div class="profile-phone"><i class="bi bi-phone me-1"></i>@Model.Phone</div>
            }
            <div class="profile-since"><i class="bi bi-calendar3 me-1"></i>Member since @Model.CreatedAt.ToString("dd MMMM yyyy")</div>
        </div>
    </div>

    <!-- ── Stats ── -->
    @if (Context.Session.GetString("UserRole") != "admin")
    {
        <div class="profile-stats">
            <div class="pstat-card">
                <div class="pstat-icon"><i class="bi bi-box-seam"></i></div>
                <div class="pstat-num">@totalOrders</div>
                <div class="pstat-label">Total Orders</div>
            </div>
            <div class="pstat-card">
                <div class="pstat-icon"><i class="bi bi-cash-coin"></i></div>
                <div class="pstat-num">PKR @totalSpent.ToString("N0")</div>
                <div class="pstat-label">Total Spent</div>
            </div>
            <div class="pstat-card">
                <div class="pstat-icon"><i class="bi bi-heart-fill"></i></div>
                <div class="pstat-num">@wishlistCount</div>
                <div class="pstat-label">Wishlist Items</div>
            </div>
            <div class="pstat-card">
                <div class="pstat-icon"><i class="bi bi-star-fill"></i></div>
                <div class="pstat-num">@reviewCount</div>
                <div class="pstat-label">Reviews Written</div>
            </div>
        </div>
    }

    <!-- ── Quick Links ── -->
    <div class="profile-quick-links">
        @if (Context.Session.GetString("UserRole") != "admin")
        {
            <a href="/Orders/History" class="pquick-link"><i class="bi bi-journal-text me-1"></i>My Orders</a>
            <a href="/Wishlist"       class="pquick-link"><i class="bi bi-heart me-1"></i>Wishlist</a>
            <a href="/Cart"           class="pquick-link"><i class="bi bi-cart3 me-1"></i>Cart</a>
        }
        <a href="/Auth/Logout"    class="pquick-link pquick-danger"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
    </div>

    <!-- ── Edit Profile ── -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle-fill me-1"></i>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error"><i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["Error"]</div>
    }
    <div class="profile-forms-grid">

        <!-- Edit Profile -->
        <div class="profile-form-card">
            <h2 class="profile-form-title"><i class="bi bi-pencil-square me-1"></i>Edit Profile</h2>
            <form method="post" action="/Profile/Update" class="auth-form">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" name="fullName" value="@Model.FullName" required />
                </div>
                <div class="form-group">
                    <label>Phone Number</label>
                    <input type="tel" name="phone" value="@Model.Phone" placeholder="03XX-XXXXXXX" />
                </div>
                <p style="font-size:0.78rem;color:var(--text-3);margin:-0.4rem 0 0.9rem;">
                    <i class="bi bi-shield-lock me-1"></i>Email is changed separately below, with verification.
                </p>
                <button type="submit" class="btn-primary">Save Changes</button>
            </form>
        </div>

        <!-- Change Email (OTP verification to current email) -->
        <div class="profile-form-card">
            <h2 class="profile-form-title"><i class="bi bi-envelope-at me-1"></i>Change Email</h2>
            @if (!string.IsNullOrEmpty(ViewBag.PendingEmail))
            {
                <p style="font-size:0.8rem;color:var(--text-2);margin-bottom:1rem;">
                    A 6-digit verification code was sent to your current email <strong>@Model.Email</strong>.
                    Enter it below to confirm the change to <strong>@ViewBag.PendingEmail</strong>.
                </p>
                <form method="post" action="/Profile/ChangeEmail" class="auth-form">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="ceOtp">Verification Code</label>
                        <input type="text" id="ceOtp" name="otp" placeholder="6-digit code" required
                               pattern="[0-9]{6}" maxlength="6" inputmode="numeric" autocomplete="one-time-code"
                               style="font-size:1.2rem; letter-spacing:6px; text-align:center; font-weight:bold;" />
                    </div>
                    <button type="submit" class="btn-primary">Verify &amp; Change Email</button>
                </form>
                <form method="post" action="/Profile/CancelEmailChange" style="margin-top:0.6rem;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link" style="color:var(--text-3);font-size:0.82rem;">Cancel</button>
                </form>
            }
            else
            {
                <p style="font-size:0.8rem;color:var(--text-2);margin-bottom:1rem;">
                    For your security, a 6-digit verification code will be sent to your current email
                    <strong>@Model.Email</strong> before any change.
                </p>
                <form method="post" action="/Profile/SendEmailChangeOtp" class="auth-form">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="newEmail">New Email</label>
                        <input type="email" id="newEmail" name="newEmail" placeholder="you@example.com" required maxlength="254" />
                    </div>
                    <button type="submit" class="btn-primary">Send Verification Code</button>
                </form>
            }
        </div>

        <!-- Change Password (OTP verification) -->
        <div class="profile-form-card">
            <h2 class="profile-form-title"><i class="bi bi-lock me-1"></i>Change Password</h2>
            <p style="font-size:0.8rem;color:var(--text-2);margin-bottom:1rem;">
                A 6-digit verification code will be sent to <strong>@Model.Email</strong> before changing your password.
            </p>

            @if (TempData["OtpSent"] != null || ViewBag.OtpSent == true)
            {
                <form method="post" action="/Profile/ChangePassword" class="auth-form">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="cpOtp">Verification Code</label>
                        <input type="text" id="cpOtp" name="otp" placeholder="6-digit code" required
                               pattern="[0-9]{6}" maxlength="6" inputmode="numeric" autocomplete="one-time-code"
                               style="font-size:1.2rem; letter-spacing:6px; text-align:center; font-weight:bold;" />
                    </div>
                    <div class="form-group">
                        <label for="cpNewPassword">New Password</label>
                        <div class="pw-field">
                            <input type="password" id="cpNewPassword" name="newPassword" placeholder="Enter a strong password" required autocomplete="new-password" />
                            <button type="button" class="pw-toggle" aria-label="Show password"><i class="bi bi-eye"></i></button>
                        </div>
                        <div class="pw-strength" aria-live="polite">
                            <div class="pw-strength-bar"><span></span></div>
                            <div class="pw-strength-label">Password strength</div>
                        </div>
                        <ul class="pw-reqs">
                            <li data-rule="length">At least 8 characters</li>
                            <li data-rule="lower">A lowercase letter</li>
                            <li data-rule="upper">An uppercase letter</li>
                            <li data-rule="digit">A number</li>
                            <li data-rule="symbol">A symbol (!#$%…)</li>
                        </ul>
                    </div>
                    <div class="form-group">
                        <label for="cpConfirmPassword">Confirm New Password</label>
                        <div class="pw-field">
                            <input type="password" id="cpConfirmPassword" name="confirmPassword" placeholder="Repeat new password" required autocomplete="new-password" data-match="cpNewPassword" />
                            <button type="button" class="pw-toggle" aria-label="Show password"><i class="bi bi-eye"></i></button>
                        </div>
                        <div class="pw-match"></div>
                    </div>
                    <button type="submit" class="btn-primary">Verify & Change Password</button>
                </form>
            }
            else
            {
                <form method="post" action="/Profile/SendPasswordOtp" class="auth-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-primary">Send Verification Code</button>
                </form>
            }
        </div>

    </div>
</section>
