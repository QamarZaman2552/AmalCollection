@model List<ShoppingApp.Models.WishlistItem>
@{
    ViewData["Title"] = "My Wishlist";
}

<section class="section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4 wishlist-header">
            <div>
                <div class="section-kicker">Saved Favourites</div>
                <h1 class="section-title">My Wishlist <span class="badge">@Model.Count items</span></h1>
            </div>
            <a href="/" class="link-more">Continue Shopping <i class="bi bi-arrow-right"></i></a>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon" style="font-size:2.5rem;color:var(--gold);"><i class="bi bi-heart"></i></div>
                <p>Your wishlist is empty! Explore products and save your favourites.</p>
                <a href="/" class="btn btn-gold">Discover Products</a>
            </div>
        }
        else
        {
            <div class="row g-3 g-md-4">
                @foreach (var item in Model)
                {
                    var p = item.Product!;
                    <div class="col-6 col-md-4 col-xl-3">
                        <div class="product-card h-100">
                            <div class="product-media">
                                <a href="/Products/Detail/@p.Id" class="product-media-link">
                                    <img src="@(p.ImagePath ?? "/images/placeholder.jpg")"
                                         alt="@p.Name" onerror="this.src='/images/placeholder.jpg'" />
                                </a>
                                @if (p.Discount > 0)
                                {
                                    <span class="badge-discount">-@p.Discount%</span>
                                }
                                @if (p.Stock == 0)
                                {
                                    <span class="badge-tag" style="background:var(--red);color:#fff;">Out of Stock</span>
                                }
                            </div>
                            <div class="product-info">
                                <div class="product-cat">@p.Season · @p.Category</div>
                                <h3 class="product-name"><a href="/Products/Detail/@p.Id">@p.Name</a></h3>
                                <div class="product-meta">@p.Brand</div>
                                <div class="product-pricing">
                                    <span class="price-final">PKR @p.FinalPrice.ToString("N0")</span>
                                    @if (p.Discount > 0)
                                    {
                                        <span class="price-original">PKR @p.Price.ToString("N0")</span>
                                    }
                                </div>
                                <div class="d-flex gap-2 mt-2">
                                    @if (p.Stock > 0)
                                    {
                                        <form method="post" action="/Wishlist/MoveToCart" style="flex:1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@p.Id" />
                                            <button type="submit" class="btn btn-gold btn-sm w-100">Move to Cart</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-dark btn-sm w-100" disabled>Out of Stock</button>
                                    }
                                    <form method="post" action="/Wishlist/Remove">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@p.Id" />
                                        <button type="submit" class="btn btn-outline-dark btn-sm wishlist-remove" title="Remove"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                                <div class="wishlist-added" style="font-size:0.72rem;color:var(--text-3);margin-top:0.5rem;">Added @item.AddedAt.AddHours(5).ToString("dd MMM yyyy")</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
