@section Scripts {
<script>
// Gallery thumbs
document.querySelectorAll('.pd-thumb').forEach(function (btn) {
    btn.addEventListener('click', function () {
        var src = btn.getAttribute('data-src');
        var main = document.getElementById('mainImage');
        if (main && src) main.src = src;
        document.querySelectorAll('.pd-thumb').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
    });
});

// ─── Image zoom + lightbox ───────────────────────────────
(function () {
    var mainImg = document.getElementById('mainImage');
    var mainBox = document.getElementById('pdMainBox');
    var lb = document.getElementById('pdLightbox');
    if (!mainImg || !mainBox || !lb) return;

    var images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(galleryPaths));
    if (!images || !images.length) images = [mainImg.getAttribute('src')];

    var lbImg = document.getElementById('pdLbImg');
    var lbCount = document.getElementById('pdLbCount');
    var lbPrev = document.getElementById('pdLbPrev');
    var lbNext = document.getElementById('pdLbNext');
    var lbClose = document.getElementById('pdLbClose');
    var idx = 0;
    var lastFocus = null;

    // Hover zoom on desktop pointers only
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        mainBox.classList.add('pd-zoomable');
        mainBox.addEventListener('mousemove', function (e) {
            var r = mainBox.getBoundingClientRect();
            var x = ((e.clientX - r.left) / r.width) * 100;
            var y = ((e.clientY - r.top) / r.height) * 100;
            mainImg.style.transformOrigin = x + '% ' + y + '%';
            mainImg.style.transform = 'scale(1.8)';
        });
        mainBox.addEventListener('mouseleave', function () {
            mainImg.style.transform = '';
            mainImg.style.transformOrigin = 'center center';
        });
    }

    function syncIndex() {
        var i = images.indexOf(mainImg.getAttribute('src'));
        if (i >= 0) idx = i;
    }

    function render() {
        lbImg.src = images[idx];
        lbCount.textContent = images.length > 1 ? (idx + 1) + ' / ' + images.length : '';
        var many = images.length > 1;
        lbPrev.hidden = !many;
        lbNext.hidden = !many;
    }

    function openLightbox() {
        syncIndex();
        render();
        lastFocus = document.activeElement;
        lb.hidden = false;
        document.body.classList.add('pd-lb-open');
        lbClose.focus();
    }

    function closeLightbox() {
        lb.hidden = true;
        document.body.classList.remove('pd-lb-open');
        if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    function step(delta) {
        if (images.length < 2) return;
        idx = (idx + delta + images.length) % images.length;
        render();
    }

    mainBox.addEventListener('click', openLightbox);
    mainBox.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLightbox(); }
    });

    lbClose.addEventListener('click', closeLightbox);
    lbPrev.addEventListener('click', function () { step(-1); });
    lbNext.addEventListener('click', function () { step(1); });
    lb.addEventListener('click', function (e) { if (e.target === lb) closeLightbox(); });
    document.addEventListener('keydown', function (e) {
        if (lb.hidden) return;
        if (e.key === 'Escape') { e.preventDefault(); closeLightbox(); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    });

    // Keep the lightbox in sync when a thumbnail is picked
    document.querySelectorAll('.pd-thumb').forEach(function (btn) {
        btn.addEventListener('click', syncIndex);
    });
})();

// Size select → hidden input
document.querySelectorAll('#sizeOptions .size-opt').forEach(function (btn) {
    btn.addEventListener('click', function () {
        document.querySelectorAll('#sizeOptions .size-opt').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var input = document.getElementById('sizeInput');
        if (input) input.value = btn.dataset.value || btn.textContent.trim();
        clearOptError();
    });
});

// Color select → hidden input + label
document.querySelectorAll('#colorOptions .color-opt').forEach(function (btn) {
    btn.addEventListener('click', function () {
        document.querySelectorAll('#colorOptions .color-opt').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var input = document.getElementById('colorInput');
        if (input) input.value = btn.dataset.name || '';
        var label = document.getElementById('colorLabelName');
        if (label) label.textContent = btn.dataset.name || '';
        clearOptError();
    });
});

// Qty controls
(function () {
    var qty = document.getElementById('qtyInput');
    if (!qty) return;
    var minus = document.getElementById('qtyMinus');
    var plus = document.getElementById('qtyPlus');

    function bump(cls) {
        qty.classList.remove('qty-pulse', 'qty-limit');
        void qty.offsetWidth;
        qty.classList.add(cls);
    }
    qty.addEventListener('animationend', function () {
        qty.classList.remove('qty-pulse', 'qty-limit');
    });

    function step(delta) {
        var max = parseInt(qty.max, 10) || 99;
        var next = (parseInt(qty.value, 10) || 1) + delta;
        if (next < 1) { qty.value = 1; bump('qty-limit'); return; }
        if (next > max) { qty.value = max; bump('qty-limit'); return; }
        qty.value = next;
        bump('qty-pulse');
    }

    if (minus) minus.addEventListener('click', function () { step(-1); });
    if (plus) plus.addEventListener('click', function () { step(1); });
    qty.addEventListener('change', function () { bump('qty-pulse'); });
})();

// Share product (native share → copy link → WhatsApp)
(function () {
    var btn = document.getElementById('pdShare');
    if (!btn) return;
    var icon = btn.querySelector('i');

    function reset() {
        btn.classList.remove('is-copied');
        btn.setAttribute('aria-label', 'Share this product');
        if (icon) icon.className = 'bi bi-share';
    }

    btn.addEventListener('click', async function () {
        var name = btn.dataset.name || document.title;
        var price = btn.dataset.price;
        var url = window.location.href;
        var text = 'Check out ' + name + (price ? ' – PKR ' + price : '') + ' at Amal Collection';

        if (navigator.share) {
            try {
                await navigator.share({ title: name, text: text, url: url });
                return;
            } catch (err) {
                if (err && err.name === 'AbortError') return;
            }
        }

        try {
            await navigator.clipboard.writeText(url);
            btn.classList.add('is-copied');
            btn.setAttribute('aria-label', 'Link copied');
            if (icon) icon.className = 'bi bi-check2';
            setTimeout(reset, 1800);
        } catch (e) {
            window.open('https://wa.me/?text=' + encodeURIComponent(text + ' ' + url), '_blank', 'noopener');
        }
    });
})();

// Require size/color when options exist — inline message, no blocking alert
function showOptError(message, boxId) {
    var err = document.getElementById('optError');
    if (err) { err.textContent = message; err.hidden = false; }
    var box = document.getElementById(boxId);
    if (box) {
        box.classList.remove('pd-flash');
        void box.offsetWidth;
        box.classList.add('pd-flash');
        box.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
}

function clearOptError() {
    var err = document.getElementById('optError');
    if (err) { err.hidden = true; err.textContent = ''; }
}

document.querySelector('.add-cart-form')?.addEventListener('submit', function (e) {
    var sizeOpts = document.querySelectorAll('#sizeOptions .size-opt');
    var colorOpts = document.querySelectorAll('#colorOptions .color-opt');
    if (sizeOpts.length > 0 && !document.querySelector('#sizeOptions .size-opt.active')) {
        e.preventDefault();
        showOptError('Please select a size before adding to cart.', 'sizeOptions');
        return;
    }
    if (colorOpts.length > 0 && !document.querySelector('#colorOptions .color-opt.active')) {
        e.preventDefault();
        showOptError('Please select a color before adding to cart.', 'colorOptions');
        return;
    }
    clearOptError();
});

var ratingLabels = ['','Terrible','Poor','Average','Good','Excellent'];
function setRating(val) {
    document.getElementById('ratingInput').value = val;
    document.getElementById('spHint').textContent = ratingLabels[val];
    document.querySelectorAll('.sp-star').forEach(function (s, idx) {
        s.classList.toggle('active', idx < val);
    });
}
document.querySelectorAll('.sp-star').forEach(function (star, idx) {
    star.addEventListener('mouseenter', function () {
        document.querySelectorAll('.sp-star').forEach(function (s, i) {
            s.classList.toggle('hover', i <= idx);
        });
        document.getElementById('spHint').textContent = ratingLabels[idx + 1];
    });
    star.addEventListener('mouseleave', function () {
        document.querySelectorAll('.sp-star').forEach(function (s) { s.classList.remove('hover'); });
        var current = parseInt(document.getElementById('ratingInput').value);
        document.getElementById('spHint').textContent = current > 0 ? ratingLabels[current] : 'Click a star';
    });
});
document.getElementById('reviewForm')?.addEventListener('submit', function (e) {
    var rating = parseInt(document.getElementById('ratingInput').value);
    if (!rating || rating < 1) {
        e.preventDefault();
        document.getElementById('spHint').textContent = 'Please select a rating!';
        document.getElementById('spHint').style.color = 'var(--red)';
    }
});

// ─── Sticky mobile add-to-cart bar ───────────────────────
(function () {
    var bar = document.getElementById('pdpStickyBar');
    var form = document.querySelector('.add-cart-form');
    if (!bar || !form || !('IntersectionObserver' in window)) return;

    var shown = false;
    function show(on) {
        if (on === shown) return;
        shown = on;
        bar.classList.toggle('show', on);
        bar.setAttribute('aria-hidden', on ? 'false' : 'true');
        document.body.classList.toggle('pdp-sticky-on', on);
    }
    var io = new IntersectionObserver(function (entries) {
        var e = entries[0];
        // Show only after the form has been scrolled past (above the viewport)
        show(!e.isIntersecting && e.boundingClientRect.top < 0);
    }, { threshold: 0 });
    io.observe(form);

    function missingOption() {
        var sizes = document.querySelectorAll('#sizeOptions .size-opt');
        var colors = document.querySelectorAll('#colorOptions .color-opt');
        if (sizes.length && !document.querySelector('#sizeOptions .size-opt.active'))
            return { box: 'sizeOptions', message: 'Please select a size before adding to cart.' };
        if (colors.length && !document.querySelector('#colorOptions .color-opt.active'))
            return { box: 'colorOptions', message: 'Please select a color before adding to cart.' };
        return null;
    }

    document.getElementById('pdpStickyAdd').addEventListener('click', function () {
        var missing = missingOption();
        if (missing) {
            form.scrollIntoView({ behavior: 'smooth', block: 'center' });
            showOptError(missing.message, missing.box);
            return;
        }
        clearOptError();
        form.requestSubmit();
    });

    document.getElementById('pdpStickyWish').addEventListener('click', function () {
        var wf = document.getElementById('wishForm@(Model.Id)');
        if (wf) wf.requestSubmit();
    });
})();
</script>
}
