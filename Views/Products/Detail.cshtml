@model ShoppingApp.Models.Product
@using ShoppingApp.Models
@{
    ViewData["Title"] = Model.Name;
    var related        = ViewBag.Related as List<ShoppingApp.Models.Product>;
    var completeLook   = ViewBag.CompleteLook as List<ShoppingApp.Models.Product> ?? new List<ShoppingApp.Models.Product>();
    ViewData["GridColClass"] = "col-6 col-md-4";
    var reviews        = ViewBag.Reviews as List<Review> ?? new List<Review>();
    var userId         = Context.Session.GetInt32("UserId");
    var reviewCount    = (int)(ViewBag.ReviewCount ?? 0);
    var avgRating      = (double)(ViewBag.AverageRating ?? 0.0);
    bool userReviewed  = (bool)(ViewBag.UserReviewed ?? false);
    bool hasPurchased  = (bool)(ViewBag.HasPurchased ?? false);

    var gallery = Model.Images?.OrderBy(i => i.SortOrder).ToList() ?? new List<ProductImage>();
    if (!gallery.Any() && !string.IsNullOrEmpty(Model.ImagePath))
        gallery.Add(new ProductImage { Id = 0, ProductId = Model.Id, ImagePath = Model.ImagePath, SortOrder = 0 });
    var galleryPaths = gallery
        .Select(g => g.ImagePath)
        .Where(p => !string.IsNullOrWhiteSpace(p))
        .ToList();

    var sizeList = (Model.Sizes ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    var colorList = (Model.Colors ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    var recentlyViewed = ViewBag.RecentlyViewed as List<ShoppingApp.Models.Product> ?? new List<ShoppingApp.Models.Product>();
    var ratingSummaries = ViewBag.RatingSummaries as Dictionary<int, ShoppingApp.Services.RatingSummary>
        ?? new Dictionary<int, ShoppingApp.Services.RatingSummary>();

    var suitDesc = string.Join(" · ", new[] { Model.Season, Model.Fabric, Model.StitchedType }
        .Where(x => !string.IsNullOrWhiteSpace(x)));
    ViewData["OgTitle"] = $"{Model.Name} | Amal Collection";
    ViewData["OgDescription"] = $"{Model.Name}{(suitDesc.Length > 0 ? " – " + suitDesc : "")}. PKR {Model.FinalPrice:N0} with cash on delivery across Pakistan.";
    ViewData["OgImage"] = gallery.FirstOrDefault()?.ImagePath ?? Model.ImagePath ?? "/images/placeholder.jpg";
    ViewData["OgUrl"] = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Action("Detail", "Products", new { id = Model.Id })}";
    ViewData["OgType"] = "product";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb pt-3" aria-label="breadcrumb" style="--bs-breadcrumb-divider: '/';">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/?season=@Model.Season">@Model.Season</a></li>
            <li class="breadcrumb-item"><a href="/?category=@Model.Category">@Model.Category</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- ═══ Product Detail ═══ -->
    <div class="row g-4 g-lg-5 py-4 pb-5">
        <!-- Gallery -->
        <div class="col-12 col-lg-6">
            <div class="pd-gallery">
                <div class="pd-main-img" id="pdMainBox" role="button" tabindex="0" aria-label="View a larger image of @Model.Name">
                    <img id="mainImage" src="@(gallery.FirstOrDefault()?.ImagePath ?? Model.ImagePath ?? "/images/placeholder.jpg")"
                         alt="@Model.Name" decoding="async" fetchpriority="high" onerror="this.src='/images/placeholder.jpg'" />
                    <span class="pd-zoom-hint" aria-hidden="true"><i class="bi bi-zoom-in"></i> Click to zoom</span>
                </div>
                @if (gallery.Count > 1)
                {
                    <div class="pd-thumbs" id="pdThumbs">
                        @foreach (var img in gallery)
                        {
                            <button type="button" class="pd-thumb @(img == gallery.First() ? "active" : "")" data-src="@img.ImagePath">
                                <img src="@img.ImagePath" alt="@Model.Name" loading="lazy" decoding="async" onerror="this.src='/images/placeholder.jpg'" />
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Info -->
        <div class="col-12 col-lg-6">
            <div class="pd-info">
                <div class="pd-cat">@Model.Season · @Model.Fabric @(Model.Pieces.HasValue ? $"· {Model.Pieces}-Piece" : "")</div>
                <h1 class="pd-name">@Model.Name</h1>

                <div class="pd-rating">
                    <span class="stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(avgRating, MidpointRounding.AwayFromZero))
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-star"></i>
                            }
                        }
                    </span>
                    <span>@avgRating.ToString("0.0") · @reviewCount @(reviewCount == 1 ? "review" : "reviews")</span>
                </div>

                <div class="pd-price-row">
                    <span class="pd-price">PKR @Model.FinalPrice.ToString("N0")</span>
                    @if (Model.Discount > 0)
                    {
                        <span class="pd-price-old">PKR @Model.Price.ToString("N0")</span>
                        <span class="pd-save">Save @Model.Discount%</span>
                    }
                </div>
                <div class="pd-stock @(Model.Stock > 0 ? "in" : "")">
                    @if (Model.Stock > 0)
                    {
                        if (Model.Stock <= 5)
                        {
                            <i class="bi bi-fire me-1"></i>
                            <span class="pd-low-stock">Only @Model.Stock left — order soon!</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle me-1"></i>
                            <span style="color:var(--green);">In Stock (@Model.Stock available)</span>
                        }
                    }
                    else
                    {
                        <i class="bi bi-x-circle me-1"></i>
                        <span style="color:var(--red);">Out of Stock</span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-secondary lh-lg mb-2" style="font-size:0.94rem;">@Model.Description</p>
                }

                @if (Model.IsFreeDelivery)
                {
                    <p class="pd-nologin"><i class="bi bi-truck me-1"></i> Free delivery available · Cash on Delivery</p>
                }
                else if ((Model.DeliveryCharge ?? 0) > 0)
                {
                    <p class="pd-nologin"><i class="bi bi-truck me-1"></i> Delivery: PKR @Model.DeliveryCharge!.Value.ToString("N0") · Cash on Delivery</p>
                }

                <hr class="my-4" />

                @if (Context.Session.GetString("UserRole") == "admin")
                {
                    <div class="not-buyer-notice" style="margin-bottom:1rem;">
                        Admins cannot purchase products or add them to cart.
                    </div>
                }
                else if (Model.Stock > 0)
                {
                    <form method="post" action="/Cart/AddPost" class="add-cart-form co-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />

                        @if (sizeList.Count > 0)
                        {
                            <div class="opt-label mb-3">
                                <span>Select Size</span>
                                <button type="button" class="size-guide" data-bs-toggle="modal" data-bs-target="#sizeGuideModal">Size Guide</button>
                            </div>
                            <div class="size-options mb-4" id="sizeOptions" role="group" aria-label="Select size">
                                @foreach (var s in sizeList)
                                {
                                    <button class="size-opt @(sizeList.Count == 1 ? "active" : "")" type="button" data-value="@s" aria-pressed="@(sizeList.Count == 1 ? "true" : "false")">@s</button>
                                }
                            </div>
                            <input type="hidden" name="size" id="sizeInput" value="@(sizeList.Count == 1 ? sizeList[0] : "")" />
                        }
                        else
                        {
                            <input type="hidden" name="size" value="" />
                        }

                        @if (colorList.Count > 0)
                        {
                            <div class="opt-label mb-3"><span>Select Color · <span id="colorLabelName">@(colorList.Count == 1 ? colorList[0] : "Choose one")</span></span></div>
                            <div class="color-options mb-4" id="colorOptions" role="group" aria-label="Select color">
                                @foreach (var c in colorList)
                                {
                                    <button class="color-opt @(colorList.Count == 1 ? "active" : "")" type="button" data-name="@c" aria-label="@c" aria-pressed="@(colorList.Count == 1 ? "true" : "false")" style="background:@GetColorHex(c)"></button>
                                }
                            </div>
                            <input type="hidden" name="color" id="colorInput" value="@(colorList.Count == 1 ? colorList[0] : "")" />
                        }
                        else
                        {
                            <input type="hidden" name="color" value="" />
                        }

                        <p class="opt-error" id="optError" role="alert" aria-live="polite" hidden></p>

                        <div class="d-flex align-items-center gap-3 mb-4">
                            <span class="opt-label mb-0">Quantity</span>
                            <div class="input-group qty-ctrl" style="width:auto;">
                                <button class="btn" type="button" id="qtyMinus" aria-label="Decrease quantity" aria-controls="qtyInput"><i class="bi bi-dash" aria-hidden="true"></i></button>
                                <input type="number" name="quantity" id="qtyInput" class="form-control text-center" value="1" min="1" max="@Model.Stock" aria-label="Quantity" />
                                <button class="btn" type="button" id="qtyPlus" aria-label="Increase quantity" aria-controls="qtyInput"><i class="bi bi-plus" aria-hidden="true"></i></button>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mb-2">
                            <button type="submit" class="btn btn-primary flex-grow-1 py-2">
                                <i class="bi bi-bag-plus me-1"></i> Add to Cart
                            </button>
                            <button type="button" class="btn btn-outline-dark rounded-pill px-3 pd-wish" onclick="document.getElementById('wishForm@(Model.Id)').requestSubmit();" aria-label="Wishlist">
                                <i class="bi bi-heart"></i>
                            </button>
                            <button type="button" class="btn btn-outline-dark rounded-pill px-3 pd-share" id="pdShare"
                                    data-name="@Model.Name" data-price="@Model.FinalPrice.ToString("N0")"
                                    aria-label="Share this product" title="Share this product">
                                <i class="bi bi-share"></i>
                            </button>
                        </div>
                        <p class="pd-nologin"><i class="bi bi-check-circle me-1"></i> No login required – guest checkout available</p>
                    </form>
                    <form id="wishForm@(Model.Id)" method="post" action="/Wishlist/Toggle" style="display:none;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="/Products/Detail/@Model.Id" />
                    </form>

                    <!-- Sticky mobile add-to-cart bar -->
                    <div class="pdp-sticky-bar" id="pdpStickyBar" aria-hidden="true">
                        <div class="pdp-sticky-info">
                            <span class="n">@Model.Name</span>
                            <span class="p">PKR @Model.FinalPrice.ToString("N0")</span>
                        </div>
                        <button type="button" class="btn btn-outline-dark rounded-pill pdp-sticky-wish" id="pdpStickyWish" aria-label="Add to wishlist">
                            <i class="bi bi-heart"></i>
                        </button>
                        <button type="button" class="btn btn-primary rounded-pill pdp-sticky-add" id="pdpStickyAdd">
                            <i class="bi bi-bag-plus me-1"></i> Add to Cart
                        </button>
                    </div>
                }
                else
                {
                    <button class="btn btn-primary w-100 py-2" disabled>Out of Stock</button>
                }

                <!-- Delivery -->
                <div class="delivery-box mt-3">
                    <div class="delivery-row">
                        <i class="bi bi-truck"></i>
                        <div><b>Fast Delivery:</b> Same-city in 24–48 hrs · Nationwide in 2–4 business days.</div>
                    </div>
                    <div class="delivery-row">
                        <i class="bi bi-cash-coin"></i>
                        <div><b>Cash on Delivery:</b> Available nationwide — pay at your doorstep upon arrival.</div>
                    </div>
                    <div class="delivery-row">
                        <i class="bi bi-arrow-repeat"></i>
                        <div><b>7-Day Exchange:</b> Easy size &amp; style exchange guaranteed on unworn suits.</div>
                    </div>
                </div>

                <!-- Trust -->
                <div class="pd-trust row g-2">
                    <div class="col-4"><span><i class="bi bi-patch-check me-1"></i> Genuine Product</span></div>
                    <div class="col-4"><span><i class="bi bi-shield-lock me-1"></i> Secure Checkout</span></div>
                    <div class="col-4"><span><i class="bi bi-whatsapp me-1"></i> WhatsApp Support</span></div>
                </div>

                <!-- Accordions -->
                <div class="accordion pd-acc mt-4" id="pdAcc">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#accDetails">
                                Product Details
                            </button>
                        </h2>
                        <div id="accDetails" class="accordion-collapse collapse show" data-bs-parent="#pdAcc">
                            <div class="accordion-body">
                                <div class="pd-specs">
                                    @if (!string.IsNullOrEmpty(Model.Fabric))
                                    {
                                        <div class="pd-spec"><span class="pd-spec-label">Fabric</span><span class="pd-spec-val">@Model.Fabric</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Season))
                                    {
                                        <div class="pd-spec"><span class="pd-spec-label">Season</span><span class="pd-spec-val">@Model.Season</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Category))
                                    {
                                        <div class="pd-spec"><span class="pd-spec-label">Category</span><span class="pd-spec-val">@Model.Category</span></div>
                                    }
                                    @if (Model.Pieces.HasValue)
                                    {
                                        <div class="pd-spec"><span class="pd-spec-label">Pieces</span><span class="pd-spec-val">@Model.Pieces</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.StitchedType))
                                    {
                                        <div class="pd-spec"><span class="pd-spec-label">Type</span><span class="pd-spec-val">@Model.StitchedType</span></div>
                                    }
                                    <div class="pd-spec pd-spec-wide"><span class="pd-spec-label">Care</span><span class="pd-spec-val">Machine wash cold, do not bleach, tumble dry low</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#accShip">
                                Shipping &amp; Returns
                            </button>
                        </h2>
                        <div id="accShip" class="accordion-collapse collapse" data-bs-parent="#pdAcc">
                            <div class="accordion-body">
                                Local delivery 24–48 hrs. Nationwide 2–4 working days.
                                Free exchange within 7 days on unworn items with tags.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#accRev">
                                Reviews (@reviewCount)
                            </button>
                        </h2>
                        <div id="accRev" class="accordion-collapse collapse" data-bs-parent="#pdAcc">
                            <div class="accordion-body">
                                @if (reviews.Any())
                                {
                                    @foreach (var r in reviews.Take(3))
                                    {
                                        <div class="mb-2">
                                            <span class="stars" style="color:var(--gold);">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i>
                                                }
                                            </span>
                                            – "@(r.Comment ?? "Great product!")" – @(r.User?.FullName ?? r.GuestName ?? "Customer")
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span>No reviews yet. Be the first!</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ Reviews Section ═══ -->
<section class="section">
    <div class="container">
        <div class="reviews-section">
            <div class="reviews-header">
                <div>
                    <h2 class="reviews-title"><i class="bi bi-star-fill text-warning"></i> Customer Reviews</h2>
                    <p style="color:var(--text-3); font-size:0.85rem; margin:0;">
                        @reviewCount @(reviewCount == 1 ? "review" : "reviews") · Average rating @avgRating.ToString("0.0") / 5.0
                    </p>
                </div>
                @if (reviewCount > 0)
                {
                    <div class="rating-breakdown">
                        @for (int star = 5; star >= 1; star--)
                        {
                            int count = reviews.Count(r => r.Rating == star);
                            double pct = reviewCount > 0 ? (double)count / reviewCount * 100 : 0;
                            <div class="rb-row">
                                <span class="rb-label">@star <i class="bi bi-star-fill"></i></span>
                                <div class="rb-bar-wrap">
                                    <div class="rb-bar-fill" style="width:@pct.ToString("0")%"></div>
                                </div>
                                <span class="rb-count">@count</span>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (userReviewed)
            {
                <div class="reviewed-notice">You have already reviewed this product. Thank you!</div>
            }
            else if (hasPurchased)
            {
                <div class="write-review-box">
                    <h3 class="write-review-title">Write a Review <span class="verified-buyer-tag">Verified Buyer</span></h3>
                    <form method="post" action="/Products/SubmitReview" id="reviewForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <div class="star-picker" id="starPicker">
                            <span class="sp-label">Your Rating:</span>
                            <div class="sp-stars" id="spStars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <button type="button" class="sp-star" data-val="@i" onclick="setRating(@i)"><i class="bi bi-star-fill"></i></button>
                                }
                            </div>
                            <span class="sp-hint" id="spHint">Click a star</span>
                            <input type="hidden" name="rating" id="ratingInput" value="0" required />
                        </div>
                        <div class="form-group">
                            <label for="comment">Your Review (optional)</label>
                            <textarea id="comment" name="comment" placeholder="Share your experience with this product…" rows="4"></textarea>
                        </div>
                        <button type="submit" class="btn-primary" id="submitReview" style="min-width:160px;">Submit Review</button>
                    </form>
                </div>
            }
            else
            {
                <div class="write-review-box">
                    <h3 class="write-review-title">Write a Review <span class="verified-buyer-tag">Verified Purchase</span></h3>
                    <p style="color:var(--text-3);font-size:0.85rem;margin:-0.3rem 0 0.9rem;">
                        <i class="bi bi-shield-check"></i> No account needed — just verify the order you received.
                    </p>
                    <form method="post" action="/Products/SubmitReview" id="reviewForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <div class="star-picker" id="starPicker">
                            <span class="sp-label">Your Rating:</span>
                            <div class="sp-stars" id="spStars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <button type="button" class="sp-star" data-val="@i" onclick="setRating(@i)"><i class="bi bi-star-fill"></i></button>
                                }
                            </div>
                            <span class="sp-hint" id="spHint">Click a star</span>
                            <input type="hidden" name="rating" id="ratingInput" value="0" required />
                        </div>
                        <div class="form-group">
                            <label for="comment">Your Review (optional)</label>
                            <textarea id="comment" name="comment" placeholder="Share your experience with this product…" rows="4"></textarea>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr;gap:0.9rem;">
                            <div class="form-group" style="margin:0;">
                                <label for="orderNo">Order Number *</label>
                                <input type="number" id="orderNo" name="orderId" min="1" required placeholder="e.g. 1042" />
                            </div>
                            <div class="form-group" style="margin:0;">
                                <label for="orderContact">Phone or Email used at checkout *</label>
                                <input type="text" id="orderContact" name="contact" required placeholder="03XX-XXXXXXX or you@example.com" />
                            </div>
                        </div>
                        <button type="submit" class="btn-primary" id="submitReview" style="min-width:160px;">Submit Review</button>
                    </form>
                    <p style="margin-top:0.75rem;font-size:0.78rem;color:var(--text-3);">
                        <i class="bi bi-info-circle"></i> Order number aapko confirmation page / SMS me milta hai.
                        @if (userId == null)
                        {
                            <span> Koi order nahi? <a href="/" style="color:var(--gold);">Shop now</a></span>
                        }
                    </p>
                </div>
            }

            @if (reviews.Any())
            {
                <div class="review-list">
                    @foreach (var r in reviews)
                    {
                        <div class="review-card">
                            @{
                                var revName = r.User?.FullName ?? r.GuestName ?? "Customer";
                                if (string.IsNullOrWhiteSpace(revName)) { revName = "Customer"; }
                            }
                            <div class="review-card-header">
                                <div class="review-avatar">@revName.Substring(0, 1).ToUpper()</div>
                                <div>
                                    <div class="review-author">
                                        @revName
                                        @if (r.IsVerified)
                                        {
                                            <span class="verified-buyer-tag" style="margin-left:0.4rem;">Verified Buyer</span>
                                        }
                                    </div>
                                    <div class="review-date">@r.CreatedAt.ToString("MMM dd, yyyy")</div>
                                </div>
                                <div class="review-stars ms-auto">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="@(i <= r.Rating ? "rs-star filled" : "rs-star")"><i class="bi bi-star-fill"></i></span>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(r.Comment))
                            {
                                <p class="review-comment">@r.Comment</p>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-reviews">
                    <div style="font-size:2.5rem; margin-bottom:0.75rem;"><i class="bi bi-chat-square-text"></i></div>
                    <p>No reviews yet. Be the first to share your experience!</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- ═══ Complete the Look ═══ -->
@if (completeLook.Any())
{
    <section class="section">
        <div class="container">
            <div class="section-kicker">Styled Together</div>
            <h2 class="section-title mb-2">Complete the Look</h2>
            <p class="section-sub mb-4">Pieces that pair beautifully with the @Model.Name.</p>
            @await Html.PartialAsync("_ProductGridCompact", completeLook)
        </div>
    </section>
}

<!-- ═══ Related Products ═══ -->
@if (related != null && related.Any())
{
    <section class="section section-alt">
        <div class="container">
            <div class="section-kicker">You May Also Like</div>
            <h2 class="section-title mb-4">Related Products</h2>
            <div class="row g-3 g-md-4">
                @foreach (var p in related)
                {
                    <div class="col-6 col-md-4 col-xl-3">
                        <div class="product-card h-100">
                            <div class="product-media">
                                <a href="/Products/Detail/@p.Id" class="product-media-link">
                                    <img src="@(p.ImagePath ?? "/images/placeholder.jpg")" alt="@p.Name" loading="lazy" decoding="async" onerror="this.src='/images/placeholder.jpg'" />
                                </a>
                                @if (p.Discount > 0) { <span class="badge-discount">-@p.Discount%</span> }
                                <span class="badge-tag">@p.Season</span>
                            </div>
                            <div class="product-info">
                                <div class="product-cat">@p.Season · @p.Category</div>
                                <h3 class="product-name"><a href="/Products/Detail/@p.Id">@p.Name</a></h3>
                                @await Html.PartialAsync("_ProductRating", ratingSummaries.GetValueOrDefault(p.Id))
                                <div class="product-pricing">
                                    <span class="price-final">PKR @p.FinalPrice.ToString("N0")</span>
                                </div>
                                @await Html.PartialAsync("_ProductStockBadge", p.Stock)
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

