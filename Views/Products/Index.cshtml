@model List<ShoppingApp.Models.Product>
@using ShoppingApp.Data
@inject AppDbContext _db
@{
    ViewData["Title"] = "Home – Amal Collection";
    var recommendations = ViewBag.Recommendations as List<ShoppingApp.Models.Product> ?? new List<ShoppingApp.Models.Product>();
    var categories  = ViewBag.Categories as List<string> ?? new List<string>();
    var seasons     = ViewBag.Seasons as List<string> ?? new List<string>();
    var fabrics     = ViewBag.Fabrics as List<string> ?? new List<string>();
    var sizes       = ViewBag.Sizes as List<string> ?? new List<string>();
    var heroSlides  = ViewBag.HeroSlides as List<ShoppingApp.Models.HeroSlide> ?? new List<ShoppingApp.Models.HeroSlide>();
    var promoCards = ViewBag.PromotionalCards as List<ShoppingApp.Models.PromotionalCard> ?? new List<ShoppingApp.Models.PromotionalCard>();
    string selectedCat    = ViewBag.SelectedCategory ?? "";
    string selectedSeason = ViewBag.SelectedSeason ?? "";
    string selectedFabric = ViewBag.SelectedFabric ?? "";
    string selectedSize   = ViewBag.SelectedSize ?? "";
    string selectedSort   = ViewBag.SelectedSort ?? "";
    bool hasFilters = !string.IsNullOrEmpty(selectedCat) || !string.IsNullOrEmpty(selectedSeason)
        || !string.IsNullOrEmpty(selectedFabric) || !string.IsNullOrEmpty(selectedSize) || !string.IsNullOrEmpty(selectedSort);

    int activeFilterCount = 0;
    if (!string.IsNullOrEmpty(selectedCat)) activeFilterCount++;
    if (!string.IsNullOrEmpty(selectedSeason)) activeFilterCount++;
    if (!string.IsNullOrEmpty(selectedFabric)) activeFilterCount++;
    if (!string.IsNullOrEmpty(selectedSize)) activeFilterCount++;
    if (!string.IsNullOrEmpty(selectedSort)) activeFilterCount++;

    var sortOptions = new (string Value, string Label)[]
    {
        ("", "Sort: Newest"),
        ("price_asc", "Price: Low to High"),
        ("price_desc", "Price: High to Low")
    };

    string BuildFilterUrl(string? cat = null, string? season = null, string? fabric = null, string? size = null, string? sort = null)
    {
        var p = new List<string>();
        var c = cat != null ? (cat == "__CLEAR__" ? "" : cat) : selectedCat;
        var s = season != null ? (season == "__CLEAR__" ? "" : season) : selectedSeason;
        var f = fabric != null ? (fabric == "__CLEAR__" ? "" : fabric) : selectedFabric;
        var sz = size != null ? (size == "__CLEAR__" ? "" : size) : selectedSize;
        var so = sort != null ? (sort == "__CLEAR__" ? "" : sort) : selectedSort;

        if (!string.IsNullOrEmpty(c)) p.Add("category=" + Uri.EscapeDataString(c));
        if (!string.IsNullOrEmpty(s)) p.Add("season=" + Uri.EscapeDataString(s));
        if (!string.IsNullOrEmpty(f)) p.Add("fabric=" + Uri.EscapeDataString(f));
        if (!string.IsNullOrEmpty(sz)) p.Add("size=" + Uri.EscapeDataString(sz));
        if (!string.IsNullOrEmpty(so)) p.Add("sort=" + Uri.EscapeDataString(so));

        return p.Count > 0 ? "/?" + string.Join("&", p) + "#products" : "/#products";
    }

    int curPage   = ViewBag.Page ?? 1;
    int pageCount = ViewBag.PageCount ?? 1;
    int totalCount = ViewBag.TotalCount ?? Model.Count;

    string PageUrl(int pg)
    {
        var q = new List<string>();
        if (!string.IsNullOrEmpty(selectedCat))    q.Add("category=" + Uri.EscapeDataString(selectedCat));
        if (!string.IsNullOrEmpty(selectedSeason)) q.Add("season=" + Uri.EscapeDataString(selectedSeason));
        if (!string.IsNullOrEmpty(selectedFabric)) q.Add("fabric=" + Uri.EscapeDataString(selectedFabric));
        if (!string.IsNullOrEmpty(selectedSize))   q.Add("size=" + Uri.EscapeDataString(selectedSize));
        if (!string.IsNullOrEmpty(selectedSort))   q.Add("sort=" + Uri.EscapeDataString(selectedSort));
        if (pg > 1) q.Add("page=" + pg);
        return q.Count > 0 ? "/?" + string.Join("&", q) + "#products" : "/#products";
    }

    if (!heroSlides.Any())
    {
        heroSlides = new List<ShoppingApp.Models.HeroSlide>
        {
            new() { Id=0, Tagline="FRESH FABRICS FOR EVERY SEASON", Title="SUMMER LAWN SUITS", CategoryLabel="SUMMER COLLECTION", Hashtag="#StayCool", LinkUrl="/?season=Summer", ImagePath="/images/suit-hero-summer.jpg" },
            new() { Id=0, Tagline="WARM, ELEGANT, WINTER-READY", Title="KHADDAR & WOOL", CategoryLabel="WINTER COLLECTION", Hashtag="#StayWarm", LinkUrl="/?season=Winter", ImagePath="/images/suit-hero-winter.jpg" },
            new() { Id=0, Tagline="UNSTITCHED TO STITCHED", Title="CUSTOM FIT", CategoryLabel="LAWN · COTTON · CHIFFON", Hashtag="#YourStyle", LinkUrl="/", ImagePath="/images/suit-hero-unstitched.jpg" },
            new() { Id=0, Tagline="ORDER IN MINUTES", Title="NO LOGIN NEEDED", CategoryLabel="COD AVAILABLE", Hashtag="#EasyOrder", LinkUrl="/", ImagePath="/images/suit-hero-cod.jpg" },
        };
    }

    var colorMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        { "Black", "#1c1b19" }, { "Charcoal", "#3a3128" }, { "Navy", "#1f2733" },
        { "Blue", "#4a5d78" }, { "Steel Blue", "#8a9bb5" }, { "White", "#ffffff" },
        { "Ivory", "#f5f0e6" }, { "Cream", "#f0e6d2" }, { "Beige", "#d9d0c2" },
        { "Sand", "#d9d0c2" }, { "Gold", "#b8964f" }, { "Green", "#2f6f5e" },
        { "Olive", "#6b7a4a" }, { "Maroon", "#7a2f2f" }, { "Red", "#d64545" },
        { "Pink", "#f0a7b8" }, { "Peach", "#d9a7a0" }, { "Lavender", "#a78bb8" },
        { "Purple", "#7a4a6b" }, { "Grey", "#8a8a8a" }, { "Gray", "#8a8a8a" },
        { "Brown", "#8a7d6a" }, { "Mustard", "#c9a227" }
    };
}

<!-- ═══ HERO SLIDER ═══ -->
<section class="hero" id="heroSlider">
    <div class="hero-track">
        @{ int slideIdx = 0; }
        @foreach (var slide in heroSlides)
        {
            <div class="hero-slide @(slideIdx == 0 ? "active" : "")">
                <div class="hero-img" style="background-image:url('@(string.IsNullOrEmpty(slide.ImagePath) ? "/images/placeholder.jpg" : slide.ImagePath)')"></div>
                <div class="hero-panel">
                    <div class="hero-text">
                        <div class="hero-kicker">@(string.IsNullOrEmpty(slide.Tagline) ? slide.CategoryLabel : slide.Tagline)</div>
                        <h1 class="hero-title">@(string.IsNullOrEmpty(slide.Title) ? "Ladies Suits" : slide.Title)</h1>
                        @if (!string.IsNullOrEmpty(slide.CategoryLabel) && !string.Equals(slide.CategoryLabel, slide.Tagline, StringComparison.OrdinalIgnoreCase))
                        {
                            <p class="hero-desc">@slide.CategoryLabel @(!string.IsNullOrEmpty(slide.Hashtag) ? $"· {slide.Hashtag}" : "")</p>
                        }
                        @if (slide.DisplayPrice.HasValue && slide.DisplayPrice > 0)
                        {
                            <div class="hero-price"><small>Starting from</small>PKR @slide.DisplayPrice.Value.ToString("N0")</div>
                        }
                        @{
                            string shopHref = slide.ProductId.HasValue
                                ? $"/Cart/Add?productId={slide.ProductId.Value}&quantity=1"
                                : (string.IsNullOrEmpty(slide.LinkUrl) ? "/" : slide.LinkUrl);
                        }
                        <div class="hero-actions">
                            <a href="@shopHref" class="btn btn-gold">Shop Now</a>
                            <a href="#products" class="btn btn-ghost">View Collection</a>
                        </div>
                    </div>
                </div>
            </div>
            slideIdx++;
        }
    </div>

    <button class="hero-arrow hero-prev" id="heroPrev" aria-label="Previous slide"><i class="bi bi-chevron-left"></i></button>
    <button class="hero-arrow hero-next" id="heroNext" aria-label="Next slide"><i class="bi bi-chevron-right"></i></button>

    <div class="hero-bottom">
        <div class="hero-dots" id="heroDots">
            @for (int d = 0; d < heroSlides.Count; d++)
            {
                <button class="hero-dot @(d == 0 ? "active" : "")" data-goto="@d" aria-label="Slide @(d+1)"></button>
            }
        </div>
        <div class="hero-counter"><b id="heroNum">01</b> / @heroSlides.Count.ToString("00")</div>
        <div class="hero-progress"><div class="hero-progress-bar" id="heroBar"></div></div>
    </div>
</section>

<!-- ═══ Promo Swipe Deck (Zarr-style) ═══ -->
@if (promoCards.Any())
{
    <link rel="stylesheet" href="~/css/promo-card.css" />
    <section class="section" id="promo">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
                <div>
                    <div class="section-kicker">Featured Deals</div>
                    <h2 class="section-title">Swipe the Deck</h2>
                </div>
                <a href="#products" class="link-more">View All <i class="bi bi-arrow-right"></i></a>
            </div>

            <div class="promo-section">
                <div class="promo-deck" id="promoDeck">
                    <div class="promo-deck__ghost promo-deck__ghost--2"></div>
                    <div class="promo-deck__ghost promo-deck__ghost--1"></div>

                    @* Cards rendered so last child = top of stack (guide order) *@
                    @for (int i = promoCards.Count - 1; i >= 0; i--)
                    {
                        var card = promoCards[i];
                        string? promoHref = null;
                        if (card.ProductId.HasValue)
                            promoHref = "/Products/Detail/" + card.ProductId.Value;
                        else if (!string.IsNullOrWhiteSpace(card.CategoryName))
                            promoHref = "/?category=" + Uri.EscapeDataString(card.CategoryName) + "#products";
                        <a class="promo-card" data-index="@i" href="@promoHref">

                            <img class="promo-card__img"
                                 src="@(string.IsNullOrEmpty(card.ImagePath) ? "/images/placeholder.jpg" : card.ImagePath)"
                                 alt="@card.BrandName"
                                 loading="lazy" decoding="async"
                                 draggable="false" />

                            <div class="promo-card__info">
                                @if (!string.IsNullOrWhiteSpace(card.BrandName))
                                {
                                    <div class="promo-card__brand">@card.BrandName</div>
                                }
                                @if (card.DiscountPercent > 0)
                                {
                                    <div class="promo-card__discount">
                                        @card.DiscountPercent%
                                        <span>OFF</span>
                                    </div>
                                }
                                @if (card.CurrentPrice > 0)
                                {
                                    <div class="promo-card__now">Now: Rs.@card.CurrentPrice.ToString("N0")</div>
                                }
                                @if (card.OriginalPrice > 0)
                                {
                                    <div class="promo-card__was">Was: Rs.@card.OriginalPrice.ToString("N0")</div>
                                }
                                @if (!string.IsNullOrEmpty(card.AvailableOnText) && (!string.IsNullOrEmpty(card.PlatformName) || !string.IsNullOrEmpty(card.LogoPath)))
                                {
                                    <div class="promo-card__avail">@card.AvailableOnText</div>
                                }
                                @if (!string.IsNullOrEmpty(card.LogoPath))
                                {
                                    <img class="promo-card__logo" src="@card.LogoPath"
                                         alt="@card.PlatformName" width="70" height="32" loading="lazy" decoding="async" draggable="false" />
                                }
                                @if (!string.IsNullOrEmpty(card.PlatformName))
                                {
                                    <div class="promo-card__platform">@card.PlatformName</div>
                                }
                            </div>
                        </a>
                    }
                </div>

                <div class="promo-dots" id="promoDots">
                    @for (int i = 0; i < promoCards.Count; i++)
                    {
                        <div class="promo-dot @(i == 0 ? "active" : "")"></div>
                    }
                </div>
            </div>
        </div>
    </section>
    <script src="~/js/promo-swipe.js" asp-append-version="true"></script>
}

<!-- ═══ Promo Banners ═══ -->
<section class="section section-alt">
    <div class="container">
        <div class="row g-4">
            <div class="col-12 col-md-6">
                <div class="promo promo-1 h-100">
                    <div>
                        <div class="promo-tag">Limited Time</div>
                        <h3 class="promo-title">Summer Sale<br />Up to 30% Off</h3>
                        <p class="promo-desc">Selected lawn &amp; cotton suits at local prices.</p>
                        <a href="#products" class="btn btn-gold btn-sm">Shop Sale</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="promo promo-2 h-100">
                    <div>
                        <div class="promo-tag">Easy Ordering</div>
                        <h3 class="promo-title">No Login<br />COD Available</h3>
                        <p class="promo-desc">Just your name, phone &amp; address — order in under 2 minutes.</p>
                        <a href="#products" class="btn btn-gold btn-sm">Start Shopping</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══ Products + Filters ═══ -->
<section class="section" id="products">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
            <div>
                <div class="section-kicker">Curated For You</div>
                <h2 class="section-title">@(string.IsNullOrEmpty(selectedCat) ? "Ladies Suits" : selectedCat)</h2>
            </div>
            @if (hasFilters)
            {
                <a href="/" class="link-more">Clear Filters <i class="bi bi-x-circle"></i></a>
            }
        </div>

        @{
            var qsBase = new List<string>();
            if (!string.IsNullOrEmpty(selectedFabric)) { qsBase.Add("fabric=" + Uri.EscapeDataString(selectedFabric)); }
            if (!string.IsNullOrEmpty(selectedSize)) { qsBase.Add("size=" + Uri.EscapeDataString(selectedSize)); }
            if (!string.IsNullOrEmpty(selectedSort)) { qsBase.Add("sort=" + Uri.EscapeDataString(selectedSort)); }

            var sSeasonBase = new List<string>(qsBase);
            if (!string.IsNullOrEmpty(selectedCat)) { sSeasonBase.Insert(0, "category=" + Uri.EscapeDataString(selectedCat)); }

            var sSizeBase = new List<string>();
            if (!string.IsNullOrEmpty(selectedCat)) { sSizeBase.Add("category=" + Uri.EscapeDataString(selectedCat)); }
            if (!string.IsNullOrEmpty(selectedSeason)) { sSizeBase.Add("season=" + Uri.EscapeDataString(selectedSeason)); }
            if (!string.IsNullOrEmpty(selectedFabric)) { sSizeBase.Add("fabric=" + Uri.EscapeDataString(selectedFabric)); }
            if (!string.IsNullOrEmpty(selectedSort)) { sSizeBase.Add("sort=" + Uri.EscapeDataString(selectedSort)); }

            var cBase = new List<string>();
            if (!string.IsNullOrEmpty(selectedSeason)) { cBase.Add("season=" + Uri.EscapeDataString(selectedSeason)); }
            if (!string.IsNullOrEmpty(selectedFabric)) { cBase.Add("fabric=" + Uri.EscapeDataString(selectedFabric)); }
            if (!string.IsNullOrEmpty(selectedSize)) { cBase.Add("size=" + Uri.EscapeDataString(selectedSize)); }
            if (!string.IsNullOrEmpty(selectedSort)) { cBase.Add("sort=" + Uri.EscapeDataString(selectedSort)); }

            var fBase = new List<string>();
            if (!string.IsNullOrEmpty(selectedCat)) { fBase.Add("category=" + Uri.EscapeDataString(selectedCat)); }
            if (!string.IsNullOrEmpty(selectedSeason)) { fBase.Add("season=" + Uri.EscapeDataString(selectedSeason)); }
            if (!string.IsNullOrEmpty(selectedSize)) { fBase.Add("size=" + Uri.EscapeDataString(selectedSize)); }
            if (!string.IsNullOrEmpty(selectedSort)) { fBase.Add("sort=" + Uri.EscapeDataString(selectedSort)); }

        }

        <!-- ── Luxury Filter Toolbar ── -->
        <div class="luxury-filter-toolbar">
            <!-- Top bar: Filter trigger + Quick chips + Sort -->
            <div class="filter-toolbar-top">
                <!-- Filter Trigger Button -->
                <button class="btn-filter-trigger" id="filterDrawerToggle" aria-expanded="false" aria-controls="filterDrawer" type="button">
                    <i class="bi bi-sliders2"></i>
                    Filter &amp; Refine
                    @if (activeFilterCount > 0)
                    {
                        <span class="filter-badge" id="filterBadge">@activeFilterCount</span>
                    }
                </button>

                <!-- Quick Discovery Chips (Season + Category) -->
                <div class="quick-filter-scroll">
                    <a href="/#products" class="quick-chip @(!hasFilters ? "active" : "")">All</a>
                    @foreach (var s in seasons)
                    {
                        var sUrl = "/?season=" + Uri.EscapeDataString(s) + "#products";
                        <a href="@sUrl" class="quick-chip @(selectedSeason == s && string.IsNullOrEmpty(selectedCat) ? "active" : "")">@s</a>
                    }
                    @foreach (var c in categories.Take(4))
                    {
                        var cUrl = "/?category=" + Uri.EscapeDataString(c) + "#products";
                        <a href="@cUrl" class="quick-chip @(selectedCat == c && string.IsNullOrEmpty(selectedSeason) ? "active" : "")">@c</a>
                    }
                </div>

                <!-- Sort + Count -->
                <div class="sort-count-wrap">
                    <span class="product-count-text d-none d-md-inline"><strong>@totalCount</strong> suit@(totalCount == 1 ? "" : "s")</span>
                    <div class="sort-dropdown-wrap">
                        <i class="bi bi-sort-down sort-icon"></i>
                        <form method="get" action="/" id="sortForm" style="display:inline;">
                            @if (!string.IsNullOrEmpty(selectedCat)) { <input type="hidden" name="category" value="@selectedCat" /> }
                            @if (!string.IsNullOrEmpty(selectedSeason)) { <input type="hidden" name="season" value="@selectedSeason" /> }
                            @if (!string.IsNullOrEmpty(selectedFabric)) { <input type="hidden" name="fabric" value="@selectedFabric" /> }
                            @if (!string.IsNullOrEmpty(selectedSize)) { <input type="hidden" name="size" value="@selectedSize" /> }
                            <select name="sort" class="sort-select" onchange="this.form.requestSubmit()">
                                @foreach (var opt in sortOptions)
                                {
                                    if (opt.Value == selectedSort)
                                    { <option value="@opt.Value" selected>@opt.Label</option> }
                                    else
                                    { <option value="@opt.Value">@opt.Label</option> }
                                }
                            </select>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Active Filter Pills -->
            @if (hasFilters)
            {
                <div class="active-filters-bar" id="activeFiltersBar">
                    @if (!string.IsNullOrEmpty(selectedSeason))
                    {
                        <a href="@BuildFilterUrl(season: "__CLEAR__")" class="active-filter-pill">
                            Season: @selectedSeason <span class="pill-remove"><i class="bi bi-x-lg"></i></span>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(selectedCat))
                    {
                        <a href="@BuildFilterUrl(cat: "__CLEAR__")" class="active-filter-pill">
                            Category: @selectedCat <span class="pill-remove"><i class="bi bi-x-lg"></i></span>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(selectedFabric))
                    {
                        <a href="@BuildFilterUrl(fabric: "__CLEAR__")" class="active-filter-pill">
                            Fabric: @selectedFabric <span class="pill-remove"><i class="bi bi-x-lg"></i></span>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(selectedSize))
                    {
                        <a href="@BuildFilterUrl(size: "__CLEAR__")" class="active-filter-pill">
                            Size: @selectedSize <span class="pill-remove"><i class="bi bi-x-lg"></i></span>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(selectedSort))
                    {
                        <a href="@BuildFilterUrl(sort: "__CLEAR__")" class="active-filter-pill">
                            Sort: @(sortOptions.FirstOrDefault(o => o.Value == selectedSort).Label ?? selectedSort) <span class="pill-remove"><i class="bi bi-x-lg"></i></span>
                        </a>
                    }
                    <a href="/" class="active-filter-clear">Clear All</a>
                </div>
            }
        </div>

        <!-- ── Filter Drawer (Offcanvas) ── -->
        <div class="filter-drawer-backdrop" id="filterBackdrop"></div>
        <aside class="filter-drawer" id="filterDrawer" aria-label="Product Filters" role="dialog">
            <div class="filter-drawer-header">
                <div class="filter-drawer-title"><i class="bi bi-sliders2 me-2 text-gold"></i>Filter &amp; Refine</div>
                <button class="filter-drawer-close" id="filterDrawerClose" aria-label="Close filters"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="filter-drawer-body">
                <form method="get" action="/" id="filterForm">
                    <!-- Season -->
                    @if (seasons.Any())
                    {
                        <div class="filter-group">
                            <div class="filter-group-label">Season</div>
                            <div class="filter-chip-row">
                                <label class="filter-chip-item @(string.IsNullOrEmpty(selectedSeason) ? "checked" : "")">
                                    <input type="radio" name="season" value="" @(string.IsNullOrEmpty(selectedSeason) ? "checked" : "") /> All
                                </label>
                                @foreach (var s in seasons)
                                {
                                    <label class="filter-chip-item @(selectedSeason == s ? "checked" : "")">
                                        <input type="radio" name="season" value="@s" @(selectedSeason == s ? "checked" : "") /> @s
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <!-- Category -->
                    @if (categories.Any())
                    {
                        <div class="filter-group">
                            <div class="filter-group-label">Category</div>
                            <div class="filter-chip-row">
                                <label class="filter-chip-item @(string.IsNullOrEmpty(selectedCat) ? "checked" : "")">
                                    <input type="radio" name="category" value="" @(string.IsNullOrEmpty(selectedCat) ? "checked" : "") /> All
                                </label>
                                @foreach (var c in categories)
                                {
                                    <label class="filter-chip-item @(selectedCat == c ? "checked" : "")">
                                        <input type="radio" name="category" value="@c" @(selectedCat == c ? "checked" : "") /> @c
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <!-- Fabric -->
                    @if (fabrics.Any())
                    {
                        <div class="filter-group">
                            <div class="filter-group-label">Fabric</div>
                            <div class="filter-chip-row">
                                <label class="filter-chip-item @(string.IsNullOrEmpty(selectedFabric) ? "checked" : "")">
                                    <input type="radio" name="fabric" value="" @(string.IsNullOrEmpty(selectedFabric) ? "checked" : "") /> All
                                </label>
                                @foreach (var f in fabrics)
                                {
                                    <label class="filter-chip-item @(selectedFabric == f ? "checked" : "")">
                                        <input type="radio" name="fabric" value="@f" @(selectedFabric == f ? "checked" : "") /> @f
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <!-- Size -->
                    @if (sizes.Any())
                    {
                        <div class="filter-group">
                            <div class="filter-group-label">Size</div>
                            <div class="filter-chip-row">
                                <label class="filter-chip-item @(string.IsNullOrEmpty(selectedSize) ? "checked" : "")">
                                    <input type="radio" name="size" value="" @(string.IsNullOrEmpty(selectedSize) ? "checked" : "") /> All
                                </label>
                                @foreach (var s in sizes)
                                {
                                    <label class="filter-chip-item @(selectedSize == s ? "checked" : "")">
                                        <input type="radio" name="size" value="@s" @(selectedSize == s ? "checked" : "") /> @s
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <!-- Sort -->
                    <div class="filter-group">
                        <div class="filter-group-label">Sort By</div>
                        <div class="filter-chip-row">
                            @foreach (var opt in sortOptions)
                            {
                                <label class="filter-chip-item @(selectedSort == opt.Value ? "checked" : "")">
                                    <input type="radio" name="sort" value="@opt.Value" @(selectedSort == opt.Value ? "checked" : "") /> @opt.Label
                                </label>
                            }
                        </div>
                    </div>
                </form>
            </div>
            <div class="filter-drawer-footer">
                <a href="/" class="btn-filter-reset">Reset All</a>
                <button class="btn-filter-apply" onclick="document.getElementById('filterForm').requestSubmit()">
                    Apply Filters
                </button>
            </div>
        </aside>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">No products found</div>
                <p>Try different filters or clear them to see all suits.</p>
                <a href="/" class="btn-primary">See All Products</a>
            </div>
        }
        else
        {
            <div class="row g-3 g-md-4">
                @foreach (var p in Model)
                {
                    var pColors = (p.Colors ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(4).ToList();
                    <div class="col-6 col-md-4 col-xl-3">
                        <div class="product-card h-100">
                            <div class="product-media">
                                <a href="/Products/Detail/@p.Id" class="product-media-link">
                                    <img src="@(string.IsNullOrEmpty(p.ImagePath) ? "/images/placeholder.jpg" : p.ImagePath)"
                                         alt="@p.Name" loading="lazy" decoding="async" onerror="this.src='/images/placeholder.jpg'" />
                                </a>
                                @if (p.Discount > 0)
                                {
                                    <span class="badge-discount">-@p.Discount%</span>
                                }
                                @if (p.Stock == 0)
                                {
                                    <span class="badge-tag" style="background:var(--red);color:#fff;">Out of Stock</span>
                                }
                                else
                                {
                                    <span class="badge-tag">@p.Season</span>
                                }
                            </div>
                            <div class="product-info">
                                <div class="product-cat">@p.Season · @p.Category</div>
                                <h3 class="product-name"><a href="/Products/Detail/@p.Id">@p.Name</a></h3>
                                <div class="product-meta">@p.Fabric @(p.StitchedType != null ? $"· {p.StitchedType}" : "")</div>
                                @if (pColors.Any())
                                {
                                    <div class="product-colors">
                                        @foreach (var col in pColors)
                                        {
                                            var hex = colorMap.TryGetValue(col, out var h) ? h : "#cfc4b4";
                                            <span class="color-dot" style="background:@hex" title="@col"></span>
                                        }
                                    </div>
                                }
                                <div class="product-pricing">
                                    <span class="price-final">PKR @p.FinalPrice.ToString("N0")</span>
                                    @if (p.Discount > 0)
                                    {
                                        <span class="price-original">PKR @p.Price.ToString("N0")</span>
                                    }
                                </div>
                            </div>
                            <div class="product-actions">
                                <form method="post" action="/Wishlist/Toggle" class="wish-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <input type="hidden" name="returnUrl" value="/" />
                                    <button type="submit" class="wish-btn" aria-label="Wishlist"><i class="bi bi-heart"></i></button>
                                </form>
                                @if (p.Stock > 0)
                                {
                                    <a href="/Cart/Add?productId=@p.Id&quantity=1" class="quick-add" aria-label="Quick Add"><i class="bi bi-bag-plus"></i> Quick Add</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (pageCount > 1)
            {
                var pageLinks = new List<int>();
                int pgFrom = Math.Max(1, curPage - 2);
                int pgTo = Math.Min(pageCount, curPage + 2);
                if (pgFrom > 1) { pageLinks.Add(1); if (pgFrom > 2) pageLinks.Add(-1); }
                for (int i = pgFrom; i <= pgTo; i++) pageLinks.Add(i);
                if (pgTo < pageCount) { if (pgTo < pageCount - 1) pageLinks.Add(-1); pageLinks.Add(pageCount); }

                <nav class="pager-chips d-flex justify-content-center flex-wrap gap-2 mt-4" aria-label="Product pages">
                    @if (curPage > 1)
                    {
                        <a class="quick-chip" href="@PageUrl(curPage - 1)" aria-label="Previous page"><i class="bi bi-chevron-left"></i></a>
                    }
                    @foreach (var pg in pageLinks)
                    {
                        if (pg == -1)
                        {
                            <span class="quick-chip" style="pointer-events:none;">&hellip;</span>
                        }
                        else if (pg == curPage)
                        {
                            <a class="quick-chip active" href="@PageUrl(pg)" aria-current="page">@pg</a>
                        }
                        else
                        {
                            <a class="quick-chip" href="@PageUrl(pg)">@pg</a>
                        }
                    }
                    @if (curPage < pageCount)
                    {
                        <a class="quick-chip" href="@PageUrl(curPage + 1)" aria-label="Next page"><i class="bi bi-chevron-right"></i></a>
                    }
                </nav>
            }
        }
    </div>
</section>

