@model List<ShoppingApp.Models.Product>
@{
    ViewData["Title"] = "Home – Amal Collection";
    var recommendations = ViewBag.Recommendations as List<ShoppingApp.Models.Product> ?? new List<ShoppingApp.Models.Product>();
    var categories  = ViewBag.Categories as List<string> ?? new List<string>();
    var seasons     = ViewBag.Seasons as List<string> ?? new List<string>();
    var fabrics     = ViewBag.Fabrics as List<string> ?? new List<string>();
    var sizes       = ViewBag.Sizes as List<string> ?? new List<string>();
    var heroSlides  = ViewBag.HeroSlides as List<ShoppingApp.Models.HeroSlide> ?? new List<ShoppingApp.Models.HeroSlide>();
    string selectedCat    = ViewBag.SelectedCategory ?? "";
    string selectedSeason = ViewBag.SelectedSeason ?? "";
    string selectedFabric = ViewBag.SelectedFabric ?? "";
    string selectedSize   = ViewBag.SelectedSize ?? "";
    string selectedSort   = ViewBag.SelectedSort ?? "";
    bool hasFilters = !string.IsNullOrEmpty(selectedCat) || !string.IsNullOrEmpty(selectedSeason)
        || !string.IsNullOrEmpty(selectedFabric) || !string.IsNullOrEmpty(selectedSize) || !string.IsNullOrEmpty(selectedSort);

    // Fallback static slides if no DB slides exist yet
    if (!heroSlides.Any())
    {
        heroSlides = new List<ShoppingApp.Models.HeroSlide>
        {
            new() { Id=0, Tagline="FRESH FABRICS FOR EVERY SEASON", Title="SUMMER LAWN SUITS", CategoryLabel="SUMMER COLLECTION", Hashtag="#StayCool", LinkUrl="/?season=Summer", ImagePath="/images/suit-hero-summer.jpg" },
            new() { Id=0, Tagline="WARM, ELEGANT, WINTER-READY", Title="KHADDAR & WOOL", CategoryLabel="WINTER COLLECTION", Hashtag="#StayWarm", LinkUrl="/?season=Winter", ImagePath="/images/suit-hero-winter.jpg" },
            new() { Id=0, Tagline="UNSTITCHED TO STITCHED", Title="CUSTOM FIT", CategoryLabel="LAWN · COTTON · CHIFFON", Hashtag="#YourStyle", LinkUrl="/", ImagePath="/images/suit-hero-unstitched.jpg" },
            new() { Id=0, Tagline="ORDER IN MINUTES", Title="NO LOGIN NEEDED", CategoryLabel="COD AVAILABLE", Hashtag="#EasyOrder", LinkUrl="/", ImagePath="/images/suit-hero-cod.jpg" },
        };
    }
}

<!-- ═══════════════════════════════════════════════════════════
     HERO SLIDER — Full-Image Horizontal Banner
     ═══════════════════════════════════════════════════════════ -->
<div class="rn-slider" id="rnSlider">

    @{ int slideIdx = 0; }
    @foreach (var slide in heroSlides)
    {
        <div class="rn-slide @(slideIdx == 0 ? "active" : "")">
            <!-- Background image layer -->
            <div class="rn-img" style="background-image:url('@(string.IsNullOrEmpty(slide.ImagePath) ? "/images/placeholder.jpg" : slide.ImagePath)')">
                <!-- Gradient overlay so text is always readable -->
            </div>
            <!-- Text panel (left side) -->
            <div class="rn-panel">
                <div class="rn-text-box">
                    <p class="rn-tagline">@slide.Tagline</p>
                    <h2 class="rn-name">@slide.Title</h2>
                    <p class="rn-cat">@slide.CategoryLabel</p>
                    @if (!string.IsNullOrEmpty(slide.Hashtag))
                    {
                        <p class="rn-tag">@slide.Hashtag</p>
                    }
                    @if (slide.DisplayPrice.HasValue && slide.DisplayPrice > 0)
                    {
                        <p class="rn-price">PKR @slide.DisplayPrice.Value.ToString("N0")</p>
                    }
                    @{
                        // If a ProductId is linked → add directly to cart
                        // Otherwise fall back to LinkUrl
                        string shopHref = slide.ProductId.HasValue
                            ? $"/Cart/Add?productId={slide.ProductId.Value}&quantity=1"
                            : (slide.LinkUrl ?? "/");
                    }
                    @if (slide.ProductId.HasValue || !string.IsNullOrEmpty(slide.LinkUrl))
                    {
                        <a href="@shopHref" class="rn-cta">Shop Now</a>
                    }
                </div>
            </div>
        </div>
        slideIdx++;
    }

    <!-- Prev / Next arrows -->
    <button class="rn-arrow rn-prev" id="rnPrev" aria-label="Previous">&#8249;</button>
    <button class="rn-arrow rn-next" id="rnNext" aria-label="Next">&#8250;</button>

    <!-- Dot indicators -->
    <div class="rn-dots" id="rnDots">
        @for (int d = 0; d < heroSlides.Count; d++)
        {
            <span class="rn-dot @(d == 0 ? "active" : "")" data-goto="@d"></span>
        }
    </div>
</div>

<!-- Filters -->
<section class="filter-bar" id="products">
    <form method="get" action="/" class="filter-form">
        <select name="category" onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var cat in categories)
            {
                if (cat == selectedCat)
                {
                    <option value="@cat" selected>@cat</option>
                }
                else
                {
                    <option value="@cat">@cat</option>
                }
            }
        </select>
        <select name="season" onchange="this.form.submit()">
            <option value="">All Seasons</option>
            @foreach (var s in seasons)
            {
                if (s == selectedSeason)
                {
                    <option value="@s" selected>@s</option>
                }
                else
                {
                    <option value="@s">@s</option>
                }
            }
        </select>
        <select name="fabric" onchange="this.form.submit()">
            <option value="">All Fabrics</option>
            @foreach (var f in fabrics)
            {
                if (f == selectedFabric)
                {
                    <option value="@f" selected>@f</option>
                }
                else
                {
                    <option value="@f">@f</option>
                }
            }
        </select>
        <select name="size" onchange="this.form.submit()">
            <option value="">All Sizes</option>
            @foreach (var s in sizes)
            {
                if (s == selectedSize)
                {
                    <option value="@s" selected>@s</option>
                }
                else
                {
                    <option value="@s">@s</option>
                }
            }
        </select>
        <select name="sort" onchange="this.form.submit()">
            @if (selectedSort == "")
            {
                <option value="" selected>Sort: Newest</option>
            }
            else
            {
                <option value="">Sort: Newest</option>
            }
            @if (selectedSort == "price_asc")
            {
                <option value="price_asc" selected>Price: Low to High</option>
            }
            else
            {
                <option value="price_asc">Price: Low to High</option>
            }
            @if (selectedSort == "price_desc")
            {
                <option value="price_desc" selected>Price: High to Low</option>
            }
            else
            {
                <option value="price_desc">Price: High to Low</option>
            }
        </select>
        @if (hasFilters)
        {
            <a href="/" class="btn-outline-sm">Clear</a>
        }
    </form>
</section>

<!-- Products Grid -->
<section class="section">
    <h2 class="section-title">
        @(string.IsNullOrEmpty(selectedCat) ? "All Products" : selectedCat)
        <span class="badge">@Model.Count items</span>
    </h2>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">No products found</div>
            <p>Try different filters or clear them to see all suits.</p>
            <a href="/" class="btn-primary">See All Products</a>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var p in Model)
            {
                <a href="/Products/Detail/@p.Id" class="product-card">
                    <div class="product-img-wrap">
                        <img src="@(string.IsNullOrEmpty(p.ImagePath) ? "/images/placeholder.jpg" : p.ImagePath)"
                             alt="@p.Name" onerror="this.src='/images/placeholder.jpg'" />
                        @if (p.Discount > 0)
                        {
                            <span class="badge-discount">-@p.Discount%</span>
                        }
                        @if (p.Stock == 0)
                        {
                            <span class="badge-oos">Out of Stock</span>
                        }
                    </div>
                    <div class="product-info">
                        <div class="product-category">@p.Category · @p.Season</div>
                        <h3 class="product-name">@p.Name</h3>
                        <div class="product-brand">@p.Fabric @(p.StitchedType != null ? $" · {p.StitchedType}" : "")</div>
                        <div class="product-pricing">
                            <span class="price-final">PKR @p.FinalPrice.ToString("N0")</span>
                            @if (p.Discount > 0)
                            {
                                <span class="price-original">PKR @p.Price.ToString("N0")</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>

<!-- Recommendations -->
@if (recommendations.Any() && !hasFilters)
{
    <section class="section recs-section">
        <h2 class="section-title">Recommended For You</h2>
        <div class="product-grid">
            @foreach (var p in recommendations)
            {
                <a href="/Products/Detail/@p.Id" class="product-card rec-card">
                    <div class="product-img-wrap">
                        <img src="@(string.IsNullOrEmpty(p.ImagePath) ? "/images/placeholder.jpg" : p.ImagePath)"
                             alt="@p.Name" onerror="this.src='/images/placeholder.jpg'" />
                    </div>
                    <div class="product-info">
                        <div class="product-category">@p.Category</div>
                        <h3 class="product-name">@p.Name</h3>
                        <div class="product-pricing">
                            <span class="price-final">PKR @p.FinalPrice.ToString("N0")</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </section>
}
