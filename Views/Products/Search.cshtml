@model List<ShoppingApp.Models.Product>
@{
    ViewData["Title"] = $"Search: {ViewBag.Query}";
}

<section class="section">
    <div class="container">
        <div class="section-kicker">Search Results</div>
        <h2 class="section-title mb-4">"@(ViewBag.Query)" <span class="badge">@Model.Count found</span></h2>
        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="bi bi-search"></i></div>
                <p>No products matched your search. Try different keywords.</p>
                <a href="/" class="btn btn-gold">Back to Shop</a>
            </div>
        }
        else
        {
            <div class="row g-3 g-md-4">
                @foreach (var p in Model)
                {
                    <div class="col-6 col-md-4 col-xl-3">
                        <div class="product-card h-100">
                            <div class="product-media">
                                <a href="/Products/Detail/@p.Id" class="product-media-link">
                                    <img src="@(p.ImagePath ?? "/images/placeholder.jpg")" alt="@p.Name" loading="lazy" decoding="async" onerror="this.src='/images/placeholder.jpg'" />
                                </a>
                                @if (p.Discount > 0) { <span class="badge-discount">-@p.Discount%</span> }
                                <span class="badge-tag">@p.Season</span>
                            </div>
                            <div class="product-info">
                                <div class="product-cat">@p.Season · @p.Category</div>
                                <h3 class="product-name"><a href="/Products/Detail/@p.Id">@p.Name</a></h3>
                                <div class="product-meta">@p.Fabric</div>
                                <div class="product-pricing">
                                    <span class="price-final">PKR @p.FinalPrice.ToString("N0")</span>
                                    @if (p.Discount > 0) { <span class="price-original">PKR @p.Price.ToString("N0")</span> }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
