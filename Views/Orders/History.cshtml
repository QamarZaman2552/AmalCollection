@model List<ShoppingApp.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<section class="section">
    <h1 class="section-title">📋 My Orders</h1>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📋</div>
            <p>You haven't placed any orders yet.</p>
            <a href="/" class="btn-primary">Start Shopping</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="order-card">
                <div class="order-header">
                    <div>
                        <span class="order-id">Order #@order.Id</span>
                        <span class="order-date">@order.CreatedAt.AddHours(5).ToString("dd MMM yyyy, hh:mm tt") (PKT)</span>
                    </div>
                    <span class="order-status status-@order.Status">@order.Status.ToUpper()</span>
                </div>
                <div class="order-items-list">
                    @foreach (var item in order.OrderItems)
                    {
                        <div class="order-item-row">
                            <span>@item.Product?.Name</span>
                            <span>PKR @((item.UnitPrice * item.Quantity).ToString("N0"))</span>
                        </div>
                    }
                </div>
                <div class="order-footer">
                    <span>📍 @order.DeliveryAddress</span>
                    <span>💳 @order.PaymentMethod</span>
                    <span class="order-total">Total: PKR @order.TotalAmount.ToString("N0")</span>
                </div>
            </div>
        }
    }
</section>
