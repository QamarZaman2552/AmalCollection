@{
    ViewData["Title"] = "Order Confirmed";
}

<section class="section">
    <div class="confirmation-box">
        <div class="confirm-icon"><i class="bi bi-emoji-smile-fill"></i></div>
        @if (ViewBag.OrderId == null)
        {
            <h1>Order status unknown</h1>
            <p>We could not confirm your order. Please check <a href="/Orders/History">My Orders</a> or <a href="/Contact">contact support</a>.</p>
        }
        else
        {
            <h1>Order Placed Successfully!</h1>
            <p>Thank you for your purchase. Your order <strong>#@ViewBag.OrderId</strong> has been received and is being processed.</p>
        }
        <div class="confirm-steps">
            <div class="step active"><i class="bi bi-check-circle-fill me-1"></i>Order Placed</div>
            <div class="step"><i class="bi bi-box-seam me-1"></i>Processing</div>
            <div class="step"><i class="bi bi-truck me-1"></i>Shipping</div>
            <div class="step"><i class="bi bi-house me-1"></i>Delivered</div>
        </div>
        <div class="confirm-actions">
            @if (ViewBag.IsGuest as bool? != true)
            {
                <a href="/Orders/History" class="btn-primary">View My Orders</a>
            }
            <a href="/" class="btn-glass">Continue Shopping</a>
        </div>
        @if (ViewBag.IsGuest as bool? == true)
        {
            <p class="confirm-guest-note">You checked out as a guest — keep order number <strong>#@ViewBag.OrderId</strong> for reference. Support: <a href="/Contact">@ViewBag.SupportPhone</a></p>
        }
    </div>
</section>
