@model ShoppingApp.Models.Order
@{
    ViewData["Title"] = "Track Order";
    var error = ViewBag.Error as string;
    var prefill = ViewBag.PrefillId as int?;
}

<section class="section">
    <h1 class="section-title"><i class="bi bi-search me-2"></i>Track Your Order</h1>

    @if (Model != null)
    {
        int step = Model.Status switch { "confirmed" => 1, "shipped" => 2, "delivered" => 3, _ => 0 };
        <div class="order-track-card" style="max-width:760px;margin:0 auto;">

            <div class="otc-header">
                <div>
                    <span class="otc-id">Order #@Model.Id</span>
                    <span class="otc-date">@Model.CreatedAt.AddHours(5).ToString("dd MMM yyyy, hh:mm tt") (PKT)</span>
                </div>
                <span class="order-status status-@Model.Status">@Model.Status.ToUpper()</span>
            </div>

            <div class="otc-timeline">
                <div class="otc-step @(step >= 0 ? "done" : "")">
                    <div class="otc-step-dot"><i class="bi bi-check-lg"></i></div>
                    <div class="otc-step-label">Order Placed</div>
                </div>
                <div class="otc-line @(step >= 1 ? "done" : "")"></div>
                <div class="otc-step @(step >= 1 ? "done" : "")">
                    <div class="otc-step-dot">@(step >= 1 ? Html.Raw("<i class=\"bi bi-check-lg\"></i>") : "2")</div>
                    <div class="otc-step-label">Confirmed</div>
                </div>
                <div class="otc-line @(step >= 2 ? "done" : "")"></div>
                <div class="otc-step @(step >= 2 ? "done" : "")">
                    <div class="otc-step-dot">@(step >= 2 ? Html.Raw("<i class=\"bi bi-check-lg\"></i>") : Html.Raw("<i class=\"bi bi-truck\"></i>"))</div>
                    <div class="otc-step-label">Shipped</div>
                </div>
                <div class="otc-line @(step >= 3 ? "done" : "")"></div>
                <div class="otc-step @(step >= 3 ? "done" : "")">
                    <div class="otc-step-dot">@(step >= 3 ? Html.Raw("<i class=\"bi bi-check-lg\"></i>") : Html.Raw("<i class=\"bi bi-house\"></i>"))</div>
                    <div class="otc-step-label">Delivered</div>
                </div>
            </div>

            <div class="otc-items">
                @foreach (var item in Model.OrderItems)
                {
                    <div class="otc-item">
                        <img src="@(item.Product?.ImagePath ?? "/images/placeholder.jpg")"
                             alt="@item.Product?.Name"
                             loading="lazy" decoding="async"
                             onerror="this.src='/images/placeholder.jpg'" />
                        <div class="otc-item-info">
                            <div class="otc-item-name">@item.Product?.Name</div>
                            <div class="otc-item-qty">
                                Qty: @item.Quantity
                                @if (!string.IsNullOrEmpty(item.Size)) { <span> · Size: @item.Size</span> }
                                @if (!string.IsNullOrEmpty(item.Color)) { <span> · Color: @item.Color</span> }
                            </div>
                        </div>
                        <div class="otc-item-price">PKR @((item.UnitPrice * item.Quantity).ToString("N0"))</div>
                    </div>
                }
            </div>

            <div class="otc-footer">
                <span>@Model.DeliveryAddress</span>
                <span>@Model.PaymentMethod</span>
                <span class="otc-total">Total: PKR @Model.TotalAmount.ToString("N0")</span>
            </div>
        </div>

        <p style="text-align:center;margin-top:1.2rem;">
            <a href="/Orders/Track" class="btn-glass">Track Another Order</a>
        </p>
    }
    else
    {
        <div class="confirmation-box" style="max-width:560px;margin:0 auto;">
            <form method="post" action="/Orders/Track">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label" for="id">Order Number *</label>
                    <input class="form-control" type="number" min="1" id="id" name="id" value="@(prefill?.ToString() ?? "")" placeholder="e.g. 6" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="contact">Email or Phone used at checkout *</label>
                    <input class="form-control" type="text" id="contact" name="contact" placeholder="you@example.com or 03XX-XXXXXXX" required autocomplete="email" />
                </div>
                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger" role="alert" style="font-size:0.9rem;">@error</div>
                }
                <button type="submit" class="btn-primary" style="width:100%;">Track Order</button>
            </form>
            <p style="font-size:0.82rem;color:var(--text-3);margin-top:0.9rem;text-align:center;">
                No login needed — use the email or phone number you entered at checkout.
            </p>
        </div>
    }
</section>
