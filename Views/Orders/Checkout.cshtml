@model List<ShoppingApp.Models.CartItem>
@{
    ViewData["Title"] = "Checkout — Guest Order";
    ViewData["BodyClass"] = "checkout-body";
    Layout = "~/Views/Shared/_Layout.cshtml";

    decimal total = (decimal)(ViewBag.Total ?? 0);
    decimal delivery = (decimal)(ViewBag.DeliveryCharge ?? 0m);
    decimal grand = (decimal)(ViewBag.GrandTotal ?? (total + delivery));
    int itemCount = Model.Sum(i => i.Quantity);
    bool isGuest = (bool)(ViewBag.IsGuest ?? false);

    string firstName = ViewBag.FirstName as string ?? "";
    string lastName = ViewBag.LastName as string ?? "";
    string email = ViewBag.Email as string ?? "";
    string phone = ViewBag.Phone as string ?? "";
    bool codEnabled = ViewBag.CodEnabled as bool? != false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
}

<!-- ═══ Minimal checkout header ═══ -->
<header class="co-header sticky-top">
    <div class="co-header-inner">
        <a href="/" class="ac-brand fs-4 text-decoration-none">Amal<em>Collection</em></a>
        <div class="d-flex align-items-center gap-2">
            <a href="/Wishlist" class="btn ac-icon-btn position-relative" aria-label="Wishlist"><i class="bi bi-heart"></i></a>
            <a href="/Cart" class="btn ac-icon-btn position-relative" aria-label="Cart"><i class="bi bi-bag"></i></a>
            <a href="/" class="co-back ms-1"><i class="bi bi-arrow-left me-1"></i> Back to shop</a>
        </div>
    </div>
</header>

<div class="container py-4">
    <div class="row g-4 justify-content-center">
        <!-- Order summary -->
        <div class="col-12 col-lg-5 col-xl-4 order-1 order-lg-2">
            <aside class="co-summary">
                <button type="button" class="co-sum-toggle" id="sumToggle" data-bs-toggle="collapse" data-bs-target="#orderSummary" aria-expanded="false" aria-controls="orderSummary">
                    <span class="co-sum-label"><i class="bi bi-bag me-1"></i> Order summary</span>
                    <span class="co-sum-amount">PKR @grand.ToString("N0")</span>
                    <i class="bi bi-chevron-down"></i>
                </button>

                <div class="collapse" id="orderSummary">
                    <div class="co-sum-body">
                        @foreach (var item in Model)
                        {
                            <div class="co-item">
                                <img src="@(item.Product?.ImagePath ?? "/images/placeholder.jpg")"
                                     alt="@item.Product?.Name"
                                     loading="lazy" decoding="async"
                                     onerror="this.src='/images/placeholder.jpg'" />
                                <div class="co-item-info">
                                    <div class="co-item-name">@item.Product?.Name</div>
                                    <div class="co-item-meta">
                                        @item.Product?.Category
                                        @if (!string.IsNullOrEmpty(item.Size)) { <span> · Size @item.Size</span> }
                                        @if (!string.IsNullOrEmpty(item.Color)) { <span> · @item.Color</span> }
                                    </div>
                                    <div class="co-item-qty">Qty: @item.Quantity</div>
                                </div>
                                <div class="co-item-price">PKR @((item.Product!.FinalPrice * item.Quantity).ToString("N0"))</div>
                            </div>
                        }

                        <div class="co-totals">
                            <div class="co-total-row"><span>Subtotal</span><span>PKR @total.ToString("N0")</span></div>
                            <div class="co-total-row">
                                <span>Shipping</span>
                                @if (delivery == 0)
                                {
                                    <span style="color:var(--green);font-weight:600;">FREE</span>
                                }
                                else
                                {
                                    <span>PKR @delivery.ToString("N0")</span>
                                }
                            </div>
                            <div class="co-total-row grand"><span>Total</span><span>PKR @grand.ToString("N0")</span></div>
                        </div>

                        <div class="co-assure">
                            <div><i class="bi bi-check-circle me-1"></i> No login required</div>
                            <div><i class="bi bi-check-circle me-1"></i> 7-day exchange</div>
                            <div><i class="bi bi-check-circle me-1"></i> @(codEnabled ? "COD available" : "Contact support for payment")</div>
                        </div>
                    </div>
                </div>
            </aside>
        </div>

        <!-- Left: form -->
        <div class="col-12 col-lg-7 order-2 order-lg-1">
            <div class="co-main">
                <nav aria-label="Checkout progress" class="mb-3">
                    <ol class="breadcrumb small mb-0" style="--bs-breadcrumb-divider: '›';">
                        <li class="breadcrumb-item"><a href="/Cart">Cart</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Details</li>
                        <li class="breadcrumb-item text-muted">Confirm</li>
                    </ol>
                </nav>

                <h1 class="co-title">Guest Checkout</h1>
                <p class="co-sub"><i class="bi bi-check-circle me-1"></i> No account required — simply enter your delivery details to confirm your order.</p>

                @if (TempData["Error"] != null)
                {
                    <div class="checkout-alert checkout-alert-error"><i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["Error"]</div>
                }

                <form method="post" action="/Orders/Checkout" class="co-form" id="guestCheckoutForm">
                    @Html.AntiForgeryToken()

                    <!-- Contact -->
                    <section class="co-section">
                        <h2><i class="bi bi-person me-1"></i> Contact</h2>
                        @if (isGuest)
                        {
                            <p style="font-size:0.78rem;color:var(--text-3);margin-top:0.35rem;">No login needed — we only need your details to deliver the order.</p>
                        }
                        <div class="mb-3">
                            <label class="form-label" for="firstName">First Name *</label>
                            <input type="text" class="form-control" id="firstName" name="firstName" value="@firstName" placeholder="e.g. Ayesha" required autocomplete="given-name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="lastName">Last Name *</label>
                            <input type="text" class="form-control" id="lastName" name="lastName" value="@lastName" placeholder="e.g. Khan" required autocomplete="family-name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="phone">Phone *</label>
                            <input type="tel" class="form-control" id="phone" name="phone" value="@phone" placeholder="03XX-XXXXXXX" required autocomplete="tel" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="email">Email <span class="text-secondary fw-normal">(optional)</span></label>
                            <input type="email" class="form-control" id="email" name="email" value="@email" @(isGuest ? "" : "readonly") placeholder="you@example.com" autocomplete="email" />
                        </div>
                    </section>

                    <!-- Address -->
                    <section class="co-section">
                        <h2><i class="bi bi-geo-alt me-1"></i> Delivery Address</h2>
                        <div class="mb-3">
                            <label class="form-label" for="country">Country / Region</label>
                            <select id="country" name="country" class="form-control" required>
                                <option value="Pakistan" selected>Pakistan</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="address">Address *</label>
                            <input type="text" class="form-control" id="address" name="address" placeholder="House #, Street, Area" required autocomplete="street-address" />
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label class="form-label" for="city">City *</label>
                                <input type="text" class="form-control" id="city" name="city" placeholder="e.g. Lahore, Multan" required autocomplete="address-level2" />
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label" for="postalCode">Postal Code <span class="text-secondary fw-normal">(optional)</span></label>
                                <input type="text" class="form-control" id="postalCode" name="postalCode" placeholder="54000" autocomplete="postal-code" />
                            </div>
                        </div>
                    </section>

                    <!-- Payment -->
                    <section class="co-section">
                        <h2><i class="bi bi-credit-card me-1"></i> Payment Method</h2>
                        @if (codEnabled)
                        {
                            <label class="co-pay active">
                                <input class="form-check-input mt-1" type="radio" name="paymentMethod" value="Cash on Delivery" checked />
                                <div>
                                    <b><i class="bi bi-cash-coin me-1"></i> Cash on Delivery</b>
                                    <span>Paisay delivery par dein – safe &amp; simple</span>
                                </div>
                            </label>
                            <label class="co-pay disabled">
                                <input class="form-check-input mt-1" type="radio" name="paymentMethod" value="Credit/Debit Card" disabled />
                                <div>
                                    <b><i class="bi bi-credit-card me-1"></i> Credit / Debit Card</b>
                                    <span>Coming soon</span>
                                </div>
                            </label>
                            <label class="co-pay disabled">
                                <input class="form-check-input mt-1" type="radio" name="paymentMethod" value="Bank Transfer" disabled />
                                <div>
                                    <b><i class="bi bi-phone me-1"></i> JazzCash / EasyPaisa</b>
                                    <span>Coming soon</span>
                                </div>
                            </label>
                        }
                        else
                        {
                            <div class="checkout-alert checkout-alert-error">Cash on Delivery is currently disabled. Please contact support to place an order.</div>
                            <input type="hidden" name="paymentMethod" value="Cash on Delivery" />
                        }
                    </section>

                    <button type="submit" class="btn btn-gold w-100 py-2 co-submit">
                        <i class="bi bi-bag-check me-1"></i> Place Order · @(codEnabled ? "COD" : "Confirm")
                    </button>
                    <p class="co-terms mt-2 mb-0">
                        By placing your order, you agree to our 7-day exchange policy. No login required, zero hidden fees.
                    </p>
                    <p class="co-terms mt-2 mb-0">
                        <a href="/Cart" class="co-back"><i class="bi bi-arrow-left me-1"></i> Return to cart</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Mobile sticky total bar -->
<div class="co-mobile-bar">
    <div>
        <span class="co-mb-label">Total</span>
        <span class="co-mb-price">PKR @grand.ToString("N0")</span>
    </div>
    <button class="btn btn-gold" type="button" onclick="document.getElementById('guestCheckoutForm').requestSubmit()">
        <i class="bi bi-bag-check me-1"></i> Place Order
    </button>
</div>
